{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": false
    },
    {
      "source": "/gizlilik",
      "destination": "https://app.wiserrise.com/gizlilik",
      "permanent": true
    },
    {
      "source": "/kullanim-kosullari",
      "destination": "https://app.wiserrise.com/kullanim-kosullari",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://app.wiserrise.com/gizlilik",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://app.wiserrise.com/kullanim-kosullari",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
