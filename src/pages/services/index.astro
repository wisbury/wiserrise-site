---
import ContentLayout from '../../layouts/ContentLayout.astro';
import HubCards from '../../components/v2/HubCards.astro';
import { routePath } from '../../i18n/routes';

const locale = 'en' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

// Main services. Sub-services (profile management, rank tracking, technical SEO, on-page SEO, content) are linked
// from their parent service page, not listed here. Services without a page yet open the analysis dialog.
const services = [
  {
    href: p('services/seo'),
    label: 'SEARCH',
    title: 'SEO',
    text: 'The search results below the map. With technical groundwork, page structure and content we fit your site to the questions your customers search for.',
    cta: 'View service',
  },
  {
    href: p('services/local-seo'),
    label: 'MAPS',
    title: 'Local SEO',
    text: 'Your profile and your site together. The work we do to get you into the first three businesses a nearby customer sees.',
    cta: 'View service',
  },
  {
    href: p('services/google-ads'),
    label: 'ADS',
    title: 'Google Ads',
    text: 'Search ads that spend your budget on people who are searching, asking and ready to buy.',
    cta: 'View service',
  },
  {
    href: p('services/geo'),
    label: 'AI',
    title: 'GEO',
    text: 'We measure which questions get you mentioned in ChatGPT, Gemini and Google’s AI answers, then work on the ones where you’re missing.',
    cta: 'View service',
  },
];

const faq = [
  {
    q: 'Can I buy the services one at a time?',
    a: 'You can, but for most businesses one service isn’t enough. If the problem sits in one place, say your site doesn’t show up on Google at all, we start with SEO alone. We tell you which one you need in the free analysis.',
  },
  {
    q: 'Do you work with businesses all over Turkey?',
    a: 'Yes. All the work runs remotely, so we don’t need to come to your city. We’re based in Antalya and work in Turkish, English and German.',
  },
  {
    q: 'Will you also work with my competitor in the same city?',
    a: 'No. In each city we work with one business per industry. Trying to push two competitors up the same map at the same time would be unfair to both.',
  },
  {
    q: 'How do you measure SEO results?',
    a: 'We read measurement across your area, profile interactions and Search Console data together. We don’t send a single ranking screenshot, because your place on the map changes with where the searcher is standing. You see the work we’ve done in the report every week.',
  },
];
---

<ContentLayout
  locale={locale}
  route="services"
  title="Digital Marketing Services | Wiserrise"
  description="SEO, local SEO, Google Ads and GEO. The free analysis shows which one you need."
  eyebrow="SERVICES"
  h1="Digital marketing services: which one do you need?"
  crumb="Services"
  lede="Your customers might find you on Google, on the map or in ChatGPT. Each channel is its own job, but you don’t need all of them at once. Below we explain which service works on which channel."
  serviceName="Digital Marketing Services"
  breadcrumb={[{ label: 'Home', href: '/' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Local SEO by industry', href: p('industries'), text: 'How the work changes for lawyers, dentists, clinics and vehicle inspection.' },
    { label: 'Guides', href: p('guides'), text: 'Steps you can apply yourself, from opening a profile to getting more reviews.' },
    { label: 'Free profile audit', href: p('tools/gbp-audit'), text: 'See in 10 questions where your Google profile is weak.' },
  ]}
  relatedHeading="Related pages"
  ctaLabel="Get a free analysis"
  ctaHref="/#contact"
>
  <h2 id="kanallar">Where do your customers find you?</h2>

  <p>
    Each of the four main services works on one channel.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Where?</th>
          <th>What do they see?</th>
          <th>Which service</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Google search</strong></td>
          <td>The results below the map</td>
          <td><a href={p('services/seo')}>SEO</a></td>
        </tr>
        <tr>
          <td><strong>Google Maps</strong></td>
          <td>The first three businesses on the map</td>
          <td><a href={p('services/local-seo')}>Local SEO</a></td>
        </tr>
        <tr>
          <td><strong>Google’s ad slots</strong></td>
          <td>The “Sponsored” lines above the results</td>
          <td><a href={p('services/google-ads')}>Google Ads</a></td>
        </tr>
        <tr>
          <td><strong>ChatGPT, Gemini</strong></td>
          <td>The businesses the assistant recommends</td>
          <td><a href={p('services/geo')}>GEO</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="reklam-seo">Ads or SEO?</h2>

  <p>
    Ads start right away and stop the day the budget runs out. SEO and local SEO start slower, but they don’t switch off
    the day you stop working on them.
  </p>

  <h2 id="baslangic">Where should you start?</h2>

  <p>
    If your customers come from nearby, start with the map, that is, with local SEO. If you sell to the whole city or the
    whole country, start with SEO. If you can’t wait, you start with ads and we build the lasting side behind them.
  </p>

  <p>
    Don’t start with a guess. The free analysis is a video we record for your business: where you stand today and what to start with first. We also don’t take on work where we can’t manage the whole site, because on a half-managed
    site SEO doesn’t hold and the visitors your ads bring are wasted.
  </p>

  <div class="callout">
    <p>
      <strong>You don’t have to work with us after the analysis.</strong>
    </p>
  </div>

  <Fragment slot="wide">
    <HubCards
      id="hizmet-listesi"
      eyebrow="SERVICES"
      heading="We work wherever your customers are looking."
      sub="SEO and local SEO work on your place in search and on the map. Google Ads makes you visible while the ads run. GEO carries the same foundation into AI answers."
      items={services}
      son={{
        label: 'NOT SURE?',
        title: 'Let’s work out together which one fits you.',
        text: 'The free analysis is a video we record for your business: where you stand today and what to start with first.',
        cta: 'Free analysis',
        alt: 'Get a free analysis →',
      }}
    />
  </Fragment>

  <Fragment slot="cta">
    <h2>Which one do you <span class="highlight">need</span> first?</h2>
    <p>
      The free analysis is a video we record for your business: where you stand today and what to start with first. It
      lands in your inbox within <span style="white-space: nowrap;">24 hours</span>.
    </p>
  </Fragment>
</ContentLayout>
