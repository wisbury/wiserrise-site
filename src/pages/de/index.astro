---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeSchema, type FaqEntry } from '../../lib/schema';

/**
 * Tek kaynak: hem görünen SSS bloğu hem `FAQPage` şeması buradan üretilir.
 * Google, FAQ işaretlemesinin sayfada GÖRÜNEN metinle birebir aynı olmasını
 * şart koşar; iki ayrı liste tutmak er geç kayar.
 */
const faq: FaqEntry[] = [
  {
    q: 'Wie lange dauert lokale SEO?',
    a: 'Die meisten Unternehmen sehen erste Bewegung in 4–8 Wochen, mit stärkeren Ergebnissen, die sich über 3–6 Monate aufbauen.',
  },
  {
    q: 'Arbeiten Sie nur mit einer Stadt?',
    a: 'Nein. Wir unterstützen lokale SEO-Kampagnen für einzelne Städte, mehrere Städte und mehrere Standorte – je nach Ihrem Wachstumsmodell.',
  },
  {
    q: 'Garantieren Sie Rankings?',
    a: 'Ja – Top 3 bei Google in 90 Tagen, garantiert.',
  },
  {
    q: 'Was bekomme ich bei der kostenlosen Analyse?',
    a: 'Sie erhalten eine klare Auswertung Ihres Google-Unternehmensprofils, lokaler Sichtbarkeitsprobleme, Wettbewerbslücken und der wirkungsvollsten nächsten Schritte.',
  },
  {
    q: 'Was ist das Local Pack?',
    a: 'Das Local Pack ist der Kartenblock mit drei Unternehmen, den Google bei einer lokalen Suche über den normalen Suchergebnissen zeigt. Diese drei Einträge bekommen die meisten Anrufe – genau dorthin zielt lokale SEO.',
  },
  {
    q: 'Was unterscheidet lokale SEO von klassischer SEO?',
    a: 'Klassische SEO bringt eine Webseite in den Suchergebnissen nach vorn. Lokale SEO bringt ein Unternehmen an einem Ort nach vorn: Die Suchmaschine bewertet neben Ihrer Website auch Ihr Google-Unternehmensprofil, Ihre Bewertungen und Ihre Entfernung zum Suchenden.',
  },
  {
    q: 'Brauche ich für lokale SEO eine Website?',
    a: 'Sie können auch ohne Website im Local Pack ranken, stoßen aber an eine Grenze. Die Website belegt, dass Sie für genau diese Leistungen und Stadtteile relevant sind – und dort wird lokale Suche zu einer Buchung oder einem Anruf.',
  },
  {
    q: 'Wie messen Sie den Fortschritt?',
    a: 'Wir messen Ihr Ranking über ein Raster von Punkten rund um Ihren Standort statt an einem einzelnen Mittelpunkt, denn ein lokales Suchergebnis ändert sich mit der Entfernung des Suchenden. Sie sehen die ganze Karte, dazu Anrufe, Routenanfragen und Profilaufrufe.',
  },
];

const locale = 'de' as const;
---

<BaseLayout
  locale={locale}
  route="home"
  title="Wiserrise | Lokale SEO & Google Maps Wachstum"
  description="Lokale SEO für das Google Maps Local Pack: Wiserrise bringt lokale Unternehmen in die Top 3, vor die Wettbewerber nebenan, und macht Sichtbarkeit zu echten Anfragen."
  ogImage="/images/og-image.png"
>
  <script
    slot="schema"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      homeSchema({
        locale,
        name: 'Wiserrise | Lokale SEO & Google Maps Wachstum',
        description:
          'Lokale SEO für das Google Maps Local Pack: Wiserrise bringt lokale Unternehmen in die Top 3, vor die Wettbewerber nebenan, und macht Sichtbarkeit zu echten Anfragen.',
        faq,
      }),
    )}
  />

   <section class="hero" id="contact">
