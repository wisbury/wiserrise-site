<script is:inline>
  // Spielt beim Erreichen des Abschnitts: Kopfblock, Karten, Schritte und FAQ erscheinen nacheinander.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var sections = document.querySelectorAll('#hizmetler, #surec, section[aria-label="Warum Wiserrise"], #sss, .v2-closing');
    sections.forEach(function (sec) {
      var items = [];
      Array.prototype.forEach.call(sec.children, function (child) {
        var grid = child.matches('ol, [style*="grid"]') ? child : null;
        if (grid) { Array.prototype.push.apply(items, grid.children); }
        else if (child.querySelector(':scope > details')) { items.push(child.firstElementChild); Array.prototype.push.apply(items, child.querySelectorAll(':scope > details')); }
        else items.push(child);
      });
      items.forEach(function (el, i) { el.classList.add('v2-rv'); el.style.setProperty('--i', Math.min(i, 8)); });
    });
    var io = new IntersectionObserver(function (entries) {
      // Auch Abschnitte oberhalb des Bildschirms öffnen sich: nach einem Neuladen mitten auf der Seite bleibt oben nichts versteckt
      entries.forEach(function (e) { if (e.isIntersecting || e.boundingClientRect.top < 0) {
          var sec = e.target;
          sec.classList.add('is-in');
          io.unobserve(sec);
          // Nach dem Einblenden die Klasse entfernen, damit die Karten ihre eigene Hover-Bewegung zurückbekommen
          sec.querySelectorAll('.v2-rv').forEach(function (el) {
            var i = parseInt(el.style.getPropertyValue('--i'), 10) || 0;
            setTimeout(function () { el.classList.remove('v2-rv'); }, i * 70 + 520);
          });
        } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    sections.forEach(function (sec) { io.observe(sec); });
  })();
</script>

