---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnalizDialog from '../../components/AnalizDialog.astro';
import Header from '../../components/v2/Header.astro';
import Footer from '../../components/v2/Footer.astro';
import { homeSchema, type FaqEntry } from '../../lib/schema';
import { CONTACT_EMAIL } from '../../i18n/ui';
import { routePath } from '../../i18n/routes';

/**
 * DE-Startseite: Übersetzung von src/pages/tr/index.astro (design="v2").
 * Markup, Klassen, Inline-Styles und Skripte sind mit TR identisch, nur der sichtbare Text ist deutsch.
 *
 * Eine Quelle für die FAQ: Der sichtbare Block und das `FAQPage`-Schema entstehen aus dieser Liste.
 */
const faq: FaqEntry[] = [
  {
    q: 'Mit welcher Leistung sollte ich anfangen?',
    a: 'Das hängt von Ihrer Lage ab. Ein Unternehmen mit Kunden aus der Umgebung startet bei Google Maps, ein Onlinehändler bei Suche und Anzeigen. In der kostenlosen Analyse sagen wir es Ihnen anhand Ihrer eigenen Daten.',
  },
  {
    q: 'Wann sieht man Ergebnisse?',
    a: 'Einen Zeitraum nennen wir nicht; er hängt vom Ausgangspunkt Ihres Unternehmens, vom Wettbewerb und vom Kanal ab. Sagen können wir die Reihenfolge der Arbeit: erst messen, dann die Grundprobleme beheben, dann Inhalte erstellen. Was wir getan haben und wie sich die Messung verändert hat, sehen Sie jede Woche im Bericht.',
  },
  {
    q: 'Garantieren Sie Rankings?',
    a: 'Rankings kann niemand garantieren, und Google sagt das selbst ganz offen. Zusagen können wir die Arbeit und die Messung: Jede Woche sehen Sie im Bericht, was wir getan haben und wie sich Ihr Ranking verändert hat.',
  },
  {
    q: 'Was ist KI-Sichtbarkeit?',
    a: 'Ihr Unternehmen wird genannt und empfohlen, wenn jemand Assistenten wie ChatGPT, Gemini oder Perplexity fragt oder Googles KI-Übersichten liest. Wir messen, bei welchen Fragen Sie genannt werden. Für die Fragen, bei denen Sie fehlen, stärken wir Ihre Website, Ihr Profil und die Quellen, die über Sie schreiben.',
  },
  {
    q: 'Was enthält die kostenlose Analyse?',
    a: 'Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie zuerst anfangen sollten.',
  },
  {
    q: 'Was ist das Local Pack?',
    a: 'Das Local Pack ist der Kartenblock mit drei Unternehmen, den Google über den normalen Suchergebnissen zeigt. Die meisten Suchenden landen bei einem dieser drei Einträge, und genau dorthin zu kommen ist das ganze Ziel lokaler SEO.',
  },
  {
    q: 'Wie messen Sie den Fortschritt?',
    a: 'Mit einer Messung in Ihrem Umkreis: Wir prüfen an verschiedenen Punkten rund um Ihren Standort, auf welchem Platz Sie stehen, denn die Reihenfolge auf der Karte hängt davon ab, wo der Suchende gerade ist. Dazu sehen Sie die Zahl der Anrufe, Routenanfragen und Profilaufrufe.',
  },
  {
    q: 'Arbeiten Sie auch mit Unternehmen außerhalb der Türkei?',
    a: 'Ja. Wir arbeiten auf Türkisch, Englisch und Deutsch, Messung und Berichte sind in jedem Land gleich.',
  },
];

import { existsSync } from 'node:fs';
import { join } from 'node:path';

/**
 * Logos der KI-Dienste. Liegen die offiziellen Logodateien unter diesen Namen in public/images/ai/
 * (chatgpt.svg, gemini.svg, perplexity.svg, google.svg), erscheinen sie automatisch im Panel;
 * fehlt eine Datei, steht dort das allgemeine Sternsymbol.
 */
const aiLogo = (id: string) =>
  existsSync(join(process.cwd(), 'public', 'images', 'ai', `${id}.svg`)) ? `/images/ai/${id}.svg` : null;
const ai = {
  chatgpt: aiLogo('chatgpt'),
  gemini: aiLogo('gemini'),
  perplexity: aiLogo('perplexity'),
  google: aiLogo('google'),
  claude: aiLogo('claude'),
};

// Film zur lokalen SEO: Startplätze der Beispielmessung, zeilenweise von links nach rechts (Farbbuchstabe + Platz)
const lmBas = 'a20 a19 a17 a14 a14 a16 g20+ a17 a16 a13 a14 a15 a14 a18 a15 a14 b10 b5 b10 a12 a17 a18 a11 b8 t3 b10 a11 a14 a14 a14 a11 b9 b10 a15 a17 a16 a16 a15 a11 a11 a14 a16 a19 a18 a15 a16 a18 a18 g20+'.split(' ');

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);
const email = CONTACT_EMAIL[locale];
const title = 'Online-Marketing-Agentur: lokale SEO, SEO, Google Ads, GEO | Wiserrise';
const description =
  'Google Maps, Suchergebnisse, Anzeigen und KI-Antworten. Wiserrise macht Ihr Unternehmen dort sichtbar, wo Kunden suchen. Kostenlose Analyse in 24 Stunden.';
---

<BaseLayout
  locale={locale}
  route="home"
  design="v2"
  title={title}
  description={description}
  ogImage="/images/og-image.png"
>
  <script
    slot="schema"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(homeSchema({ locale, name: title, description, faq }))}
  />

<Header locale={locale} route="home" />

<main id="main">
<div class="v2-top v2-top-renk">
<section id="analiz" style="max-width: 1100px; margin: 0 auto; padding: clamp(48px, 7vw, 88px) clamp(16px, 3vw, 32px) clamp(56px, 8vw, 104px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px;">
  <h1 style="margin: 0; font-family: 'Bricolage Grotesque', Geist, sans-serif; font-size: clamp(44px, 7.6vw, 92px); line-height: 1.0; font-weight: 600; letter-spacing: -0.045em; color: #1a1b19; max-width: 1000px;">Gefunden, wenn man sucht. Gewählt, wenn man Sie findet.</h1>
  <p style="margin: 0; font-size: 20px; line-height: 1.5; color: #1a1b19; max-width: 600px;">Google Maps, Suchergebnisse, Anzeigen und KI-Antworten. Seien Sie dort sichtbar, wo Ihre Kunden Sie suchen.</p>
  <form id="heroForm" action="#analiz-formu" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px; width: 100%; max-width: 680px; box-sizing: border-box; background: rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.95); border-radius: 32px; box-shadow: 0 24px 48px -30px rgba(22,36,77,0.45); margin-top: 12px;">
    <label for="heroSite" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0);">Ihre Website oder Ihr Google-Profil</label>
    <div class="v2-hero-field" style="flex: 1 1 280px; min-width: 0; display: flex; align-items: center; height: 60px; box-sizing: border-box; background: #ffffff; border-radius: 999px; overflow: hidden;">
      <input id="heroSite" name="site" type="text" autocomplete="url" placeholder="ihre-firma.de oder Google-Maps-Link" style="flex: 1; min-width: 0; height: 100%; padding: 0 20px 0 24px; box-sizing: border-box; border: 0; border-radius: inherit; background: transparent; color: #1a1b19; font: inherit; font-size: 16px;">
    </div>
    <button class="btn v2-hero-btn" type="submit" style="height: 60px; padding: 0 32px; border-radius: 999px; border: 0; background: #2bb3a6; color: #16244d; font: inherit; font-size: 16px; font-weight: 600; cursor: pointer; white-space: nowrap;">Analyse anfordern</button>
  </form>
  <span style="font-size: 14px; color: #5c5e59;">Kostenlos · In 24 Stunden in Ihrem Postfach · Unverbindlich</span>
</section>

<section class="v2-hl" aria-label="Schwerpunkte" style="max-width: 1376px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) clamp(64px, 8vw, 96px); display: flex; flex-wrap: wrap; gap: 16px; align-items: stretch;">
    <a class="semse" data-kavis="superzeka" href={p('services/geo')} style="flex: 999 1 760px; min-width: 0; border-radius: 24px; padding: clamp(28px, 4vw, 56px) clamp(20px, 4vw, 48px); display: flex; flex-wrap: wrap; gap: 40px; align-items: center; color: #ffffff; text-decoration: none; box-sizing: border-box;">
    <div style="flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 18px;">
      <span style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; color: #2bb3a6;">GEO · KI-SICHTBARKEIT</span>
      <h2 style="margin: 0; font-family: 'Bricolage Grotesque', Geist, sans-serif; font-size: clamp(30px, 4.2vw, 44px); line-height: 1.02; font-weight: 600; letter-spacing: -0.03em; color: #ffffff;">Lassen Sie sich von KI empfehlen.</h2>
      <p style="margin: 0; font-size: 17px; line-height: 1.55; color: #c3cbe0; max-width: 400px;">ChatGPT, Gemini, Perplexity und Googles KI-Übersichten sollen Sie empfehlen. Wir messen, bei welchen Fragen Sie genannt werden, und schließen die Lücken dort, wo Sie fehlen.</p>
      <ul style="margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: #ffffff;">
        <li style="display: flex; gap: 10px; align-items: center;"><span aria-hidden="true" style="width: 20px; height: 20px; border-radius: 999px; background: #2bb3a6; color: #16244d; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">✓</span>KI-Sichtbarkeitswert</li>
        <li style="display: flex; gap: 10px; align-items: center;"><span aria-hidden="true" style="width: 20px; height: 20px; border-radius: 999px; background: #2bb3a6; color: #16244d; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">✓</span>Ihr Anteil an Nennungen gegenüber der Konkurrenz</li>
        <li style="display: flex; gap: 10px; align-items: center;"><span aria-hidden="true" style="width: 20px; height: 20px; border-radius: 999px; background: #2bb3a6; color: #16244d; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">✓</span>Seiten, die Sie als Quelle nennen</li>
      </ul>
      <span class="btn" style="align-self: flex-start; margin-top: 4px; display: inline-flex; align-items: center; height: 48px; padding: 0 24px; border-radius: 999px; border: 1.5px solid #ffffff; color: #ffffff; font-size: 15px; font-weight: 600; box-sizing: border-box;">GEO-Leistung ansehen →</span>
    </div>
    <div class="wz-frame" aria-hidden="true" style="flex: 999 1 440px; min-width: 0;">
      <div class="wz-stage">

        <div class="wz-scene" style="--d: 0s;">
          <div style="position: relative; width: 100%; max-width: 470px; display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center;">
            <div class="wz-slate" aria-hidden="true">
              <svg class="wz-slate-mark" viewBox="0 0 110.25 80" width="77" height="56"><polygon class="wz-peak wz-peak1" points="0,80 49,0 67.5,30.2 37,80" fill="#16244d"></polygon><polygon class="wz-peak wz-peak2" points="57.25,60 83.75,16.7 110.25,60" fill="#2bb3a6"></polygon></svg>
              <span class="wz-slate-word">Wiserrise</span>
              <span class="wz-slate-tag">ONLINE-MARKETING-AGENTUR</span>
            </div>
            <span class="wz-in" style="--t: 1.75s; font-family: 'Bricolage Grotesque', Geist, sans-serif; font-size: 36px; line-height: 1.02; font-weight: 600; letter-spacing: -0.035em; color: #16244d;">Bei jeder Suche<br>gewählt werden.</span>
            <div class="wz-in" style="--t: 1.9s; position: relative; width: 100%; display: flex; align-items: center; gap: 8px; height: 60px; padding: 0 8px 0 22px; box-sizing: border-box; border-radius: 999px; background: #ffffff; box-shadow: 0 14px 30px rgba(22,36,77,.12);">
              <span style="flex: 1; text-align: left; font-size: 16px; color: #1a1b19;"><span class="wz-type" style="--t: 2.2s;">ihre-firma.de</span></span>
              <span class="wz-press" style="--t: 3.9s; display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 999px; background: #2bb3a6; color: #16244d; font-size: 15px; font-weight: 600;">Analysieren</span>
              <span class="wz-cursor" style="--t: 2.7s; right: 26px; bottom: -4px;"><svg viewBox="0 0 22 22" width="22" height="22" aria-hidden="true"><path d="M4 2 L4 18 L8.5 13.8 L11.6 20 L14.2 18.8 L11.2 12.6 L17 12.4 Z" fill="#16244d" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"></path></svg></span>
            </div>
          </div>
        </div>

        <div class="wz-scene wz-scene--still" style="--d: 4.8s;">
          <div class="wz-card wz-in" style="--t: 0s;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
              <span class="wz-h">KI-Sichtbarkeit</span>
              <span style="display: flex; gap: 2px; padding: 3px; border-radius: 10px; background: #ecece7; font-size: 12px; font-weight: 600;"><span style="padding: 4px 10px; border-radius: 8px; background: #ffffff; color: #16244d; box-shadow: inset 0 0 0 1px #9fb3e8;">KI-Suche</span><span style="padding: 4px 10px; color: #5c5e59;">SEO</span></span>
            </div>
            <div style="display: flex; align-items: center; gap: 22px; margin: 18px 0 16px;">
              <div style="position: relative; width: 84px; height: 84px; flex: 0 0 84px;">
                <svg viewBox="0 0 84 84" width="84" height="84" aria-hidden="true" style="display: block; transform: rotate(-90deg);"><circle cx="42" cy="42" r="34" fill="none" stroke="#ecece7" stroke-width="9"></circle><circle class="wz-ring" cx="42" cy="42" r="34" fill="none" stroke="#2bb3a6" stroke-width="9" stroke-linecap="round" style="--len: 213.6; --off: 70.5; --t: 0.3s;"></circle></svg>
                <span class="wz-mono wz-count" style="--to: 67; --t: 0.3s; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 600; color: #16244d;"></span>
              </div>
              <div class="wz-in" style="--t: 0.5s; display: flex; flex-direction: column; gap: 2px;"><span style="font-size: 12px; color: #5c5e59;">Nennungen</span><span class="wz-mono" style="font-size: 26px; font-weight: 500; letter-spacing: -0.03em;">1.240</span></div>
              <div class="wz-in" style="--t: 0.7s; display: flex; flex-direction: column; gap: 2px;"><span style="font-size: 12px; color: #5c5e59;">Quellen</span><span class="wz-mono" style="font-size: 26px; font-weight: 500; letter-spacing: -0.03em;">86</span></div>
            </div>
            <div style="display: flex; flex-direction: column; border-top: 1px solid #ecece7;">
              <div class="wz-slide" style="--t: 1.1s; display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #f1f2ee; font-size: 14px;">{ai.chatgpt ? <img class="wz-ailogo" src={ai.chatgpt} alt="" width="22" height="22" /> : <span class="wz-logo"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5C8.6 5.6 10.4 7.4 14.5 8 10.4 8.6 8.6 10.4 8 14.5 7.4 10.4 5.6 8.6 1.5 8 5.6 7.4 7.4 5.6 8 1.5Z" fill="#2bb3a6"></path></svg></span>}<span style="flex: 1;">ChatGPT</span><span class="wz-mono" style="width: 56px; text-align: right;">412</span><span class="wz-mono" style="width: 40px; text-align: right; color: #5c5e59;">38</span></div>
              <div class="wz-slide" style="--t: 1.3s; display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #f1f2ee; font-size: 14px;">{ai.gemini ? <img class="wz-ailogo" src={ai.gemini} alt="" width="22" height="22" /> : <span class="wz-logo"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5C8.6 5.6 10.4 7.4 14.5 8 10.4 8.6 8.6 10.4 8 14.5 7.4 10.4 5.6 8.6 1.5 8 5.6 7.4 7.4 5.6 8 1.5Z" fill="#2bb3a6"></path></svg></span>}<span style="flex: 1;">Gemini</span><span class="wz-mono" style="width: 56px; text-align: right;">356</span><span class="wz-mono" style="width: 40px; text-align: right; color: #5c5e59;">27</span></div>
              <div class="wz-slide" style="--t: 1.5s; display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #f1f2ee; font-size: 14px;">{ai.perplexity ? <img class="wz-ailogo" src={ai.perplexity} alt="" width="22" height="22" /> : <span class="wz-logo"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5C8.6 5.6 10.4 7.4 14.5 8 10.4 8.6 8.6 10.4 8 14.5 7.4 10.4 5.6 8.6 1.5 8 5.6 7.4 7.4 5.6 8 1.5Z" fill="#2bb3a6"></path></svg></span>}<span style="flex: 1;">Perplexity</span><span class="wz-mono" style="width: 56px; text-align: right;">248</span><span class="wz-mono" style="width: 40px; text-align: right; color: #5c5e59;">12</span></div>
              <div class="wz-slide" style="--t: 1.7s; display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #f1f2ee; font-size: 14px;">{ai.google ? <img class="wz-ailogo" src={ai.google} alt="" width="22" height="22" /> : <span class="wz-logo"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5C8.6 5.6 10.4 7.4 14.5 8 10.4 8.6 8.6 10.4 8 14.5 7.4 10.4 5.6 8.6 1.5 8 5.6 7.4 7.4 5.6 8 1.5Z" fill="#2bb3a6"></path></svg></span>}<span style="flex: 1;">Google KI-Übersicht</span><span class="wz-mono" style="width: 56px; text-align: right;">128</span><span class="wz-mono" style="width: 40px; text-align: right; color: #5c5e59;">5</span></div>
              <div class="wz-slide" style="--t: 1.9s; display: flex; align-items: center; gap: 10px; padding: 9px 0; font-size: 14px;">{ai.claude ? <img class="wz-ailogo" src={ai.claude} alt="" width="22" height="22" /> : <span class="wz-logo"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 1.5C8.6 5.6 10.4 7.4 14.5 8 10.4 8.6 8.6 10.4 8 14.5 7.4 10.4 5.6 8.6 1.5 8 5.6 7.4 7.4 5.6 8 1.5Z" fill="#2bb3a6"></path></svg></span>}<span style="flex: 1;">Claude</span><span class="wz-mono" style="width: 56px; text-align: right;">96</span><span class="wz-mono" style="width: 40px; text-align: right; color: #5c5e59;">4</span></div>
            </div>
          </div>
        </div>

        <div class="wz-scene" style="--d: 9.6s;">
          <div class="wz-card wz-in" style="--t: 0s;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span class="wz-h">Sichtbarkeitstrend</span>
              <span style="display: flex; gap: 12px; font-size: 12px; color: #5c5e59;"><span style="display: inline-flex; align-items: center; gap: 5px;"><i style="width: 8px; height: 8px; border-radius: 2px; background: #2bb3a6; display: inline-block;"></i>Sie</span><span style="display: inline-flex; align-items: center; gap: 5px;"><i style="width: 8px; height: 8px; border-radius: 2px; background: #16244d; display: inline-block;"></i>Wettbewerber 1</span><span style="display: inline-flex; align-items: center; gap: 5px;"><i style="width: 8px; height: 8px; border-radius: 2px; background: #9fb3e8; display: inline-block;"></i>Wettbewerber 2</span></span>
            </div>
            <div style="position: relative; margin-top: 16px;">
              <svg viewBox="0 0 420 190" width="100%" height="190" aria-hidden="true" style="display: block; overflow: visible;">
                <g stroke="#ecece7" stroke-width="1"><path d="M28 20H420M28 65H420M28 110H420M28 155H420"></path></g>
                <g class="wz-mono" font-size="10" fill="#868982"><text x="0" y="24">100</text><text x="6" y="69">75</text><text x="6" y="114">50</text><text x="6" y="159">25</text><text x="40" y="182">Jun</text><text x="130" y="182">Jul</text><text x="220" y="182">Aug</text><text x="310" y="182">Sep</text><text x="392" y="182">Okt</text></g>
                <polyline class="wz-draw" style="--t: 0.5s;" points="40,104 85,100 130,96 175,99 220,92 265,90 310,88 355,90 400,87" fill="none" stroke="#9fb3e8" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
                <polyline class="wz-draw" style="--t: 0.35s;" points="40,70 85,72 130,74 175,73 220,77 265,80 310,79 355,83 400,85" fill="none" stroke="#16244d" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
                <polyline class="wz-draw" style="--t: 0.2s;" points="40,140 85,134 130,124 175,116 220,100 265,86 310,72 355,58 400,45" fill="none" stroke="#2bb3a6" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"></polyline>
                <circle class="wz-in" style="--t: 2.1s;" cx="400" cy="45" r="6" fill="#2bb3a6" stroke="#ffffff" stroke-width="2.5"></circle>
              </svg>
            </div>
          </div>
        </div>

        <div class="wz-scene" style="--d: 14.4s;">
          <div class="wz-card wz-in" style="--t: 0s;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
              <span class="wz-h">Chancen</span>
              <span style="position: relative; display: flex; padding: 3px; border-radius: 10px; background: #ecece7; font-size: 12px; font-weight: 600;"><span class="wz-tabpill" style="--t: 2.1s; position: absolute; left: 3px; top: 3px; bottom: 3px; width: 64px; border-radius: 8px; background: #ffffff; box-shadow: inset 0 0 0 1px #9fb3e8;"></span><span style="position: relative; width: 64px; text-align: center; padding: 4px 0; color: #16244d;">Fehlt</span><span style="position: relative; width: 64px; text-align: center; padding: 4px 0; color: #16244d;">Schwach</span></span>
            </div>
            <div style="display: flex; gap: 10px; margin: 16px 0 6px; font-size: 11px; font-weight: 600; color: #868982; text-transform: uppercase; letter-spacing: .06em;"><span style="flex: 1;">Gestellte Frage</span><span style="width: 64px; text-align: right;">Monat</span><span style="width: 86px; text-align: right;">Status</span></div>
