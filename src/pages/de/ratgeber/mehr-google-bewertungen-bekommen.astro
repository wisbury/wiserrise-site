---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'ZIEL', title: 'Die Zahl hängt vom Wettbewerb ab', text: 'Eine Bewertungszahl, die für alle gilt, gibt es nicht. Ihr Maßstab ist die Menge bei den Unternehmen, die bei Ihrem Zielbegriff auf der Karte unter den ersten drei stehen.' },
  { label: 'MOMENT', title: 'Wenn die Arbeit fertig ist', text: 'Bitten Sie im Moment der Übergabe, solange die Erfahrung frisch ist, und zwar jeden Kunden, nicht nur die, die Sie für zufrieden halten. Auf eine Bitte Tage später reagieren nur wenige.' },
  { label: 'LINK', title: 'Kurzer Bewertungslink', text: 'Der Link aus der Verwaltung Ihres Profils führt Kunden direkt zum Bewertungsfenster. Niemand muss Sie erst auf der Karte suchen.' },
  { label: 'REGEL', title: 'Keine Anreize', text: 'Bewertungen gegen Rabatt, Geschenk oder Gewinnspiel zu erbitten, verstößt gegen die Richtlinien von Google. Erkannte Bewertungen werden gelöscht.' },
];

const toc = [
  { id: 'hedef', label: 'Wie viele reichen?' },
  { id: 'an', label: 'Wann bitten?' },
  { id: 'nasil', label: 'Wie bitten?' },
  { id: 'kurallar', label: 'Was Google verbietet' },
  { id: 'filtre', label: 'Warum Bewertungen verschwinden' },
  { id: 'yanit', label: 'Wie antworten?' },
  { id: 'olumsuz', label: 'Bei negativen Bewertungen' },
];

const faq = [
  {
    q: 'Darf ich für eine Bewertung einen Rabatt geben?',
    a: 'Nein. Rabatt, Geschenk oder Gewinnspiel als Gegenleistung für eine Bewertung verstoßen gegen die Richtlinien von Google. Erkannte Bewertungen werden gelöscht, im Wiederholungsfall kann das Profil gesperrt werden. Auch wettbewerbsrechtlich gelten gekaufte oder belohnte Bewertungen in Deutschland in der Regel als problematisch.',
  },
  {
    q: 'Lohnt es sich, Bewertungen zu kaufen?',
    a: 'Nein, Sie setzen damit Ihr Profil aufs Spiel. Eine gekaufte Bewertung ist für Google eine gefälschte Bewertung und wird gelöscht, sobald der Filter sie erkennt. Stecken Sie dasselbe Geld und dieselbe Mühe in eine Routine, mit der Sie Ihre eigenen Kunden um Bewertungen bitten.',
  },
  {
    q: 'Darf ich Kunden sagen, was sie schreiben sollen?',
    a: 'Geben Sie keinen fertigen Text vor. Ähnliche Bewertungen bleiben im Filter hängen, und wer sie liest, merkt, dass sie gefälscht sind. Es genügt zu sagen: „Wir würden uns freuen, wenn Sie schreiben, welche Leistung Sie in Anspruch genommen haben.“',
  },
  {
    q: 'Darf ich frühere Kunden gesammelt um Bewertungen bitten?',
    a: 'Eine Rundmail oder Rundnachricht an die alte Kundenliste empfehlen wir nicht. Eine Bewertungsanfrage per E-Mail, SMS oder WhatsApp gilt in Deutschland als Werbung und braucht in der Regel die vorherige Einwilligung (§ 7 UWG). Außerdem ist ein Stapel Bewertungen innerhalb weniger Tage genau das Muster, auf das der Filter achtet. Fragen Sie frühere Kunden lieber persönlich beim nächsten Kontakt.',
  },
  {
    q: 'Kann ich eine gefälschte negative Bewertung löschen lassen?',
    a: 'Bei einem Regelverstoß können Sie die Bewertung an Google melden. Beleidigungen, Inhalte ohne Bezug oder erkennbar von einem Wettbewerber stammende Bewertungen können entfernt werden, aber das Verfahren führt nicht sicher zum Erfolg und kann Wochen dauern. Ihre eigentliche Verteidigung ist die Zahl Ihrer echten Bewertungen.',
  },
];
---

<ContentLayout
  locale={locale}
  route="guides/more-reviews"
  title="Mehr Google-Bewertungen bekommen: So geht es | Wiserrise"
  description="Mehr Google-Bewertungen ohne Regelverstoß: der richtige Moment, Karte oder QR-Code, die passende Antwort. Und was in Deutschland zu beachten ist."
  eyebrow="RATGEBER · BEWERTUNGEN"
  h1="Wie bekommt man mehr Google-Bewertungen?"
  crumb="Mehr Bewertungen"
  lede="Mehr Google-Bewertungen bekommen Sie, wenn Sie jeden Kunden in dem Moment, in dem die Arbeit fertig ist, persönlich um eine Bewertung bitten und ihm eine Karte oder einen QR-Code mitgeben, der direkt zum Bewertungsfenster führt. Bewertungen kaufen, Bewertungen gegen Rabatt sammeln und nur zufriedene Kunden zu Google schicken verstößt gegen die Richtlinien von Google. Setzen Sie Ihr Ziel anhand Ihrer Wettbewerber und bitten Sie laufend statt auf einmal."
  schemaType="article"
  datePublished="2026-08-01"
  dateModified="2026-11-06"
  breadcrumb={[
    { label: 'Startseite', href: '/de' },
    { label: 'Ratgeber', href: p('guides') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'Bei Google Maps höher ranken', href: p('guides/rank-higher'), text: 'Welche Rolle Bewertungen im Ranking spielen und in welcher Reihenfolge Sie arbeiten sollten.' },
    { label: 'Unternehmen nicht bei Google sichtbar', href: p('guides/not-showing'), text: 'Genug Bewertungen, aber nicht auf der Karte? Schließen Sie die Ursachen nacheinander aus.' },
    { label: 'Google-Unternehmensprofil-Betreuung', href: p('services/gbp'), text: 'Kategorie, Leistungsstruktur, Bewertungen und Beiträge betreuen wir als Ganzes.' },
    { label: 'SEO für Anwälte', href: p('industries/law'), text: 'Wie wir Profil und Bewertungen bei Kanzleien sachlich und im Rahmen von BRAO und BORA angehen.' },
  ]}
  relatedHeading="Verwandte Seiten"
  ctaLabel="Profil kostenlos prüfen"
  ctaHref={p('tools/gbp-audit')}
>
  <h2 id="hedef">Wie viele Bewertungen reichen?</h2>

  <p>
    Eine Zahl, die für alle gilt, gibt es nicht. Ihr Maßstab ist die Bewertungsmenge der Unternehmen, die bei Ihrem
    Zielbegriff auf der Karte unter den ersten drei stehen. In manchen Branchen heißt das 20 Bewertungen, in anderen 200.
  </p>

  <p>
    Das lässt sich leicht prüfen. Geben Sie Ihren Suchbegriff in Google Maps ein und notieren Sie Bewertungszahl und
    Durchschnitt der ersten drei. Liegen Sie deutlich darunter, haben Bewertungen Vorrang.
  </p>

  <p>
    Sind Sie auf dem Niveau Ihrer Wettbewerber und trotzdem nicht sichtbar, liegt das Problem woanders, sehr
    wahrscheinlich bei der Kategorie. Beginnen Sie dann mit den Prüfungen im Ratgeber
    <a href={p('guides/not-showing')}>Unternehmen nicht bei Google sichtbar</a>.
  </p>

  <div class="callout">
    <p>
      <strong>Die Menge kommt vor dem Durchschnitt.</strong> 80 Bewertungen mit 4,7 Sternen sind ein stärkeres Profil als
      6 Bewertungen mit 5,0. Jagen Sie keinem perfekten Schnitt hinterher, ein paar Bewertungen mit 4 Sternen machen Ihr
      Profil glaubwürdiger.
    </p>
  </div>

  <h2 id="an">Wann sollten Sie um eine Bewertung bitten?</h2>

  <p>
    Solange die Erfahrung noch frisch ist. Wie viele Kunden eine Bewertung schreiben, hängt stärker vom Zeitpunkt
    ab als vom Text.
  </p>

  <p>
    Angenommen, Sie betreiben das Gutachterbüro Elstermühle in Leipzig-Plagwitz. Nach einem Unfall hat Ihre Kundin das
    Gutachten für die Versicherung in der Hand, und der Termin ist erledigt. Genau jetzt bitten Sie um die Bewertung,
    bevor sie Ihr Büro verlässt.
  </p>

  <p>Der richtige Moment hängt von der Branche ab:</p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Branche</th>
          <th>Der richtige Moment</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Kfz-Gutachter</td>
          <td>Bei der Übergabe des Gutachtens, solange der Kunde noch vor Ort ist</td>
        </tr>
        <tr>
          <td>Zahnarztpraxis</td>
          <td>Wenn die Behandlung abgeschlossen und auch der Kontrolltermin vorbei ist</td>
        </tr>
        <tr>
          <td>Physiotherapie</td>
          <td>Wenn die Behandlungsserie abgeschlossen ist</td>
        </tr>
        <tr>
          <td>Anwaltskanzlei</td>
          <td>Nach Abschluss des Mandats, jeden Mandanten einzeln; lesen Sie dazu den Hinweis weiter unten</td>
        </tr>
        <tr>
          <td>Friseur, Service, Einzelhandel</td>
          <td>Direkt nach der Leistung, solange der Kunde noch da ist</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Auf Erinnerungen, die Tage später kommen, reagieren nur wenige Kunden. Sie erinnern sich an die Leistung, aber
    der Moment ist vorbei, also werden sie nicht aktiv.
  </p>

  <h2 id="nasil">Wie bitten Sie um eine Bewertung?</h2>

  <p>
    Machen Sie es Kunden so leicht wie möglich, eine Bewertung zu schreiben. Wir richten dafür eine Routine für
    Bewertungsanfragen ein: regelmäßig, einzeln statt per Massenversand, ohne Gutschein oder Rabatt und ohne nur
    zufriedene Kunden auszuwählen. Die Reihenfolge:
  </p>

  <ol>
    <li>
      <strong>Holen Sie sich den kurzen Bewertungslink.</strong> In der Verwaltung Ihres Unternehmensprofils gibt es einen
      Link zum Bewerten. Er führt Kunden direkt zum Bewertungsfenster, sie müssen Sie nicht erst auf der Karte suchen.
    </li>
    <li>
      <strong>Bitten Sie persönlich.</strong> Sagen Sie es am Ende des Termins oder bei der Übergabe in einem Satz und
      geben Sie eine kleine Karte mit dem Link oder QR-Code mit. Eine Bewertungsanfrage per E-Mail, SMS oder WhatsApp
      gilt in Deutschland als Werbung und braucht in der Regel die vorherige Einwilligung des Kunden (§ 7 UWG). Ohne
      diese Einwilligung bleiben Sie beim persönlichen Gespräch, bei Karte und QR-Code. Allgemeine Information, keine
      Rechtsberatung.
    </li>
    <li>
      <strong>Halten Sie vor Ort einen QR-Code bereit.</strong> An der Kasse, am Empfang oder im Wartezimmer sollte der
      QR-Code des Links gut sichtbar sein.
    </li>
    <li>
      <strong>Bitten Sie einmal.</strong> Hartnäckige Erinnerungen verderben Kunden die Laune.
    </li>
  </ol>

  <p>
    Zwischen einer Anregung und einem vorgegebenen Text verläuft eine klare Grenze. „Wir würden uns freuen, wenn Sie
    schreiben, welche Leistung Sie bekommen haben und aus welchem Stadtteil Sie kommen“ ist unproblematisch, die Sätze
    formuliert der Kunde selbst. Sobald Sie einen fertigen Text vorgeben, ähneln sich die Bewertungen und bleiben im
    Filter hängen.
  </p>

  <h2 id="kurallar">Welche Bewertungstaktiken verbietet Google?</h2>

  <p>
    Hier sind wir deutlich: Machen Sie nichts von dem Folgenden, auch wenn Ihr Wettbewerber es tut. Kurzfristig steigt
    die Zahl, danach gefährden Sie Ihr Profil.
  </p>

  <ul>
    <li>
      <strong>Bewertungen kaufen.</strong> Eine bezahlte Bewertung ist eine gefälschte Bewertung und verstößt gegen die
      Richtlinien von Google. Erkennt der Filter sie, werden die Bewertungen gelöscht, und das Profil riskiert eine Sperrung.
    </li>
    <li>
      <strong>Bewertungen mit Anreizen sammeln.</strong> Rabatt, Geschenk, Gewinnspiel oder „Kaffee aufs Haus für jede
      Bewertung“ laufen alle auf dasselbe hinaus. Erkannte Bewertungen werden gelöscht, im Wiederholungsfall kann das
      Profil gesperrt werden.
    </li>
    <li>
      <strong>Den Link nur an zufriedene Kunden schicken.</strong> Erst „Sind Sie zufrieden?“ zu fragen und nur die, die
      Ja sagen, zu Google zu schicken, schließen die Richtlinien von Google ausdrücklich aus. Auf Englisch heißt das
      review gating.
    </li>
  </ul>

  <p>
    Liegt Ihr Wettbewerber mit gekauften Bewertungen vorn, melden Sie den Regelverstoß an Google und bitten Sie selbst
    weiter regelmäßig um echte Bewertungen. Seine Bewertungen können jederzeit gelöscht werden, Ihre echten bleiben.
  </p>

  <div class="callout">
    <p>
      <strong>Hinweis für Kanzleien und Praxen:</strong> Für Anwälte gelten § 43b BRAO und die Berufsordnung (BORA), für
      Heilberufe das Heilmittelwerbegesetz (HWG) und das Berufsrecht Ihrer Kammer. Bei Kanzleien bitten wir Mandanten
      nach Abschluss jedes Mandats um eine Bewertung, einzeln; keine Sammelanfragen, keine Anreize wie Geschenke oder
      Rabatte, keine vorformulierten Bewertungstexte. In Praxen gilt dieselbe Regel: regelmäßig, einzeln, ohne Anreiz,
      ohne Auswahl. Bewertungen als Werbezitat auf Ihrer Website empfehlen wir in diesen Bereichen nicht, und ein
      Sterne-Markup verwenden wir dort nicht.
      Im Einzelfall entscheiden Ihre Kammer oder Ihre Rechtsberatung.
      Details stehen auf unseren Seiten für <a href={p('industries/law')}>Anwälte</a> und
      <a href={p('industries/dental')}>Zahnärzte</a>.
    </p>
  </div>

  <h2 id="filtre">Warum verschwinden Ihre Bewertungen?</h2>

  <p>
    Der Filter von Google entfernt Bewertungen, die er für verdächtig hält, ohne Ankündigung. Es kommt keine
    Benachrichtigung, nur die Zahl sinkt. Typische Muster, die im Filter hängen bleiben:
  </p>

  <ul>
    <li><strong>Plötzlicher Stapel.</strong> Viele Bewertungen innerhalb weniger Tage bei einem neuen Profil.</li>
    <li><strong>Bewertungen aus demselben Netz.</strong> Kunden alle auf einmal Bewertungen schreiben lassen, während sie im WLAN des Unternehmens sind.</li>
    <li><strong>Konten ohne Vorgeschichte.</strong> Konten, die noch nie eine Bewertung geschrieben haben und nur diese eine enthalten.</li>
    <li><strong>Ähnliche Texte.</strong> Dieselbe Vorlage, mit kleinen Änderungen wiederholt.</li>
  </ul>

  <p>
    Die bekannteste Falle ist die Sammelanfrage. Eine Nachricht an die ganze alte Kundenliste braucht in Deutschland in
    der Regel die vorherige Einwilligung der Empfänger (§ 7 UWG), und auch mit Einwilligung ist ein Stapel Bewertungen
    innerhalb weniger Tage genau das Muster, nach dem der Filter sucht.
  </p>

  <p>
    Bitten Sie deshalb laufend statt auf einmal. Ein paar echte Bewertungen jede Woche sind sicherer als zwanzig
    Bewertungen in einer einzigen Woche.
  </p>

  <h2 id="yanit">Wie sollten Sie auf Bewertungen antworten?</h2>

  <p>
    Kurz und menschlich, bei guten wie bei schlechten. Auch in den Empfehlungen von Google zum lokalen Ranking steht,
    dass Sie auf Bewertungen antworten sollen. Die Antwort zeigt dem nächsten Kunden, der sich über Sie informiert, dass
    das Unternehmen lebt.
  </p>

  <p>
    Vorlagenantworten wie „Ihre wunderbare Bewertung hat unseren Tag erhellt, unsere Marke auf der digitalen Bühne
    glänzen zu sehen, ist ein unbeschreibliches Glück“ erkennt man im ersten Satz. Wer das liest, merkt, dass Sie sich die
    Bewertungen nicht wirklich ansehen.
  </p>

  <p>
    Nennen Sie schlicht die Leistung, die der Kunde bekommen hat, und bedanken Sie sich, mehr braucht es nicht. Zwei
    Zeilen wie „Danke, Frau Becker, schön, dass mit dem Gutachten alles geklappt hat. Gute Fahrt!“ genügen.
  </p>

  <p>
    Bei Praxen und Kanzleien gibt es eine Ausnahme: Nennen Sie in der Antwort nicht die Leistung. Die Antwort „Schön,
    dass Sie mit Ihrer Implantatbehandlung zufrieden sind“ bestätigt öffentlich, dass diese Person bei Ihnen in
    Behandlung war und welche Behandlung sie bekommen hat. Das berührt Ihre Schweigepflicht.
  </p>

  <h2 id="olumsuz">Was tun Sie bei einer negativen Bewertung?</h2>

  <p>Gehen Sie der Reihe nach vor:</p>

  <ol>
    <li>
      <strong>Nehmen Sie zuerst privat Kontakt auf.</strong> Lösen Sie das Problem im Gespräch. Ist es gelöst, kann der
      Kunde seine Bewertung selbst aktualisieren.
    </li>
    <li>
      <strong>Schreiben Sie dann eine kurze Antwort, ohne sich zu verteidigen.</strong> Lesen wird diese Antwort vor
      allem der nächste Kunde, der sich über Sie informiert. Widersprechen Sie dem Kunden nicht und gehen Sie nicht ins
      Detail.
    </li>
    <li>
      <strong>Melden Sie Regelverstöße.</strong> Beleidigungen, Inhalte ohne Bezug oder erkennbar von einem Wettbewerber
      stammende Bewertungen können entfernt werden. Das Verfahren führt nicht sicher zum Erfolg und kann Wochen dauern.
    </li>
  </ol>

  <p>
    Die stärkste Verteidigung gegen eine einzelne negative Bewertung ist die Zahl Ihrer echten Bewertungen. In einem
    Profil mit 120 Bewertungen geht eine schlechte unter, in einem Profil mit 8 Bewertungen fällt sie als Erstes auf.
  </p>

  <Fragment slot="cta">
    <h2>Liegen Ihre Bewertungen <span class="highlight">hinter</span> denen Ihrer Wettbewerber?</h2>
    <p>
      Unser kostenloser Profil-Check bewertet Ihr Profil in 10 Fragen und lässt Sie Ihre Bewertungszahl mit den
      Wettbewerbern unter den ersten drei vergleichen. Für jeden schwachen Punkt sehen Sie sofort, was zu tun ist, ohne
      Registrierung oder <span style="white-space: nowrap;">E-Mail</span>.
    </p>
  </Fragment>
</ContentLayout>
