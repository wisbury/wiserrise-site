---
/**
 * Analiz formundan sonra gelinen teşekkür sayfası. Form gönderilince /js/script.js dönüşüm olayını
 * tetikleyip buraya yönlendirir. Arama motorlarına kapalı (noindex, robots.txt ve site haritası dışında).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnalizDialog from '../../components/AnalizDialog.astro';
import Header from '../../components/v2/Header.astro';
import Footer from '../../components/v2/Footer.astro';
import { CONTACT_EMAIL } from '../../i18n/ui';
import { routePath } from '../../i18n/routes';

const email = CONTACT_EMAIL.de;
---

<BaseLayout
  locale="de"
  route="thanks"
  title="Anfrage erhalten | Wiserrise"
  description="Ihre Anfrage für die kostenlose Analyse ist bei uns eingegangen. Die Analyse ist innerhalb von 24 Stunden in Ihrem Postfach."
  design="v2"
  noindex
>

<Header locale="de" route="thanks" />

<main id="main" class="v2-page">
  <div class="v2-top v2-top-renk">
    <section class="v2-page-hero v2-tesekkur">
      <span class="v2-tesekkur-ok" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 12.5 10 17.5 19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <span class="v2-eyebrow">ANFRAGE ERHALTEN</span>
      <h1>Danke, wir sehen uns Ihr Unternehmen jetzt an.</h1>
      <p class="v2-page-lede">
        Wir prüfen Ihr Profil, Ihre Website und Ihre Wettbewerber und schreiben auf, wo Sie anfangen sollten. Die Analyse ist innerhalb von
        <span style="white-space: nowrap;">24 Stunden in Ihrem Postfach</span>.
      </p>
      <div class="v2-page-actions">
        <a class="btn v2-btn-firuze" href="/de">Zur Startseite</a>
      </div>
      <p class="v2-tesekkur-not">
        Während Sie warten, können Sie <a href={routePath('de', 'tools/gbp-audit')}>Ihr Profil mit 10 Fragen selbst bewerten</a>.
        Fragen? Schreiben Sie an <a href={`mailto:${email}`}>{email}</a>.
      </p>
    </section>
  </div>
</main>

<AnalizDialog locale="de" email={email} />

<Footer locale="de" email={email} news={false} />

</BaseLayout>
