---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'NOTFALL', title: 'Patienten mit Schmerzen', text: 'Wer nachts pochende Zahnschmerzen hat, schaut auf die Karte und ruft direkt an. Ihre Öffnungszeiten und Ihre Telefonnummer müssen in diesem Moment stimmen.' },
  { label: 'BEHANDLUNG', title: 'Behandlungsseiten', text: 'Wer über ein Implantat oder eine unsichtbare Zahnschiene nachdenkt, liest wochenlang. Für jede Schwerpunktbehandlung schreiben wir eine Seite, die genau seine Fragen beantwortet.' },
  { label: 'BEWERTUNG', title: 'Bewertungen mit Diskretion', text: 'Wir bitten um Bewertungen, geben dafür aber nichts. In Antworten nennen wir nie, welche Behandlung der Patient bekommen hat.' },
  { label: 'REGELN', title: 'Grenzen der Werbung', text: 'Vorher-nachher-Bilder, Aktionen und Behauptungen wie „der Beste“ schreiben wir nicht. Jeden Text legen wir Ihnen vor der Veröffentlichung zur Freigabe vor.' },
];

const toc = [
  { id: 'acil', label: 'Suchen bei akuten Zahnschmerzen' },
  { id: 'tedavi', label: 'Patienten, die zu Behandlungen recherchieren' },
  { id: 'kurallar', label: 'Werberegeln im Gesundheitswesen' },
  { id: 'kategori', label: 'Kategorie und Profilname' },
  { id: 'yorum', label: 'Bewertungen und Privatsphäre' },
  { id: 'sube', label: 'Filialen und Gesundheitstourismus' },
  { id: 'olcum', label: 'Was wir messen' },
];

const faq = [
  {
    q: 'Wie überzeugen wir Patienten, wenn wir keine Vorher-nachher-Fotos zeigen dürfen?',
    a: 'Mit Seiten, die die Behandlung ehrlich erklären. Bevor Patienten entscheiden, suchen sie Antworten auf Fragen wie „Wie viele Sitzungen dauert das?“ oder „Wann kann ich wieder arbeiten?“. Eine Seite, die diese Fragen offen beantwortet, hält sich auch an die Regeln.',
  },
  {
    q: 'Dürfen wir auf der Website Preisangaben machen?',
    a: 'Eine Preisliste veröffentlichen wir nicht, weil Werbung über Preis und Rabatte im Gesundheitswesen eingeschränkt ist. Stattdessen erklären wir, wovon der Preis abhängt, etwa von der Zahl der Implantate oder vom Zustand des Knochens. Den genauen Betrag erfährt der Patient nach der Untersuchung in Ihrer Praxis.',
  },
  {
    q: 'Wir behandeln nachts nicht. Müssen wir bei Notfallsuchen sichtbar sein?',
    a: 'Nein, es reicht, wenn Ihre Öffnungszeiten stimmen. Das Profil sollte klar zeigen, wann Sie geschlossen haben, und genau darauf achtet der Patient, der am nächsten Morgen anrufen will. Verwenden Sie das Wort „Notfall“ nur, wenn Sie tatsächlich Notfallpatienten annehmen.',
  },
  {
    q: 'Wann sehen wir Ergebnisse?',
    a: 'Einen Zeitraum nennen wir nicht; er hängt vom Ausgangspunkt Ihres Unternehmens, vom Wettbewerb und vom Kanal ab. Sagen können wir die Reihenfolge der Arbeit: erst messen, dann die Grundprobleme beheben, dann Inhalte erstellen. Was wir getan haben und wie sich die Messung verändert hat, sehen Sie jede Woche im Bericht.',
  },
];
---

<ContentLayout
  locale={locale}
  route="industries/dental"
  title="SEO für Zahnärzte und Zahnarztpraxen | Wiserrise"
  description="Lokale SEO für Zahnarztpraxen im Rahmen der Werberegeln: Notfallsuchen, Behandlungsseiten, Bewertungen, Filialen. Messung im Umkreis, wöchentlicher Bericht."
  eyebrow="BRANCHE · ZAHNÄRZTE"
  h1="SEO für Zahnärzte: da sein, wenn Patienten suchen."
  crumb="Zahnärzte"
  lede="SEO für Zahnärzte heißt, zwei Patienten gleichzeitig zu erreichen: den, der nachts mit Schmerzen „Zahnarzt geöffnet“ tippt, und den, der seit Wochen zu Implantaten recherchiert. Der erste schaut auf die Karte und zum Telefon, der zweite liest Ihre Behandlungsseiten. Wir bauen beides auf und halten uns dabei an die türkischen Werberegeln für Gesundheitsleistungen."
  serviceName="Lokale SEO für Zahnarztpraxen"
  breadcrumb={[
    { label: 'Startseite', href: '/de' },
    { label: 'Branchen', href: p('industries') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'Betreuung des Google-Unternehmensprofils', href: p('services/gbp'), text: 'Öffnungszeiten, Kategorie, Leistungsliste und Antworten auf Bewertungen betreuen wir zusammen.' },
    { label: 'Content-Erstellung', href: p('services/content'), text: 'Behandlungsseiten schreiben wir entlang der Fragen, die Patienten wirklich stellen.' },
    { label: 'SEO für Ästhetik-Kliniken', href: p('industries/aesthetics'), text: 'Wie wir in einem Bereich arbeiten, in dem die Entscheidung lange dauert und häufig nach dem Preis gefragt wird.' },
    { label: 'SEO für Physiotherapeuten', href: p('industries/physio'), text: 'Suchen, die von der Nähe im Stadtteil und wiederkehrenden Sitzungen bestimmt werden.' },
  ]}
  relatedHeading="Verwandte Seiten"
  ctaLabel="Kostenlose Analyse anfordern"
  ctaHref="/de#contact"
>
  <h2 id="acil">Wie findet Sie ein Patient mit Zahnschmerzen?</h2>

  <p>
    Über die Karte, und er ruft an, ohne die Website zu öffnen. Wer um 23 Uhr pochende Zahnschmerzen hat, tippt „Zahnarzt
    geöffnet“ oder „zahnärztlicher Notdienst“, schaut sich die ersten Praxen auf der Karte an und drückt auf Anrufen. Die
    Entscheidung fällt in Sekunden.
  </p>

  <p>
    Bei dieser Suche zählen zuerst Ihre Öffnungszeiten. Fehlen sie im Profil oder sind für Feiertage keine Sonderzeiten
    eingetragen, sieht Sie niemand, der die Karte nach geöffneten Praxen filtert.
  </p>

  <p>
    Dazu kommt die Falle beim Profilnamen. Namen wie „Notfall-Zahnklinik Kadıköy Implantate“ scheinen kurzfristig zu
    wirken, verstoßen aber gegen Googles Richtlinien und können bis zur Sperrung des Profils führen. Ihr Profilname muss
    mit dem Namen auf Ihrem Praxisschild übereinstimmen.
  </p>

  <p>
    Wenn Sie nachts tatsächlich keine Patienten annehmen, verwenden Sie das Wort „Notfall“ nirgends. Ein Patient, der
    nachts anruft und Sie nicht erreicht, vertraut Ihrem Profil mit „Notfall“ kein zweites Mal.
  </p>

  <p>
    Wenn Sie Patienten annehmen, kommt es darauf an, ans Telefon zu gehen. Den Preis für eine späte Reaktion haben wir
    selbst bezahlt: Als wir noch neu waren, bemerkten wir den einzigen Lead aus einer Meta-Anzeige erst nach 5 Tagen, für
    die Weitergabe an den Kunden war es zu spät, und Tausende Lira waren verbrannt. Ein Patient mit Schmerzen wartet keine
    5 Tage, nicht einmal 5 Minuten.
  </p>

  <p>
    Öffnungszeiten, Sondertage, Telefon- und Nachrichteneinstellungen betreuen wir im Rahmen der
    <a href={p('services/gbp')}>Betreuung des Google-Unternehmensprofils</a>.
  </p>

  <h2 id="tedavi">Was liest ein Patient, der zu Implantaten recherchiert?</h2>

  <p>
    Er liest Antworten auf seine Fragen. Wer über ein Implantat oder eine kieferorthopädische Behandlung nachdenkt,
    recherchiert vor der Entscheidung wochenlang und tippt „wie viele Sitzungen“, „tut das weh“, „wie lange hält ein
    Implantat“, „wovon hängt der Preis ab“.
  </p>

  <p>
    Auf den meisten Zahnarzt-Websites stehen die Behandlungen auf einer einzigen Seite „Unsere Leistungen“, mit je zwei
    Absätzen. Diese Seite kommt bei keiner Behandlungssuche nach vorne. Jede Schwerpunktbehandlung braucht ihre eigene
    Seite.
  </p>

  <p>Auf eine Implantatseite schreiben wir:</p>

  <ul class="checklist">
    <li>In wie vielen Schritten der Eingriff erfolgt, Gesamtdauer und Heilungsphase</li>
    <li>Eine realistische Beschreibung zu Schmerzen und Betäubung</li>
    <li>Für wen er nicht geeignet ist und welche Voraussetzungen gelten</li>
    <li>Die Faktoren, die den Preis bestimmen, etwa die Zahl der Implantate und der Zustand des Knochens</li>
    <li>Ein Vergleich mit Alternativen wie einer Brücke, ohne Überlegenheitsbehauptung</li>
    <li>Die Fragen, die Patienten wirklich stellen, mit kurzen Antworten</li>
  </ul>

  <p>
    Die Behandlungsnamen auf der Seite halten wir exakt gleich mit der Leistungsliste im Profil. Wenn Patienten
    „Weisheitszahn ziehen“ tippen, steht genau das an beiden Stellen.
  </p>

  <p>
    Diese Seiten schreiben wir im Rahmen der <a href={p('services/content')}>Content-Erstellung</a> und richten jede mit
    <a href={p('services/on-page-seo')} style="white-space: nowrap;">Onpage-SEO</a> auf eine einzige Suche aus. Bei
    Gesundheitsseiten schaut Google genauer hin, wer den Text geschrieben hat. Deshalb empfehlen wir, Namen und Titel des
    Zahnarztes, der den Inhalt prüft, auf die Seite zu schreiben.
  </p>

  <h2 id="kurallar">Was verbieten die Werberegeln im Gesundheitswesen?</h2>

  <p>
    Die Werbung für Gesundheitsleistungen ist in der Türkei durch Vorschriften des Gesundheitsministeriums (Sağlık
    Bakanlığı) begrenzt. Viele Schritte, die in anderen Branchen alltäglich sind, bringen einer Zahnarztpraxis Ärger. In
    keinem unserer Texte steht:
  </p>

  <ul>
    <li>Ein Ergebnisversprechen, „garantierter Erfolg“ oder eine Behandlungsgarantie</li>
    <li>Werbung mit Vorher-nachher-Fotos</li>
    <li>Ankündigungen von Rabatten, Aktionen und Paketangeboten</li>
    <li>Patientenbewertungen als Lobesmaterial auf der Website oder in Anzeigen</li>
    <li>Vergleichende Überlegenheitsbehauptungen wie „der Beste“ oder „der Günstigste“</li>
  </ul>

  <p>
    Erlaubt ist Information: was die Behandlung ist, wie sie abläuft, wie lange sie dauert und was den Patienten erwartet.
    Genau das sucht der Patient. Die Regeln lenken Sie ohnehin zu den Inhalten, die Patienten lesen wollen.
  </p>

  <div class="callout">
    <p>
      <strong>Diese Seite ist keine Rechtsberatung.</strong> Maßgeblich für die aktuelle Auslegung der Regeln sind die
      Gesundheitsdirektion Ihrer Provinz und Ihre Berufskammer. Jeden Text, den wir schreiben, legen wir Ihnen vor der
      Veröffentlichung zur Freigabe vor.
    </p>
  </div>

  <p>
    Dieselben Regeln gelten für <a href={p('industries/aesthetics')}>Ästhetik-Kliniken</a> und
    <a href={p('industries/physio')}>Physiotherapeuten</a>. Deren Suchverhalten ist anders, deshalb haben wir sie auf
    eigenen Seiten beschrieben.
  </p>

  <h2 id="kategori">Welche Kategorie sollten Sie wählen?</h2>

  <p>
    Geben Sie die Hauptkategorie der Hauptsuche: „Zahnarzt“ oder „Zahnklinik“. Bereiche, auf die Sie sich wirklich
    konzentrieren, fügen Sie als zusätzliche Kategorien hinzu. Jede Kategorie entspricht einer anderen Gruppe von Suchen.
  </p>

  <p>
    Ein Fehler, den wir häufig sehen: Eine Praxis mit Schwerpunkt Implantologie oder Kieferorthopädie setzt diesen engen
    Bereich als Hauptkategorie. Im engen Bereich gewinnt sie Sichtbarkeit, das große Volumen der Suche „Zahnarzt“ verliert
    sie.
  </p>

  <p>
    Dazu kommt die Frage des Titels. Wenn in Ihrem Team kein Fachzahnarzt für Kieferorthopädie arbeitet, wählen Sie die
    Kategorie „Kieferorthopäde“ nicht, weil sie Patienten eine Spezialisierung suggeriert. Die Kategorie wählen wir im
    Vergleich mit den Kategorien der Praxen, die in Ihrer Gegend vorne stehen; die Methode beschreiben wir
    <a href={p('services/gbp')}>auf der Seite zur Profilbetreuung</a>.
  </p>

  <h2 id="yorum">Ist es ein Problem, Patienten um eine Bewertung zu bitten?</h2>

  <p>
    Bitten dürfen Sie. Wir richten einen festen Ablauf zum Einholen von Bewertungen ein: regelmäßig, jeden Patienten
    einzeln (kein Massenversand) und ohne Anreize wie Geschenke oder Rabatte. Nur Patienten zu fragen, von denen Sie
    annehmen, dass sie zufrieden sind, verstößt gegen Googles Richtlinien; wir wählen nicht aus. Im Gesundheitswesen
    kommen noch die Werberegeln hinzu. Dem Patienten vorzugeben, was er schreiben soll, birgt ebenfalls ein Risiko.
  </p>

  <p>
    Der eigentlich heikle Punkt sind die Antworten. Wenn Sie auf eine Bewertung mit „Schön, dass Sie mit Ihrer
    Implantatbehandlung zufrieden sind“ antworten, haben Sie allen mitgeteilt, welche Behandlung diese Person bekommen hat.
    Unsere Antworten schreiben wir deshalb kurz und ruhig, ohne den Namen einer Behandlung.
  </p>

  <p>
    Bei einer negativen Bewertung wird der Patient zuerst telefonisch kontaktiert, dann folgt eine kurze Antwort, die nicht
    in die Verteidigung geht. Stellen Sie eingegangene Bewertungen auf der Website nicht wie Werbung unter der Überschrift
    „Das sagen unsere Patienten“ aus. Den Ablauf zum Einholen von Bewertungen beschreiben wir Schritt für Schritt im
    <a href={p('guides/more-reviews')}>Ratgeber für mehr Google-Bewertungen</a>.
  </p>

  <h2 id="sube">Was, wenn Sie mehrere Filialen oder Patienten aus dem Ausland haben?</h2>

  <p>
    Jede physische Filiale braucht ein eigenes Profil und eine eigene Seite auf der Website. Filialseiten, die einander
    kopieren, gehören zu den teuersten Fehlern, weil sich die Filialen bei derselben Suche gegenseitig verdrängen. Auf jede
    Seite schreiben wir das Team dieser Filiale und die Behandlungen, die dort angeboten werden.
  </p>

  <p>
    Wenn Sie Patienten aus dem Ausland annehmen, geht die Arbeit in eine ganz andere Richtung. Dieser Bereich setzt eine
    Genehmigung für Gesundheitstourismus vom Gesundheitsministerium voraus, und auch die Werberegeln funktionieren anders.
    Gesucht wird in einer anderen Sprache und landesweit, die Nähe spielt keine Rolle mehr.
  </p>

  <p>
    Wir arbeiten auf Türkisch, Englisch und Deutsch, packen den Gesundheitstourismus aber nicht in das lokale Programm.
    Wenn wir ihn gemeinsam planen, bauen wir ihn von Anfang an getrennt auf.
  </p>

  <h2 id="olcum">Was messen wir?</h2>

  <p>
    Die irreführendste Zahl in einer Zahnarztpraxis ist der Website-Traffic. Ein Teil der Patienten, die über die Karte
    kommen, ruft an, ohne die Website je zu besuchen, und eine Praxis, die nur die Website-Statistik betrachtet, sieht diese
    Patienten nicht. Deshalb lesen wir vier Quellen zusammen:
  </p>

  <ul class="checklist">
    <li>
      <a href={p('services/rank-tracking')}>Messung in Ihrem Umkreis</a>: auf welchem Platz Sie an verschiedenen Punkten in
      Ihrem Umkreis stehen
    </li>
    <li>Profil-Interaktionen: wie viele Personen Sie angerufen, eine Route abgerufen, Ihnen geschrieben oder Ihre Website besucht haben</li>
    <li>Search-Console-Daten der Behandlungsseiten: bei welcher Suche sie erscheinen und wie viele Klicks sie bekommen</li>
    <li>Unsere Arbeit: was wir im Profil und auf der Website geändert haben</li>
  </ul>

  <p>
    Was wir erledigt haben, sehen Sie jede Woche im Bericht und im Kundenportal. Wer alle vier zusammen liest, erkennt früh
    die Lage „Der Platz ist gestiegen, aber das Telefon klingelt nicht“. Der Grund ist manchmal, dass der Platz bei einer
    Behandlungssuche mit geringem Volumen gestiegen ist.
  </p>

  <Fragment slot="cta">
    <h2>Wie viele Praxen in Ihrem Bezirk stehen <span class="highlight">vor Ihnen</span>?</h2>
    <p>
      Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie
      zuerst anfangen sollten. Das Ergebnis liegt innerhalb von 24 Stunden in Ihrem <span style="white-space: nowrap;">E-Mail-Postfach</span>.
    </p>
  </Fragment>
</ContentLayout>
