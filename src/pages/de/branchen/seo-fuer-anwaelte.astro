---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'KATEGORIE', title: 'Die richtige Hauptkategorie', text: 'Die Hauptkategorie im Profil ist Rechtsanwalt. Mediation und einzelne Rechtsgebiete kommen als Nebenkategorien dazu, sonst fallen Sie bei der Hauptsuche zurück.' },
  { label: 'SEITE', title: 'Seiten pro Rechtsgebiet', text: 'Für jedes Gebiet, auf das Sie sich konzentrieren, eine eigene Seite: Ablauf, typische Fragen, Unterlagen. Eine Gebietsliste mit drei Absätzen erscheint in keiner Suche.' },
  { label: 'INHALT', title: 'Informative Beiträge', text: 'Klare Antworten auf Fragen wie „Wie lange dauert eine Scheidung?“. Sachliche Information ist genau das, was § 43b BRAO zulässt, und viele Kanzleien lassen diese Fläche leer.' },
  { label: 'SPRACHE', title: 'Sachlich statt werbend', text: 'Superlative, Erfolgsquoten, Gewinnversprechen und Aktionen schreiben wir nicht. Jede Formulierung prüfen wir an BRAO und BORA, bevor wir den Text veröffentlichen.' },
];

const toc = [
  { id: 'yasak', label: 'Was Anwaltswerbung darf' },
  { id: 'brao', label: 'Drei Punkte aus der BORA' },
  { id: 'kategori', label: 'Kategorie im Profil' },
  { id: 'arama', label: 'Wie suchen Mandanten?' },
  { id: 'sayfa', label: 'Welche Seiten auf der Website?' },
  { id: 'yorum', label: 'Google-Bewertungen' },
  { id: 'ilerleme', label: 'Wie sehen Sie den Fortschritt?' },
  { id: 'sehir', label: 'Mandate von außerhalb' },
];

const faq = [
  {
    q: 'Ist SEO für eine Kanzlei überhaupt zulässig?',
    a: 'In der Regel ja. § 43b BRAO erlaubt Werbung, soweit sie sachlich über die berufliche Tätigkeit informiert und nicht auf die Erteilung eines Auftrags im Einzelfall gerichtet ist. Informative Inhalte über Ihre Kanzlei und Ihre Tätigkeitsgebiete sind genau das. Das Risiko liegt in einzelnen Formulierungen, deshalb schreiben wir sachlich und ohne Superlative. Maßgeblich bleibt die Auslegung durch Ihre Rechtsanwaltskammer.',
  },
  {
    q: 'Sollte ich Mandanten um eine Google-Bewertung bitten?',
    a: 'Ja, wir bitten Ihre Mandanten um Bewertungen: nach Abschluss jedes Mandats, einzeln; keine Sammelanfragen, keine Anreize wie Geschenke oder Rabatte, keine vorformulierten Bewertungstexte. Auf Bewertungen, die eingehen, schreiben wir eine kurze Antwort ohne Details zum Mandat. Antworten auf 1- und 2-Sterne-Bewertungen legen wir Ihnen vor der Veröffentlichung zur Freigabe vor.',
  },
  {
    q: 'Darf ich meine Tätigkeitsgebiete auf der Website nennen?',
    a: 'Ja, wenn Sie entsprechende Kenntnisse nachweisen können; das verlangt § 7 BORA. Vorsicht ist bei Bezeichnungen geboten, die mit einem Fachanwaltstitel verwechselt werden können. „Fachanwalt“ und „Spezialist“ schreiben wir nur, wenn Sie den Titel tatsächlich führen bzw. die Angabe belegen können.',
  },
  {
    q: 'Wann sehe ich Ergebnisse?',
    a: 'Einen Zeitraum nennen wir nicht; er hängt vom Ausgangspunkt Ihres Unternehmens, vom Wettbewerb und vom Kanal ab. Sagen können wir die Reihenfolge der Arbeit: erst messen, dann die Grundprobleme beheben, dann Inhalte erstellen. Was wir getan haben und wie sich die Messung verändert hat, sehen Sie jede Woche im Bericht.',
  },
];
---

<ContentLayout
  locale={locale}
  route="industries/law"
  title="SEO für Anwälte: Kanzlei-SEO nach BRAO und BORA | Wiserrise"
  description="SEO für Kanzleien im Rahmen von § 43b BRAO und BORA: richtige Profilkategorie, Seiten pro Rechtsgebiet, sachliche Inhalte. Wöchentlicher Bericht."
  eyebrow="BRANCHE · ANWÄLTE"
  h1="SEO für Anwälte: sachlich informieren, gefunden werden."
  crumb="Anwälte"
  lede="SEO für Anwälte heißt, Ihr Profil und Ihre Website mit sachlichen Inhalten so aufzubauen, dass Ihre Kanzlei bei Suchen wie „Fachanwalt Arbeitsrecht Köln“ oder „Anwalt Familienrecht Hamburg“ auf der Karte und in den Ergebnissen erscheint. Anwaltswerbung ist in Deutschland erlaubt, solange sie sachlich informiert. Genau in diesem Rahmen arbeiten wir."
  serviceName="SEO für Anwälte"
  breadcrumb={[
    { label: 'Startseite', href: '/de' },
    { label: 'Branchen', href: p('industries') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'Betreuung des Google-Unternehmensprofils', href: p('services/gbp'), text: 'Kategorien und Leistungen formulieren wir sachlich und passend zu Ihren Tätigkeitsgebieten.' },
    { label: 'Content-Erstellung', href: p('services/content'), text: 'Seiten zu Rechtsgebieten und informative Beiträge schreiben wir passend zu den Gebieten Ihrer Kanzlei.' },
    { label: 'Lokale SEO', href: p('services/local-seo'), text: 'Profil und Website bringen wir gemeinsam für den Wettbewerb auf der Karte in Ordnung.' },
  ]}
  ctaLabel="Kostenlose Analyse anfordern"
  ctaHref="/de#contact"
>
  <h2 id="yasak">Was darf Anwaltswerbung, und wo steht SEO?</h2>

  <p>
    Anwaltswerbung ist in Deutschland erlaubt, soweit sie sachlich über die berufliche Tätigkeit informiert und nicht auf
    die Erteilung eines Auftrags im Einzelfall gerichtet ist (§ 43b BRAO). Die Berufsordnung (BORA) konkretisiert das,
    etwa bei Angaben zu Teilbereichen der Berufstätigkeit und bei Fachanwaltsbezeichnungen. Wir schreiben deshalb sachlich
    und ohne Superlative wie ‚bester Anwalt‘. Das ist eine allgemeine Information und keine Rechtsberatung; maßgeblich sind
    BRAO, BORA und die Auslegung durch Ihre Rechtsanwaltskammer.
  </p>

  <p>
    Für SEO ist das eine gute Ausgangslage. Zu beschreiben, wer Ihre Kanzlei ist, in welchen Gebieten sie tätig ist und
    wie ein Verfahren abläuft, ist sachliche Information, und SEO sorgt dafür, dass diese Information bei Google gefunden
    wird. Heikel sind einzelne Sätze, nicht die Arbeit an sich.
  </p>

  <p>
    So ziehen wir in unseren Texten die Linie. Manches in der linken Spalte kann im Einzelfall zulässig sein; wir lassen es
    trotzdem weg, weil die Grenze dort schnell überschritten ist:
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Das schreiben wir nicht</th>
          <th>Das schreiben wir</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Erfolgsquoten, Zahl gewonnener Verfahren</td>
          <td>Wie ein Verfahren abläuft und welche Schritte anstehen</td>
        </tr>
        <tr>
          <td>„Der beste Strafverteidiger der Stadt“</td>
          <td>Eine schlichte Liste Ihrer Tätigkeitsgebiete</td>
        </tr>
        <tr>
          <td>Mandantenstimmen, Dankesschreiben, Fallbeispiele</td>
          <td>Zuständige Rechtsanwaltskammer, Berufsbezeichnung und beruflicher Werdegang</td>
        </tr>
        <tr>
          <td>Rabatte, Aktionen, Lockangebote</td>
          <td>Kontaktdaten und Bürozeiten</td>
        </tr>
        <tr>
          <td>Vergleich mit anderen Kanzleien</td>
          <td>Ihre Veröffentlichungen und Fachartikel</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Unter den <a href={p('industries')}>Branchen, zu denen wir eigene Seiten haben</a>, ist das Recht die mit den meisten
    Vorgaben. Aus unserer Sicht hilft das der Kanzlei, die ihre Arbeit ordentlich macht: Ein Teil der Wettbewerber schreibt
    werbliche Texte, ohne die BORA je gelesen zu haben, ein anderer Teil schreibt aus Vorsicht gar nichts.
  </p>

  <p>
    Seiten, die sich an die Regeln halten und wirklich informieren, sind in dieser Branche selten. Diese Lücke steht der
    Kanzlei offen, die sachlich arbeiten will.
  </p>

  <div class="callout">
    <p>
      <strong>Im Zweifel fragen Sie Ihre Kammer.</strong> Die Texte schreiben wir; die Angaben zu Ihrer Kanzlei und Ihren
      Tätigkeitsgebieten bekommen wir von Ihnen, die Formulierungen prüfen wir an BRAO, BORA und mit Semrush und
      veröffentlichen sie. Formulierungen, bei denen wir unsicher sind, verwenden wir nicht. Ist eine Angabe aus Ihrer
      Sicht berufsrechtlich offen, klären Sie die Frage mit Ihrer Rechtsanwaltskammer.
    </p>
  </div>

  <h2 id="brao">Welche Punkte aus der BORA prägen unsere Texte?</h2>

  <p>
    Suchmaschinenoptimierung ist im Kern sachliche Information: wer Ihre Kanzlei ist, in welchen Gebieten sie tätig ist,
    wie ein Verfahren abläuft. Genau diese Inhalte bewertet Google gut. Drei Punkte beachten wir bei Texten für Kanzleien
    besonders:
  </p>

  <ul class="checklist">
    <li>
      <strong>Tätigkeitsgebiete nur mit Nachweis.</strong> Nach § 7 BORA darf Teilbereiche der Berufstätigkeit nur benennen,
      wer entsprechende Kenntnisse nachweisen kann. Bezeichnungen, die mit einer Fachanwaltschaft verwechselt werden
      können, schreiben wir nicht. „Fachanwalt“ steht nur dort, wo der Titel verliehen ist, „Spezialist“ nur, wo Sie die
      Angabe belegen können.
    </li>
    <li>
      <strong>Mandate nur mit Einwilligung.</strong> Hinweise auf Mandate und Mandanten knüpft die BORA (§ 6) an die
      ausdrückliche Einwilligung des Mandanten. Wir verzichten deshalb auf der Website ganz auf Fallbeispiele,
      Mandantennamen und Bewertungszitate.
    </li>
    <li>
      <strong>Was wir schreiben, ist Ihre Werbung.</strong> Texte, die wir als Agentur für Sie verfassen, müssen denselben
      Maßstäben genügen wie Ihre eigenen. Eine Agentur ist kein Umweg um das Berufsrecht.
    </li>
  </ul>

  <p>
    Dazu kommen die Pflichtangaben, die jede Kanzlei-Website ohnehin braucht: ein vollständiges Impressum nach § 5 DDG mit
    zuständiger Rechtsanwaltskammer und gesetzlicher Berufsbezeichnung. Diese Seite ist für Google ein Vertrauenssignal,
    weil sie zeigt, dass hinter der Website eine zugelassene Kanzlei steht.
  </p>

  <h2 id="kategori">Welche Kategorie sollte Ihr Google-Profil haben?</h2>

  <p>
    Die Hauptkategorie sollte Rechtsanwalt sein. Bei Kanzleien ist das der Bereich, der am häufigsten falsch eingerichtet
    ist, und den Fehler sehen wir vor allem bei Anwälten, die auch als Mediator arbeiten: Als Hauptkategorie ist Mediator
    gewählt.
  </p>

  <p>
    Diese Wahl wirft Sie bei Suchen mit dem Wort „Anwalt“ zurück. Richtig ist, Rechtsanwalt als Hauptkategorie zu setzen
    und Mediation als Nebenkategorie aufzunehmen. Die Nachfrage nach Mediation fängt eine eigene Seite auf der Website auf.
  </p>

  <p>
    Der zweite häufige Fehler: alle Rechtsgebiete als Nebenkategorien einzutragen. Googles Liste enthält eigene
    Anwaltskategorien für Gebiete wie Strafrecht oder Familienrecht, aber alle hinzuzufügen macht das Profil unscharf. Wir
    beschränken uns auf die zwei oder drei Gebiete, auf die Sie sich wirklich konzentrieren, und wählen keine Kategorie,
    die einen Fachanwaltstitel nahelegt, den Sie nicht führen. Details stehen auf der Seite
    zur <a href={p('services/gbp')}>Betreuung des Google-Unternehmensprofils</a>.
  </p>

  <h2 id="arama">Wie suchen Mandanten bei Google?</h2>

  <p>Auf zwei Arten. Beides zu verwechseln ist der Inhaltsfehler, der Kanzleien am teuersten zu stehen kommt.</p>

  <ul>
    <li>
      <strong>Wer Informationen sucht.</strong> „Wie lange dauert eine Scheidung“, „Wie hoch ist eine Abfindung“.
      Diese Person sucht noch keinen Anwalt, sie versucht ihre Lage zu verstehen. Diese Suchen ranken unabhängig von der
      Stadt.
    </li>
    <li>
      <strong>Wer einen Anwalt sucht.</strong> „Anwalt Familienrecht Hamburg-Eimsbüttel“, „Strafverteidiger in der Nähe“. Diese Person
      steht kurz vor ihrer Entscheidung. Bei diesen Suchen erscheint zuerst die Karte, und die Nähe zur suchenden Person ist
      entscheidend.
    </li>
  </ul>

  <p>
    Wer einen Anwalt sucht, erreichen Sie auf der Karte, wer Informationen sucht, mit den Beiträgen auf Ihrer Website. Eine
    Kanzlei, die nur bloggt und das Profil leer lässt, bekommt Besucher, aber das Telefon klingelt nicht. Dieses Bild sehen
    wir in dieser Branche am häufigsten.
  </p>

  <h2 id="sayfa">Welche Seiten sollte die Website Ihrer Kanzlei haben?</h2>

  <p>
    Für jedes Gebiet, auf das Sie sich konzentrieren, eine eigene Seite. Die meisten Kanzlei-Websites folgen demselben
    Muster: Startseite, Über uns und eine Seite mit Tätigkeitsgebieten, die jedem Gebiet drei Absätze widmet. Diese
    Struktur erscheint bei keiner Suche nach einem Rechtsgebiet, weil sie kein Gebiet wirklich erklärt.
  </p>

  <p>Diese Struktur bauen wir auf:</p>

  <ul class="checklist">
    <li>Eine eigene Seite für jedes Haupttätigkeitsgebiet: Ablauf, typische Schritte, nötige Unterlagen, häufige Fragen</li>
    <li>Eine Übersichtsseite der Tätigkeitsgebiete, die diese Seiten zusammenführt</li>
    <li>Informative Beiträge, die auf die passende Gebietsseite verlinken</li>
    <li>Berufsangaben der Anwälte: zuständige Rechtsanwaltskammer, Berufsbezeichnung, beruflicher Werdegang</li>
    <li>Strukturierte Daten vom Typ LegalService, die exakt mit den Angaben in Ihrem Google-Profil übereinstimmen</li>
  </ul>

  <p>
    Die Seite mit den Berufsangaben erfüllt zwei Aufgaben. Sie bündelt die sachlichen Angaben zu Ihrer Person an einem
    Ort und zeigt Google, dass hinter dieser Website ein zugelassener, echter Anwalt steht. Diese Seiten schreiben wir im
    Rahmen der <a href={p('services/content')}>Content-Erstellung</a> passend zu den Gebieten Ihrer Kanzlei.
  </p>

  <h2 id="yorum">Was ist mit Google-Bewertungen?</h2>

  <p>
    Für den Platz auf der Karte sind Bewertungen ein starkes Signal. In der Anwaltschaft ist das Thema trotzdem heikler
    als in anderen Branchen.
  </p>

  <p>
    Dafür gibt es zwei Gründe. Ihre Verschwiegenheitspflicht gilt auch bei Google, und im Straf- oder Familienrecht
    möchte ein Mandant ohnehin nicht öffentlich machen, dass er anwaltliche Hilfe gebraucht hat. Diese Grenze verdient
    Respekt.
  </p>

  <p>
    Deshalb veröffentlichen wir auf der Website keine Mandantenstimmen, und im Schema der Website steht keine
    Sternebewertung. Um Bewertungen bitten wir Ihre Mandanten trotzdem: nach Abschluss jedes Mandats, einzeln; keine
    Sammelanfragen, keine Anreize wie Geschenke oder Rabatte, keine vorformulierten Bewertungstexte. Die Bitte selbst
    formulieren wir sachlich; im Zweifel fragen Sie Ihre Kammer. Eine Bewertungsanfrage per E-Mail, SMS oder WhatsApp gilt in Deutschland
    als Werbung und braucht in der Regel die vorherige Einwilligung des Mandanten (§ 7 UWG). Daneben arbeiten wir mit
    einem vollständigen Profil und gründlichen Gebietsseiten. Auf Bewertungen, die eingehen, schreiben wir eine kurze
    Antwort, ohne auf das Mandat einzugehen; Antworten auf 1- und 2-Sterne-Bewertungen legen wir Ihnen vor der
    Veröffentlichung zur Freigabe vor.
  </p>

  <div class="callout">
    <p>
      <strong>Mandanteninformationen sind kein Inhalt.</strong> In keinem Text verwenden wir Aktendetails, Angaben zu
      Parteien oder ein Detail, das einen Mandanten erkennbar macht. Selbst bei der Antwort auf eine negative Bewertung
      bestätigen wir nicht einmal, dass ein Mandat bestand.
    </p>
  </div>

  <h2 id="ilerleme">Wie sehen Sie den Fortschritt?</h2>

  <p>
    Zuerst messen wir, auf welchem Platz Sie an verschiedenen Punkten im Umkreis Ihrer Kanzlei bei Suchen wie
    „Strafverteidiger“ stehen. Einen Zeitraum nennen wir nicht; er hängt vom Ausgangspunkt Ihrer Kanzlei, vom Wettbewerb
    und vom Kanal ab. Was wir erledigt haben und wie sich die Messung verändert hat, sehen Sie jede Woche im Bericht und
    im Kundenportal.
  </p>

  <h2 id="sehir">Kommen Mandate auch von außerhalb der Stadt?</h2>

  <p>
    Das ist möglich, und der Weg dorthin sind die informativen Beiträge auf der Website. Die Karte zeigt Kanzleien in der
    Nähe der suchenden Person, und ein zweites Profil für eine andere Stadt verstößt gegen Googles Richtlinien.
  </p>

  <p>
    Informationssuchen ranken dagegen unabhängig von der Stadt. Bei Beratung und Handelsstreitigkeiten, die sich aus der
    Ferne betreuen lassen, sind diese Beiträge der realistischste Weg, auf dem ein Mandant aus einer anderen Stadt Sie
    findet.
  </p>

  <p>
    Bei Stadtseiten sind wir vorsichtig. Eine Seite für eine Stadt, in der Sie tatsächlich keine Mandate übernehmen,
    verstößt gegen Googles Regeln zu Brückenseiten und wäre auch keine sachliche Information mehr. Deshalb legen wir
    sie nur für Orte an, an denen Sie wirklich tätig sind, und mit Inhalten, die zu diesem Ort passen.
  </p>

  <Fragment slot="cta">
    <h2>Bei welcher Suche ist Ihre Kanzlei <span class="highlight">unsichtbar</span>?</h2>
    <p>
      Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie
      zuerst anfangen sollten. Das Ergebnis liegt innerhalb von 24 Stunden in Ihrem <span style="white-space: nowrap;">E-Mail-Postfach</span>.
    </p>
  </Fragment>
</ContentLayout>
