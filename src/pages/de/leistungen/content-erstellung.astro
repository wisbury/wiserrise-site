---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'LEISTUNG', title: 'Leistungsseiten', text: 'Eine eigene Seite für jede Leistung, die Sie anbieten. Sie beantwortet die Fragen der Suchenden und führt sie zum Anruf und zum Termin.' },
  { label: 'STADTTEIL', title: 'Stadtteil und Stadt', text: 'Nur, wenn es über die Gegend wirklich etwas zu sagen gibt. Kopien mit ausgetauschtem Stadtnamen schreiben wir nicht.' },
  { label: 'RATGEBER', title: 'Ratgeberartikel', text: 'Sie erreichen Menschen mit einer Informationsfrage früh und schicken sie zur Leistungsseite. Ratgeber kommen erst, wenn die Leistungsseiten fertig sind.' },
  { label: 'FREIGABE', title: 'Fachliche Freigabe', text: 'Der Entwurf kommt von uns, die fachliche Freigabe von Ihnen. Bei Anwälten und im Gesundheitsbereich schreiben wir nach den Werberegeln des jeweiligen Berufs.' },
];

const toc = [
  { id: 'nedir', label: 'Was Content-Erstellung umfasst' },
  { id: 'sira', label: 'Warum zuerst Leistungsseiten?' },
  { id: 'sehir', label: 'Stadtteil- und Stadtseiten' },
  { id: 'kurallar', label: 'Anwälte und Gesundheit' },
  { id: 'surec', label: 'Wie eine Seite entsteht' },
  { id: 'yapay-zeka', label: 'Einsatz von KI' },
];

const faq = [
  {
    q: 'Wer schreibt die Inhalte?',
    a: 'Recherche und Entwurf übernehmen wir, die fachliche Richtigkeit geben Sie frei. Bei Kanzleien und im Gesundheitsbereich geht keine Seite ohne fachliche Freigabe online.',
  },
  {
    q: 'Wie viele Inhalte braucht es pro Monat?',
    a: 'Eine feste Zahl nennen wir nicht. Zuerst werden die fehlenden Leistungsseiten fertiggestellt, und die Liste der Lücken bestimmt die Zahl. Danach wählen wir jede weitere Seite nach der echten Nachfrage in den Suchen aus.',
  },
  {
    q: 'Beeinflusst ein Blog meinen Platz auf der Karte?',
    a: 'Direkt nur begrenzt. Ein Blog bringt Menschen mit Informationsfragen auf die Website und führt sie per Link zu Ihrer Leistungsseite. Für den Platz auf der Karte sind Ihr Google-Unternehmensprofil und Ihre Leistungsseiten entscheidender.',
  },
  {
    q: 'Was passiert mit meinen bestehenden Artikeln?',
    a: 'Die prüfen wir zuerst. Artikel mit Impressionen, aber ohne Klicks, oder Artikel, die mit einer anderen Ihrer Seiten um dieselbe Suche konkurrieren, schreiben wir neu oder führen sie zusammen. Artikel ohne jede Impression und mit schwachem Bezug zu Ihrem Geschäft empfehlen wir zu entfernen.',
  },
];
---

<ContentLayout
  locale={locale}
  route="services/content"
  title="SEO-Content-Erstellung | Wiserrise"
  description="SEO-Content für lokale Unternehmen: zuerst Leistungsseiten, dann Stadtteilseiten und Ratgeber mit echten Informationen. Online erst nach fachlicher Freigabe."
  eyebrow="LEISTUNG · CONTENT-ERSTELLUNG"
  h1="Mit SEO-Content die fehlenden Seiten Ihrer Website ergänzen."
  crumb="Content-Erstellung"
  lede="Bei der Content-Erstellung schreiben wir die Seiten, die auf Ihrer Website fehlen. Zuerst stellen wir die Leistungsseiten fertig, die Kunden zum Telefon bringen, der Blog kommt zuletzt. Welche Seite fehlt, ermitteln wir aus Suchdaten und aus den Leistungen in Ihrem Google-Profil."
  serviceName="SEO-Content-Erstellung"
  breadcrumb={[
    { label: 'Startseite', href: '/de' },
    { label: 'Leistungen', href: p('services') },
    { label: 'SEO', href: p('services/seo') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'SEO', href: p('services/seo'), text: 'Grundlage, Seitenaufbau, Inhalte und Links: die Hauptleistung, zu der diese gehört.' },
    { label: 'Lokale SEO', href: p('services/local-seo'), text: 'Wir bringen Profil und Website zusammen in Ordnung, damit Sie auf der Karte nach vorne kommen.' },
    { label: 'Onpage-SEO', href: p('services/on-page-seo'), text: 'Wir richten jede Seite auf eine einzige Suche aus und korrigieren Title und interne Links.' },
    { label: 'Technisches SEO', href: p('services/technical-seo'), text: 'Wir beheben Crawling- und Indexierungsfehler, damit die Seiten, die wir schreiben, bei Google ankommen.' },
  ]}
  ctaLabel="Kostenlose Analyse anfordern"
  ctaHref="/de#contact"
>
  <h2 id="nedir">Was umfasst Content-Erstellung?</h2>

  <p>
    Jede Seite, die auf Ihrer Website sein müsste und fehlt. Bei einem lokalen Unternehmen stehen Leistungsseiten oben
    auf der Liste, Blogartikel kommen zuletzt.
  </p>

  <p>
    Wenn jemand in Izmir nach „Kfz-Gutachter Bornova“ sucht, sucht Google eine Seite, die genau diese Leistung in dieser
    Gegend beschreibt. Besteht Ihre Website nur aus Startseite und Kontaktseite, hat Google nichts zu zeigen.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Seite</th>
          <th>Beispielsuche</th>
          <th>Wozu sie dient</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Leistungsseite</strong></td>
          <td>„Wurzelbehandlung“, „Scheidungsanwalt“</td>
          <td>Empfängt Menschen, die bereit sind, die Leistung zu buchen. Die Seite, die dem Anruf am nächsten ist.</td>
        </tr>
        <tr>
          <td><strong>Stadtteil- oder Stadtseite</strong></td>
          <td>„Kfz-Gutachter Bornova“</td>
          <td>Macht Sie in der Gegend sichtbar, die Sie bedienen. Echte lokale Informationen sind Pflicht.</td>
        </tr>
        <tr>
          <td><strong>Ratgeberartikel</strong></td>
          <td>„wie viele Sitzungen braucht eine Wurzelbehandlung“</td>
          <td>Erreicht Menschen mit Informationsfragen früh und führt sie per Link zur Leistungsseite.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="sira">Warum zuerst Leistungsseiten?</h2>

  <p>
    Weil sie die Kunden bringen. Wenn Sie mit Ratgeberartikeln Besucher auf eine Website ohne Leistungsseiten holen,
    finden die Besucher keinen Ort, an dem sie weitermachen können, und gehen wieder.
  </p>

  <p>
    Deshalb schreiben wir keinen Blog, bevor die Leistungsseiten fertig sind. Einem Unternehmen, das einen Blog möchte,
    zeigen wir zuerst die Liste der fehlenden Leistungsseiten.
  </p>

  <p>
    Diese Liste ermitteln wir aus Suchen, die in der Search Console Impressionen bekommen, aber keine passende Seite haben,
    und aus Seiten, die Ihre Wettbewerber haben und Sie nicht. Die schnellste Quelle ist Ihr
    <a href={p('services/gbp')}>Google-Unternehmensprofil</a>: Jede Leistung, die im Profil steht, aber auf der Website
    keine Seite hat, kommt auf die Liste.
  </p>

  <h2 id="sehir">Wann legt man eine Stadtteil- oder Stadtseite an?</h2>

  <p>
    Wenn Sie über diese Gegend wirklich etwas zu sagen haben. Kopierte Seiten mit ausgetauschtem Stadtnamen wertet Google
    als „Doorway“-Seiten, und sie schaden der ganzen Website. Die Regeln für Filialen und bediente Städte erklären wir auf
    der <a href={`${p('services/local-seo')}#coklu`}>Seite zur lokalen SEO</a>.
  </p>

  <p>
    Was heißt „wirklich etwas“? Angenommen, Sie haben ein Physiotherapiezentrum in Kadıköy und machen auch Hausbesuche in
    Ataşehir. Die Seite für Ataşehir kann Folgendes erklären:
  </p>

  <ul class="checklist">
    <li>In welche Viertel von Ataşehir Sie fahren</li>
    <li>Welche Behandlungen beim Hausbesuch möglich sind</li>
    <li>Wie ein Hausbesuch geplant wird und wie man ins Zentrum kommt, wenn man lieber vorbeikommt</li>
    <li>Die Fragen, die Patienten aus dieser Gegend am Telefon am häufigsten stellen</li>
  </ul>

  <p>
    Ohne diese Informationen legen wir die Seite nicht an. Eine Vorlage mit eingesetztem Stadtteilnamen zu vervielfältigen
    wirkt schnell, schwächt die Website aber in Googles Augen.
  </p>

  <p>
    Für welchen Stadtteil wir zuerst eine Seite anlegen, entscheidet die
    <a href={p('services/rank-tracking')}>Messung</a> in Ihrem Umkreis. Stadtteile, aus denen Sie wirklich Aufträge
    bekommen, in der Suche aber zurückliegen, kommen an den Anfang der Liste.
  </p>

  <h2 id="kurallar">Worauf achten wir bei Anwalts- und Gesundheitswebsites?</h2>

  <p>
    Auf die Berufsregeln. Für Anwaltswebsites gilt das Werbeverbot des Dachverbands der türkischen Anwaltskammern (TBB
    Reklam Yasağı Yönetmeliği). Erfolgsversprechen, Erfolgsquoten, Überlegenheitsbehauptungen wie „der beste“ und
    Bewertungen von Mandanten haben dort keinen Platz.
  </p>

  <p>
    Im Gesundheitsbereich gelten ähnliche Grenzen. Behandlungsgarantien oder Vorher-nachher-Versprechen schreiben wir
    nicht. Jeder Text geht vor der Veröffentlichung durch diesen Filter und braucht die Freigabe des Anwalts oder des
    Arztes.
  </p>

  <p>
    Ein informativer Text ohne große Behauptungen wirkt in diesen Branchen auch auf Leser glaubwürdiger. Details für die
    einzelnen Branchen finden Sie auf den Seiten <a href={p('industries/law')}>SEO für Anwälte</a> und
    <a href={p('industries/dental')}>SEO für Zahnärzte</a>.
  </p>

  <h2 id="surec">Wie entsteht eine Seite?</h2>

  <p>Jede Seite durchläuft dieselben Schritte:</p>

  <ol>
    <li>
      <strong>Liste der Lücken.</strong> Aus den oben genannten Quellen ermitteln wir die Seiten, die auf Ihrer Website
      fehlen.
    </li>
    <li>
      <strong>Reihenfolge.</strong> Die Seite, die dem Anruf am nächsten ist, kommt zuerst, Ratgeberartikel zuletzt.
    </li>
    <li>
      <strong>Plan.</strong> Für jede Seite legen wir die Zielsuche, die zu beantwortenden Fragen, die internen Links und
      den Schema-Typ fest. Dieser Teil gehört zum
      <a href={p('services/on-page-seo')} style="white-space: nowrap;">Onpage-SEO</a>.
    </li>
    <li>
      <strong>Schreiben und Freigabe.</strong> Den Entwurf schreiben wir, die Richtigkeit der Angaben zu Ihrem Geschäft
      geben Sie frei.
    </li>
    <li>
      <strong>Veröffentlichung.</strong> Wir stellen die Seite online, binden sie in die internen Links ein und nehmen sie
      in die Sitemap auf. Wenn wir die Website nicht komplett betreuen können, fangen wir nicht an, deshalb liegt auch die
      Veröffentlichung bei uns.
    </li>
    <li>
      <strong>Beobachtung.</strong> Bei welchen Suchen die Seite erscheint, verfolgen wir in der Search Console und
      ergänzen fehlende Fragen.
    </li>
  </ol>

  <p>
    Was wir getan haben, sehen Sie jede Woche im Bericht. Einen Zeitraum für die erste Bewegung in der Suche nennen wir
    nicht; damit eine Seite bei Google ankommt, muss zuerst das
    <a href={p('services/technical-seo')}>technische SEO</a> sauber sein.
  </p>

  <h2 id="yapay-zeka">Setzen Sie KI ein?</h2>

  <p>
    Ja, bei der Recherche und beim ersten Entwurf. Das Rohergebnis veröffentlichen wir nie unverändert.
  </p>

  <p>
    Die KI kennt Ihr Geschäft nicht. Ein Text, der ohne Wissen darüber entsteht, in welche Stadtteile Sie fahren und was
    Kunden am Telefon fragen, hebt sich nicht von ähnlichen Seiten ab, die dieselbe Suche anpeilen. Und eine Seite, die
    sich nicht abhebt, rankt nicht.
  </p>

  <p>
    Ob KI-Antworten Sie nennen, hängt vom Gleichen ab. ChatGPT und Gemini stützen sich auf Quellen, die die Frage klar
    beantworten und das Unternehmen überall einheitlich beschreiben; diesen Teil messen wir in der Leistung
    <a href={p('services/geo')}>GEO</a>.
  </p>

  <Fragment slot="cta">
    <h2>Welche Seiten <span class="highlight">fehlen</span> auf Ihrer Website?</h2>
    <p>
      Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie
      zuerst anfangen sollten. Das Ergebnis liegt innerhalb von 24 Stunden in Ihrem
      <span style="white-space: nowrap;">E-Mail-Postfach</span>.
    </p>
  </Fragment>
</ContentLayout>
