---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import HubCards from '../../../components/v2/HubCards.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'de' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

// Hauptleistungen. Unterleistungen (Profilbetreuung, Ranking-Tracking, technisches SEO, Onpage-SEO, Content) stehen
// nicht hier, sondern werden von ihrer Hauptleistung aus verlinkt. Leistungen ohne eigene Seite öffnen das Analysefenster.
const services = [
  {
    href: p('services/seo'),
    label: 'SUCHE',
    title: 'SEO',
    text: 'Die Suchergebnisse unter der Karte. Mit technischer Grundlage, Seitenaufbau und Inhalten richten wir Ihre Website auf die Fragen Ihrer Kunden aus.',
    cta: 'Leistung ansehen',
  },
  {
    href: p('services/local-seo'),
    label: 'KARTE',
    title: 'Lokale SEO',
    text: 'Unternehmensprofil und Website zusammen. Wir arbeiten auf die drei Plätze auf der Karte hin, die Kunden in Ihrer Nähe zuerst sehen.',
    cta: 'Leistung ansehen',
  },
  {
    href: p('services/google-ads'),
    label: 'ANZEIGEN',
    title: 'Google Ads',
    text: 'Suchanzeigen für Menschen, die gerade nach Ihrer Leistung suchen. Wir steuern, für welche Suchanfragen Ihr Budget ausgegeben wird.',
    cta: 'Leistung ansehen',
  },
  {
    href: '#analiz-formu',
    analiz: 'meta',
    label: 'SOCIAL',
    title: 'Meta Ads',
    text: 'Anzeigen auf Instagram und Facebook für Menschen in Ihrer Umgebung. Sie lernen Sie kennen, bevor sie suchen.',
    cta: 'Anzeigen-Analyse anfordern',
  },
  {
    href: '#analiz-formu',
    analiz: 'backlink',
    label: 'AUTORITÄT',
    title: 'Linkaufbau',
    text: 'Links von themennahen Websites mit echtem Traffic. White-Label für Agenturen.',
    cta: 'Pakete ansehen',
  },
  {
    href: p('services/geo'),
    label: 'KI',
    title: 'GEO',
    text: 'Wir messen, bei welchen Fragen ChatGPT, Gemini und die KI-Übersichten von Google Sie nennen, und arbeiten an den Fragen, bei denen Sie fehlen.',
    cta: 'Leistung ansehen',
  },
];

const faq = [
  {
    q: 'Kann ich die Leistungen einzeln buchen?',
    a: 'Ja. Oft reicht eine einzelne Leistung allerdings nicht aus. Liegt das Problem an genau einer Stelle, etwa weil Ihre Website bei Google gar nicht auftaucht, beginnen wir nur mit SEO. Was Sie brauchen, sagen wir Ihnen in der kostenlosen Analyse.',
  },
  {
    q: 'Müssen Sie für die Arbeit zu uns vor Ort kommen?',
    a: 'Nein. Wir arbeiten vollständig aus der Ferne. Website, Unternehmensprofil und Anzeigenkonto betreuen wir über die Zugänge, die Sie uns freigeben; ob Ihre Praxis in Hamburg oder Ihr Betrieb in Stuttgart liegt, spielt dafür keine Rolle.',
  },
  {
    q: 'Arbeiten Sie auch mit meinem Konkurrenten in derselben Stadt?',
    a: 'Nein. Pro Stadt und Branche arbeiten wir mit genau einem Unternehmen. Zwei Wettbewerber gleichzeitig auf derselben Karte nach vorn bringen zu wollen, wäre keinem von beiden gegenüber fair.',
  },
  {
    q: 'Wie messen Sie SEO-Ergebnisse?',
    a: 'Wir werten drei Quellen gemeinsam aus: die Messung in Ihrem Umkreis, die Interaktionen mit Ihrem Unternehmensprofil und die Daten aus der Google Search Console. Einen einzelnen Ranking-Screenshot schicken wir nicht, denn Ihr Platz auf der Karte hängt davon ab, wo die suchende Person gerade steht. Was wir getan haben, sehen Sie jede Woche im Bericht.',
  },
];
---

<ContentLayout
  locale={locale}
  route="services"
  title="Online-Marketing-Leistungen für Unternehmen | Wiserrise"
  description="SEO, lokale SEO, Google Ads, Meta Ads, Linkaufbau und GEO für Praxen, Kanzleien und Betriebe. Womit Sie anfangen sollten, zeigt die kostenlose Analyse."
  eyebrow="LEISTUNGEN"
  h1="Online-Marketing-Leistungen: Welche brauchen Sie?"
  crumb="Leistungen"
  lede="Ihre Kunden finden Sie über die Google-Suche, über Google Maps, auf Instagram oder in ChatGPT. Jeder Kanal ist eine eigene Aufgabe, und Sie brauchen nicht alle auf einmal. Die Übersicht unten zeigt, welche Leistung zu welchem Kanal gehört."
  serviceName="Online-Marketing-Leistungen"
  breadcrumb={[{ label: 'Startseite', href: '/de' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Lokale SEO nach Branche', href: p('industries'), text: 'Was bei Kanzleien, Zahnarztpraxen, Kliniken und Kfz-Gutachtern jeweils anders läuft.' },
    { label: 'Ratgeber', href: p('guides'), text: 'Vom Anlegen des Unternehmensprofils bis zu mehr Rezensionen: Schritte, die Sie selbst umsetzen können.' },
    { label: 'Kostenlose Profilprüfung', href: p('tools/gbp-audit'), text: 'Zehn Fragen zeigen Ihnen, wo Ihr Google Unternehmensprofil Lücken hat.' },
  ]}
  relatedHeading="Verwandte Seiten"
  ctaLabel="Kostenlose Analyse anfordern"
  ctaHref="/de#contact"
>
  <h2 id="kanallar">Wo finden Ihre Kunden Sie?</h2>

  <p>
    Fünf der sechs Leistungen zielen auf je einen Kanal. Die sechste, der Linkaufbau, stärkt Sie in der Suche.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Wo?</th>
          <th>Was sieht man?</th>
          <th>Welche Leistung</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Google-Suche</strong></td>
          <td>Die Ergebnisse unter der Karte</td>
          <td><a href={p('services/seo')}>SEO</a></td>
        </tr>
        <tr>
          <td><strong>Google Maps</strong></td>
          <td>Die ersten drei Unternehmen auf der Karte</td>
          <td><a href={p('services/local-seo')}>Lokale SEO</a></td>
        </tr>
        <tr>
          <td><strong>Googles Anzeigenplätze</strong></td>
          <td>Die „Gesponsert“-Zeilen über den Ergebnissen</td>
          <td><a href={p('services/google-ads')}>Google Ads</a></td>
        </tr>
        <tr>
          <td><strong>Instagram und Facebook</strong></td>
          <td>Eine Anzeige im Feed</td>
          <td>Meta Ads</td>
        </tr>
        <tr>
          <td><strong>ChatGPT, Gemini</strong></td>
          <td>Die Unternehmen, die der Assistent empfiehlt</td>
          <td><a href={p('services/geo')}>GEO</a></td>
        </tr>
        <tr>
          <td><strong>Andere Websites</strong></td>
          <td>Seiten, die Sie erwähnen oder auf Sie verlinken</td>
          <td>Linkaufbau</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="reklam-seo">Anzeigen oder SEO?</h2>

  <p>
    Anzeigen laufen, sobald sie freigeschaltet sind, und stoppen, wenn das Budget aufgebraucht ist. SEO und lokale SEO
    brauchen einen längeren Anlauf, verschwinden aber nicht an dem Tag, an dem Sie aufhören.
  </p>

  <p>
    Google Ads erreicht Menschen, die gerade suchen, Meta Ads Menschen, die gerade nicht suchen. Wer Ihre Anzeige auf
    Instagram sieht, sucht in diesem Moment keine Physiotherapie. Die Anzeige soll dafür sorgen, dass er sich an Ihre
    Praxis erinnert, wenn der Rücken schmerzt.
  </p>

  <h2 id="baslangic">Womit sollten Sie anfangen?</h2>

  <p>
    Kommen Ihre Kunden aus der direkten Umgebung, beginnen Sie mit der Karte, also mit lokaler SEO. Arbeiten Sie für die
    ganze Stadt oder bundesweit, beginnen Sie mit SEO. Wenn Sie nicht warten können, starten Sie mit Anzeigen; parallel
    bauen wir die dauerhafte Grundlage auf.
  </p>

  <p>
    Fangen Sie nicht mit einer Vermutung an. Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen:
    wo Sie heute stehen und womit Sie zuerst anfangen sollten. Aufträge, bei denen wir die Website nicht vollständig betreuen können,
    nehmen wir nicht an: Auf einer nur halb betreuten Website hält SEO nicht, und die Besucher aus den Anzeigen gehen
    verloren.
  </p>

  <div class="callout">
    <p>
      <strong>Nach der Analyse müssen Sie nicht mit uns arbeiten.</strong> Die Analyse ist kostenlos und unverbindlich.
    </p>
  </div>

  <Fragment slot="wide">
    <HubCards
      id="hizmet-listesi"
      eyebrow="LEISTUNGEN"
      heading="Wir arbeiten dort, wo Ihre Kunden suchen."
      sub="SEO und lokale SEO arbeiten an Ihrer dauerhaften Sichtbarkeit in der Suche und auf der Karte. Google Ads und Meta Ads machen Sie sichtbar, solange die Anzeigen laufen. GEO überträgt dieselbe Grundlage auf KI-Antworten."
      items={services}
      son={{
        label: 'NOCH UNSICHER?',
        title: 'Wir schauen gemeinsam, was zu Ihnen passt.',
        text: 'Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie zuerst anfangen sollten.',
        cta: 'Kostenlose Analyse',
        alt: 'Kostenlose Analyse anfordern →',
      }}
    />
  </Fragment>

  <Fragment slot="cta">
    <h2>Was brauchen Sie <span class="highlight">zuerst</span>?</h2>
    <p>
      Die kostenlose Analyse ist ein Video, das wir für Ihr Unternehmen aufnehmen: wo Sie heute stehen und womit Sie
      zuerst anfangen sollten. Das Ergebnis liegt innerhalb von 24 Stunden in Ihrem
      <span style="white-space: nowrap;">E-Mail-Postfach</span>.
    </p>
  </Fragment>
</ContentLayout>
