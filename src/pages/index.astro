---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeSchema, type FaqEntry } from '../lib/schema';

/**
 * Tek kaynak: hem görünen SSS bloğu hem `FAQPage` şeması buradan üretilir.
 * Google, FAQ işaretlemesinin sayfada GÖRÜNEN metinle birebir aynı olmasını
 * şart koşar; iki ayrı liste tutmak er geç kayar.
 */
const faq: FaqEntry[] = [
  {
    q: 'How long does local SEO take?',
    a: 'Most businesses start seeing movement in 4–8 weeks, with stronger results compounding over 3–6 months.',
  },
  {
    q: 'Do you only work with one city?',
    a: 'No. We can support single-city, multi-city, and multi-location local SEO campaigns depending on your growth model.',
  },
  {
    q: 'Do you guarantee rankings?',
    a: 'Yes, Top 3 on Google in 90 Days Guaranteed.',
  },
  {
    q: 'What do I get in the free audit?',
    a: 'You get a clear review of your Google Business Profile, local visibility issues, competitive gaps, and the highest-impact next steps.',
  },
  {
    q: 'What is the local pack?',
    a: 'The local pack is the map block of three businesses that Google shows above the normal search results for a local search. Those three listings take most of the calls, which is why getting into them is the whole point of a local SEO strategy.',
  },
  {
    q: 'Is local SEO different from regular SEO?',
    a: 'Yes. Regular SEO competes for a web page in the search results. Local SEO competes for a business in a place, so the search engine weighs your Google Business Profile, your reviews and your distance from the searcher alongside your website.',
  },
  {
    q: 'Do I need a website for local SEO?',
    a: 'You can rank in the local pack without one, but you will plateau. The website is what proves you are relevant for the exact services and neighbourhoods you want, and it is where local search traffic turns into a booking or a call.',
  },
  {
    q: 'How do you measure progress?',
    a: 'We track your rank across a grid of points around your location instead of a single centre point, because a local search result changes with the searcher’s distance. You see the whole map, plus calls, direction requests and profile views.',
  },
];

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  route="home"
  title="Wiserrise | Local SEO & Google Maps Growth"
  description="Local SEO built for the Google Maps local pack. Wiserrise gets local businesses into the top 3, ahead of nearby competitors, and turns visibility into real leads."
  ogImage="/images/og-image.png"
>
  <script
    slot="schema"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      homeSchema({
        locale,
        name: 'Wiserrise | Local SEO & Google Maps Growth',
        description:
          'Local SEO built for the Google Maps local pack. Wiserrise gets local businesses into the top 3, ahead of nearby competitors, and turns visibility into real leads.',
        faq,
      }),
    )}
  />

    
   <section class="hero" id="contact">

  <div class="container hero-grid">

    <!-- LEFT -->
     <div class="hero-content">
       
    <div class="user-location">
  <span class="status-dot"></span>
  <span id="userLocation">Loading location...</span>
</div>
   
      <h1>
  <span class="h1-kicker">Local SEO</span>
  Own Your <span class="highlight">City</span><br>
  on <span class="google-font">Google</span>
</h1>

      <p style="font-weight:700;">
        Get into Google Maps Top 3 in 90 days with a focused local SEO system built for real local growth.
      </p>

      <p style="font-size:14px; color:#6F6C64; margin-top:10px;">
        If you're not in the top results, you're losing customers every day.
      </p>

      <div class="hero-newsletter">
        <p class="hero-newsletter-title">
          Sign up below to get <strong>three free tips</strong> you can implement today to start climbing.
        </p>
        <form id="newsletterForm" class="newsletter-form" action="https://app.kit.com/forms/9696115/subscriptions" method="POST">
          <div class="newsletter-row">
            <input type="email" name="email_address" placeholder="name@email.com" required aria-label="Email address">
            <button type="submit" class="btn btn-primary">Subscribe</button>
          </div>
          <label class="newsletter-consent">
            <input type="checkbox" name="consent" required>
            <span>I agree to receive emails from Wiserrise and accept the privacy terms.</span>
          </label>
          <p class="newsletter-status" role="status" aria-live="polite"></p>
        </form>
      </div>

        <div class="client-strip">

  <p class="client-strip-title">
    Businesses working with
  </p>

  <div class="client-logo-marquee">
  <div class="client-logo-track">
    <!-- Logo az oldugunda set iki kez tekrarlanir: her yari seridi doldurmali -->
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
    <!-- KOPYA -->
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
  </div>
</div>
</div>
</div>
    
    <!-- RIGHT: AUDIT FORM -->
   <div class="hero-right">
  <div class="hero-form-card">
    <h3>Get Your <span class="highlight">Free Audit</span></h3>
    <p>Personalized analysis of your Google profile within 24 hours. No costs, no obligations, no sales pitch.</p>

    <form id="applyForm" class="audit-form" action="https://formspree.io/f/mlgpzokq" method="POST">
      <div class="audit-field">
        <label for="auditName">Full Name *</label>
        <input type="text" id="auditName" name="name" required>
      </div>

      <div class="audit-field">
        <label for="auditEmail">Business Email *</label>
        <input type="email" id="auditEmail" name="email" required>
      </div>

      <div class="audit-field">
        <label for="auditPhone">Phone Number *</label>
        <input type="tel" id="auditPhone" name="phone" required>
      </div>

      <div class="form-row">
        <div class="audit-field">
          <label for="auditCompany">Company Name *</label>
          <input type="text" id="auditCompany" name="company" required>
        </div>

        <div class="audit-field">
          <label for="auditCity">City *</label>
          <input type="text" id="auditCity" name="city" required>
