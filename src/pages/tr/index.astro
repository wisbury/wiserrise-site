<section id="surec" style="max-width: 1312px; margin: 0 auto; padding: clamp(72px, 10vw, 120px) clamp(16px, 3vw, 32px) 0; display: flex; flex-direction: column; gap: 48px;">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px;">
