---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeSchema, type FaqEntry } from '../../lib/schema';

/**
 * Tek kaynak: hem görünen SSS bloğu hem `FAQPage` şeması buradan üretilir.
 * Google, FAQ işaretlemesinin sayfada GÖRÜNEN metinle birebir aynı olmasını
 * şart koşar; iki ayrı liste tutmak er geç kayar.
 */
const faq: FaqEntry[] = [
  {
    q: 'Yerel SEO ne kadar sürer?',
    a: 'Çoğu işletme 4–8 hafta içinde hareket görmeye başlar. Daha güçlü sonuçlar genelde 90 gün içinde birikir.',
  },
  {
    q: 'Sadece tek şehirle mi çalışıyorsunuz?',
    a: 'Hayır. Tek şehir, çok şehir ve çok lokasyonlu yerel SEO yapılarıyla çalışabiliyoruz.',
  },
  {
    q: 'Sıralama garantisi veriyor musunuz?',
    a: 'Evet. Google’da 90 gün içinde ilk 3 garantisi veriyoruz.',
  },
  {
    q: 'Ücretsiz analiz içinde neler var?',
    a: 'Google İşletme Profili, yerel görünürlük sorunları, rakip farkları ve en yüksek etkili sonraki adımların özeti.',
  },
  {
    q: 'Yerel paket (local pack) nedir?',
    a: 'Yerel paket, Google arama sonuçlarında normal sonuçların üstünde çıkan ve üç işletme gösteren harita kutusudur. Aramaların çoğu o üç kayda gider; yerel SEO’nun bütün amacı oraya girmektir.',
  },
  {
    q: 'Yerel SEO ile normal SEO arasındaki fark ne?',
    a: 'Normal SEO bir web sayfasını arama sonuçlarında yarıştırır. Yerel SEO ise bir işletmeyi bir yerde yarıştırır: Google arama motoru web sitenizin yanı sıra İşletme Profilinizi, yorumlarınızı ve arayan kişiye olan mesafenizi de tartar.',
  },
  {
    q: 'Yerel SEO için web sitesi şart mı?',
    a: 'Web siteniz olmadan da yerel pakette çıkabilirsiniz ama bir yerde tıkanırsınız. Site, hedef anahtar kelimeyi ve hizmet verdiğiniz bölgeleri somut olarak kanıtladığınız yerdir; sitenizin arama trafiğini randevuya veya telefona çeviren yer de orasıdır.',
  },
  {
    q: 'İlerlemeyi nasıl ölçüyorsunuz?',
    a: 'Sıralamayı tek merkez noktadan değil, işletmenizin çevresine yayılmış bir nokta ızgarasından ölçeriz; çünkü yerel sonuç arayan kişinin mesafesine göre değişir. Haritanın tamamını, ayrıca arama, yol tarifi ve profil görüntüleme sayılarını görürsünüz.',
  },
];

const locale = 'tr' as const;
---

<BaseLayout
  locale={locale}
  route="home"
  title="Wiserrise | Yerel SEO & Google Maps Optimizasyonu"
  description="Google Haritalar için yerel SEO. Wiserrise işletmenizi şehrinizde ilk 3’e taşır, arama sonuçlarında rakiplerinizin önüne geçirir, görünürlüğü müşteriye çevirir."
  ogImage="/images/og-image-tr.png"
>
  <script
    slot="schema"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      homeSchema({
        locale,
        name: 'Wiserrise | Yerel SEO & Google Maps Optimizasyonu',
        description:
          'Google Haritalar için yerel SEO. Wiserrise işletmenizi şehrinizde ilk 3’e taşır, arama sonuçlarında rakiplerinizin önüne geçirir, görünürlüğü müşteriye çevirir.',
        faq,
      }),
    )}
  />

    
   <section class="hero" id="contact">
  <div class="container hero-grid">

    <!-- LEFT -->
     <div class="hero-content">
       
    <div class="user-location">
  <span class="status-dot"></span>
  <span id="userLocation">Konum Yükleniyor...</span>
</div>
   
      <h1>
  <span class="h1-kicker">Yerel SEO</span>
  <span class="google-font">Google</span>’da Kendi Şehrinde ilk 3 - <span class="highlight">Garantili</span><br>
</h1>

      <p style="font-weight:700;">
        Google Maps’te 90 gün içinde ilk 3’te sıralanman için tasarlanmış bir yerel SEO sistemi.
      </p>

      <p style="font-size:14px; color:#6F6C64; margin-top:10px;">
        İlk sıralarda değilsen, her gün potansiyel müşterileri rakiplerine bırakıyorsun.
      </p>

      <div class="hero-newsletter">
        <p class="hero-newsletter-title">
          Aşağıya kaydolun; <strong>bugün uygulayabileceğiniz üç ücretsiz ipucu</strong> ile yükselmeye başlayın.
        </p>
        <form id="newsletterForm" class="newsletter-form" action="https://app.kit.com/forms/9696107/subscriptions" method="POST">
          <div class="newsletter-row">
            <input type="email" name="email_address" placeholder="name@email.com" required aria-label="E-posta adresi">
            <button type="submit" class="btn btn-primary">Abone Ol</button>
          </div>
          <label class="newsletter-consent">
            <input type="checkbox" name="consent" required>
            <span>Wiserrise'den e-posta almayı ve gizlilik koşullarını kabul ediyorum.</span>
          </label>
          <p class="newsletter-status" role="status" aria-live="polite"></p>
        </form>
      </div>

       <div class="client-strip">

  <p class="client-strip-title">
    Çalışıyor olduğumuz işletmeler..
  </p>

  <div class="client-logo-marquee">
  <div class="client-logo-track">
    <img src="/images/kadim-hukuk.svg" alt="Kadim Hukuk ve Danışmanlık, Ankara" decoding="async">
    <img src="/images/avukat-cansu-bayramoglu.svg" alt="Avukat Cansu Bayramoğlu, Samsun" decoding="async">
    <img src="/images/avukat-ebubekir-kozan.svg" alt="Avukat Ebubekir Kozan, İstanbul" decoding="async">
    <img src="/images/sever-hukuk-burosu.svg" alt="Sever &amp; Sever Hukuk Bürosu, Trabzon" decoding="async">
    <img src="/images/avukat-tugrul-alatas.svg" alt="Tuğrul Alataş Avukatlık Bürosu, Ankara" decoding="async">
    <img src="/images/avukatceyhunguvel.svg" alt="Avukat Arabulucu Ceyhun Güvel, Mersin" decoding="async">
    <img src="/images/avukat-oguzhan-manga.svg" alt="Avukat Oğuzhan Manga, Adana" decoding="async">
    <img src="/images/fizyoterapist-onur-yalcin.svg" alt="Kadıköy Fizyoterapist Onur Yalçın, İstanbul" decoding="async">
    <!-- KOPYA: kesintisiz kayma için ikinci tur; ekran okuyucuya ikinci kez okunmaz -->
    <img src="/images/kadim-hukuk.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/avukat-cansu-bayramoglu.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/avukat-ebubekir-kozan.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/sever-hukuk-burosu.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/avukat-tugrul-alatas.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/avukatceyhunguvel.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/avukat-oguzhan-manga.svg" alt="" aria-hidden="true" decoding="async">
    <img src="/images/fizyoterapist-onur-yalcin.svg" alt="" aria-hidden="true" decoding="async">
  </div>
</div>
</div>
</div>

    <!-- RIGHT: ANALİZ FORMU -->
   <div class="hero-right">
  <div class="hero-form-card">
    <h3>Ücretsiz <span class="highlight">Analizini</span> Al</h3>
    <p>Google profilinin kişisel analizi 24 saat içinde e-postanda. Ücret yok, taahhüt yok, satış konuşması yok.</p>

    <form id="applyForm" class="audit-form" action="https://formspree.io/f/mlgpzokq" method="POST">
      <div class="audit-field">
        <label for="auditName">Ad Soyad *</label>
        <input type="text" id="auditName" name="name" required>
      </div>

      <div class="audit-field">
        <label for="auditEmail">E-posta Adresin *</label>
        <input type="email" id="auditEmail" name="email" required>
      </div>

      <div class="audit-field">
        <label for="auditPhone">Telefon Numaran *</label>
        <input type="tel" id="auditPhone" name="phone" required>
      </div>

      <div class="form-row">
        <div class="audit-field">
          <label for="auditCompany">İşletme Adı *</label>
          <input type="text" id="auditCompany" name="company" required>
        </div>

        <div class="audit-field">
          <label for="auditCity">Şehir *</label>
          <input type="text" id="auditCity" name="city" required>
        </div>
      </div>

      <div class="audit-field">
        <label for="auditMaps">Google Maps İşletme Linkin</label>
        <input type="url" id="auditMaps" name="maps_url" placeholder="https://maps.app.goo.gl/...">
      </div>

      <div class="audit-urgency">
        <span class="audit-urgency-label">Bu sorunu ne zaman çözmek istiyorsun? *</span>
        <div class="urgency-options">
          <input type="radio" id="urgToday" name="urgency" value="Bugün" required>
          <label for="urgToday">Bugün</label>

          <input type="radio" id="urgTomorrow" name="urgency" value="Yarın">
          <label for="urgTomorrow">Yarın</label>

          <input type="radio" id="urgWeeks" name="urgency" value="Birkaç hafta içinde">
          <label for="urgWeeks">Birkaç hafta</label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%; border-radius:999px;">Ücretsiz Analizimi Al →</button>
    </form>

    <p class="hero-form-note">Her şehir ve sektörde yalnızca bir işletmeyle çalışıyoruz.</p>
  </div>
</div>
</section>

      <section id="positioning" class="reveal">
  <div class="container">
    
    <div class="section-head center">
      <span class="eyebrow">Neden Local SEO Önemli?</span>
