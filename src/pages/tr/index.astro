<script is:inline>
  // Bölüme gelince oynar: başlık bloğu, kartlar, adımlar ve SSS sırayla yukarı kayarak gelir.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var sections = document.querySelectorAll('#hizmetler, #surec, section[aria-label="Neden Wiserrise"], #sss, .v2-closing');
    sections.forEach(function (sec) {
      var items = [];
      Array.prototype.forEach.call(sec.children, function (child) {
        var grid = child.matches('ol, [style*="grid"]') ? child : null;
        if (grid) { Array.prototype.push.apply(items, grid.children); }
        else if (child.querySelector(':scope > details')) { items.push(child.firstElementChild); Array.prototype.push.apply(items, child.querySelectorAll(':scope > details')); }
        else items.push(child);
      });
      items.forEach(function (el, i) { el.classList.add('v2-rv'); el.style.setProperty('--i', Math.min(i, 8)); });
    });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) {
          var sec = e.target;
          sec.classList.add('is-in');
          io.unobserve(sec);
          // Giriş bitince sınıfı kaldır; kartların kendi hover hareketi geri gelsin
          sec.querySelectorAll('.v2-rv').forEach(function (el) {
            var i = parseInt(el.style.getPropertyValue('--i'), 10) || 0;
            setTimeout(function () { el.classList.remove('v2-rv'); }, i * 70 + 520);
          });
        } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    sections.forEach(function (sec) { io.observe(sec); });
  })();
</script>

