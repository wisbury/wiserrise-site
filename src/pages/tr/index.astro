    </div>

    <div class="difference-wrap">
      <div class="difference-panel">
        <div class="difference-tabs">
          <button class="diff-tab active" data-view="before" type="button">Önce</button>
          <button class="diff-tab" data-view="after" type="button">Sonra</button>
        </div>

        <div class="difference-company">
          <div class="difference-company-icon">A</div>
          <div>
            <strong>İşletmeniz</strong>
            <p>Yerel pazar görünürlük özeti</p>
