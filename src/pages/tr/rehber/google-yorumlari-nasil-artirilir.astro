---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'HEDEF', title: 'Rakibe göre sayı', text: 'Herkes için geçerli bir yorum sayısı yok. Ölçütünüz, hedef aramanızda haritada ilk üçe çıkan işletmelerin hacmi.' },
  { label: 'AN', title: 'İşin bittiği an', text: 'İşi teslim ettiğiniz anda, deneyim tazeyken isteyin. Günler sonra gönderilen hatırlatmaya dönen müşteri az olur.' },
  { label: 'LİNK', title: 'Kısa yorum linki', text: 'Profilinizin yönetim ekranından alınan link müşteriyi doğrudan yorum ekranına götürür. Sizi haritada araması gerekmez.' },
  { label: 'KURAL', title: 'Teşvik yasak', text: 'İndirim, hediye ya da çekiliş karşılığında yorum istemek Google’ın kurallarına aykırı. Yakalanan yorum silinir.' },
];

const toc = [
  { id: 'hedef', label: 'Kaç yorum yeterli?' },
  { id: 'an', label: 'Ne zaman istemeli?' },
  { id: 'nasil', label: 'Yorum nasıl istenir?' },
  { id: 'kurallar', label: 'Google neyi yasaklıyor?' },
  { id: 'filtre', label: 'Yorumlar neden kaybolur?' },
  { id: 'yanit', label: 'Yanıt nasıl yazılır?' },
  { id: 'olumsuz', label: 'Olumsuz yorum gelirse' },
];

const faq = [
  {
    q: 'Yorum karşılığında indirim verebilir miyim?',
    a: 'Veremezsiniz. Yorum karşılığında indirim, hediye ya da çekiliş Google’ın kurallarına aykırı. Yakalanan yorumlar silinir, tekrarında profil askıya alınabilir.',
  },
  {
    q: 'Yorum satın almak işe yarar mı?',
    a: 'Yaramaz, profilinizi riske atar. Satın alınan yorum Google’ın gözünde sahte yorumdur, filtre yakaladığında silinir. Aynı parayı ve emeği kendi müşterilerinizden yorum isteyen bir düzene harcayın.',
  },
  {
    q: 'Müşteriye ne yazacağını söyleyebilir miyim?',
    a: 'Hazır metin vermeyin. Birbirine benzeyen yorumlar filtreye takılır, okuyan kişi de sahte olduklarını anlar. “Hangi hizmeti aldığınızı yazarsanız çok seviniriz” demeniz yeterli.',
  },
  {
    q: 'Eski müşterilerimden toplu yorum isteyebilir miyim?',
    a: 'İsteyebilirsiniz ama aynı gün istemeyin. Birkaç gün içinde gelen yorum yığını, filtrenin baktığı tipik desen. Listeyi haftalara yayın.',
  },
  {
    q: 'Sahte olumsuz yorumu sildirebilir miyim?',
    a: 'Kural ihlali varsa Google’a bildirebilirsiniz. Hakaret, alakasız içerik ya da rakipten geldiği belli olan yorumlar kaldırılabilir, ama süreç garantili değil ve haftalar sürebilir. Asıl savunmanız gerçek yorum hacminiz.',
  },
];
---

<ContentLayout
  locale={locale}
  route="guides/more-reviews"
  title="Google Yorumları Nasıl Artırılır? | Wiserrise"
  description="Google yorumlarınızı kurallara uygun artırmanın yolu: doğru an, kısa yorum linki, yanıt yazma. Yorum satın almak ve teşvik neden yasak, o da burada."
  eyebrow="REHBER · YORUMLAR"
  h1="Google yorumları nasıl artırılır?"
  crumb="Yorumları artırma"
  lede="Google yorumlarını artırmanın yolu, seçmeden her müşteriden, işin bittiği anda ve tek tıkla açılan bir linkle yorum istemek. Yorum satın almak, indirim karşılığında yorum toplamak ve yalnız memnun müşteriyi seçip Google’a yönlendirmek kurallara aykırı. Hedefinizi rakiplerinize göre koyun, akışı haftalara yayın."
  schemaType="article"
  datePublished="2026-08-01"
  dateModified="2026-11-06"
  breadcrumb={[
    { label: 'Ana Sayfa', href: '/tr' },
    { label: 'Rehberler', href: p('guides') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'Google Haritalar’da üst sıraya çıkma', href: p('guides/rank-higher'), text: 'Yorumların sıradaki yeri ve hangi sırayla çalışmanız gerektiği.' },
    { label: 'İşletmem Google’da çıkmıyor', href: p('guides/not-showing'), text: 'Yorumunuz yeterli ama haritada yoksanız sebebi sırayla eleyin.' },
    { label: 'Google İşletme Profili Yönetimi', href: p('services/gbp'), text: 'Kategori, hizmet yapısı, yorum ve gönderileri birlikte yönetiriz.' },
    { label: 'Avukatlar için SEO', href: p('industries/law'), text: 'Reklam yasağı altında profil ve yorum tarafında neyin mümkün olduğu.' },
  ]}
  relatedHeading="İlgili sayfalar"
  ctaLabel="Profilinizi ücretsiz denetleyin"
  ctaHref={p('tools/gbp-audit')}
>
  <h2 id="hedef">Kaç yorum yeterli?</h2>

  <p>
    Herkes için geçerli bir sayı yok. Ölçütünüz, hedef aramanızda haritada ilk üçe çıkan işletmelerin yorum hacmi. Bazı
    sektörlerde bu 20 yorum demek, bazılarında 200.
  </p>

  <p>
    Bakması kolay. Aramanızı Google Haritalar’da yazın, ilk üçün yorum sayısını ve puanını not edin. Belirgin
    altındaysanız öncelik yorum.
  </p>

  <p>
    Rakiplerle aynı seviyedeyseniz ve hâlâ görünmüyorsanız sorun başka yerde, büyük ihtimalle kategoride. O zaman
    <a href={p('guides/not-showing')}>işletmem Google’da çıkmıyor</a> rehberindeki kontrollerden başlayın.
  </p>

  <div class="callout">
    <p>
      <strong>Hacim, ortalama puandan önce gelir.</strong> 4,7 puanlı 80 yorum, 5,0 puanlı 6 yorumdan daha güçlü bir
      profildir. Kusursuz puan kovalamayın, birkaç 4 yıldız profilinizi daha inandırıcı yapar.
    </p>
  </div>

  <h2 id="an">Yorumu ne zaman istemelisiniz?</h2>

  <p>
    İş biter bitmez, deneyim tazeyken. Yorum oranını metinden çok zamanlama belirler.
  </p>

  <p>
    Diyelim ki Bornova’da oto ekspertiz işletiyorsunuz. Müşteri raporu elinde tutuyor ve henüz tesisten çıkmadı. Yorumu
    isteyeceğiniz an tam bu an, rapor ne çıkmış olursa olsun.
  </p>

  <p>Doğru an sektöre göre değişir:</p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Sektör</th>
          <th>Doğru an</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Oto ekspertiz</td>
          <td>Rapor teslim edilirken, müşteri henüz tesisteyken</td>
        </tr>
        <tr>
          <td>Diş kliniği</td>
          <td>Tedavi bitip kontrol randevusu da geçtiğinde</td>
        </tr>
        <tr>
          <td>Fizyoterapi</td>
          <td>Seans programı bittiğinde</td>
        </tr>
        <tr>
          <td>Avukatlık</td>
          <td>İsteyip istememek meslek kurallarına bağlı, önce aşağıdaki mevzuat notunu okuyun</td>
        </tr>
        <tr>
          <td>Kuaför, servis, perakende</td>
          <td>İşlem ya da teslimat bittikten sonraki birkaç saat içinde</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p>
    Günler sonra gönderilen hatırlatmalara dönen müşteri az olur. Deneyimini hatırlıyor, ama o an geçtiği için
    harekete geçmiyor.
  </p>

  <h2 id="nasil">Yorum nasıl istenir?</h2>

  <p>Müşterinin yorum yazmasını olabildiğince kolaylaştırın. Biz şu sırayı kuruyoruz:</p>

  <ol>
    <li>
      <strong>Kısa yorum linkini alın.</strong> İşletme profilinizin yönetim ekranında bir yorum linki var. Müşteriyi
      doğrudan yorum yazma ekranına götürür, sizi haritada araması gerekmez.
    </li>
    <li>
      <strong>Yüz yüze isteyin, linki hemen gönderin.</strong> İşi teslim ederken tek cümleyle söyleyin, linki o anda
      WhatsApp’tan atın. Yalnız mesaj atmak daha az dönüş getirir.
    </li>
    <li>
      <strong>Tesiste QR kod bulundurun.</strong> Kasada, bekleme salonunda ya da teslim masasında linkin QR kodu dursun.
    </li>
    <li>
      <strong>Bir kez isteyin.</strong> Israrlı hatırlatma müşterinin keyfini kaçırır.
    </li>
  </ol>

  <p>
    Yön vermekle metin vermek arasında net bir çizgi var. “Aldığınız hizmeti ve hangi semtten geldiğinizi
    yazarsanız çok seviniriz” demek sorun olmaz, cümleleri müşteri kuruyor. Hazır metin verdiğiniz an yorumlar
    birbirine benzer ve filtreye takılır.
  </p>

  <h2 id="kurallar">Google hangi yorum taktiklerini yasaklıyor?</h2>

  <p>
    Bu konuda net konuşalım: aşağıdakilerin hiçbirini yapmayın, rakibiniz yapıyor olsa bile. Kısa vadede sayı
    artırır, sonra profilinizi riske atar.
  </p>

  <ul>
    <li>
      <strong>Yorum satın almak.</strong> Para karşılığı yazılan yorum sahte yorumdur ve Google’ın kurallarına aykırı.
      Filtre yakalarsa yorumlar silinir, profil askıya alınma riskine girer.
    </li>
    <li>
      <strong>Teşvikle yorum toplamak.</strong> İndirim, hediye, çekiliş ya da “yorum yazana kahve bizden” hepsi aynı
      kapıya çıkar. Yakalanan yorumlar silinir, tekrarında profil askıya alınabilir.
    </li>
    <li>
      <strong>Yalnız memnun müşteriye link göndermek.</strong> Önce “memnun musunuz” diye sorup sadece evet diyenleri
      Google’a yönlendirmek açıkça yasak. İngilizcesi review gating.
    </li>
  </ul>

  <p>
    Rakibiniz satın aldığı yorumlarla öndeyse kural ihlalini Google’a bildirin ve kendi gerçek akışınızı kurun. Onun
    yorumları her an silinebilir, sizin gerçek yorumlarınız birikmeye devam eder.
  </p>

  <div class="callout">
    <p>
      <strong>Avukatlar ve sağlık işletmeleri için not:</strong> Avukatlıkta TBB Reklam Yasağı Yönetmeliği, yorum
      isteğinin teşvike dönüşmesini riskli kılar; sağlıkta da hasta deneyimini tanıtım aracına çevirmek mevzuata aykırı.
    </p>
    <p>
      Avukatlıkta yorum isteyip istemeyeceğinize meslek kurallarınıza bakarak karar verin. İstenirse kural her alanda
      aynı: düzenli, tek tek, teşviksiz ve seçmeden. Ayrıntısı <a href={p('industries/law')}>avukatlar</a> ve
      <a href={p('industries/dental')}>diş hekimleri</a> sayfalarımızda.
    </p>
  </div>

  <h2 id="filtre">Yorumlarınız neden kayboluyor?</h2>

  <p>
    Google’ın filtresi şüpheli gördüğü yorumu sessizce kaldırır. Bildirim gelmez, yalnız sayı düşer. Filtreye takılan
    tipik desenler:
  </p>

  <ul>
    <li><strong>Ani yığın.</strong> Yeni bir profilde birkaç gün içinde gelen çok sayıda yorum.</li>
    <li><strong>Aynı ağdan gelen yorumlar.</strong> Müşterilere işletmenin internetine bağlıyken toplu yorum yazdırmak.</li>
    <li><strong>Geçmişi olmayan hesaplar.</strong> Daha önce hiç yorum yazmamış, tek yorumluk hesaplar.</li>
    <li><strong>Birbirine benzeyen metinler.</strong> Aynı kalıbın küçük değişikliklerle tekrarı.</li>
  </ul>

  <p>
    En bilinen tuzak toplu istek. Eski müşteri listesine aynı gün mesaj atmak teknik olarak serbest, ama birkaç gün içinde
    gelen yorum yığını filtrenin aradığı desenin ta kendisi.
  </p>

  <p>
    Listeyi haftalara yayın. Haftada iki üç gerçek yorum, bir haftada toplanan yirmi yorumdan daha güvenli bir akış.
  </p>

  <h2 id="yanit">Yorumlara nasıl yanıt vermelisiniz?</h2>

  <p>
    Kısa ve insan ağzından, iyisine de kötüsüne de. Google’ın yerel sıralama önerilerinde de yorumlara yanıt vermek var.
    Yanıt, sizi araştıran bir sonraki müşteriye işletmenin canlı olduğunu gösterir.
  </p>

  <p>
    “Bu güzel yorumunuz günümüzü aydınlattı, markamızın dijital sahnede parlamasını görmek tarifsiz bir mutluluk” gibi
    şablon yanıtlar ilk cümlede belli olur. Okuyan kişi, yorumlara gerçekten bakmadığınızı anlar.
  </p>

  <p>
    Aldığı hizmeti sade biçimde anın, teşekkür edin, bitirin. “Teşekkürler Ayşe Hanım, raporun içinize sinmesine sevindik,
    yeni arabanız hayırlı olsun” gibi iki satır yeter.
  </p>

  <p>
    Sağlıkta ve hukukta bir istisna var: yanıtta hizmetin adını anmayın. “İmplant tedavinizden memnun kalmanıza sevindik”
    cevabı, o kişinin aldığı tedaviyi herkese açıklar.
  </p>

  <h2 id="olumsuz">Olumsuz yorum gelirse ne yapmalısınız?</h2>

  <p>Sırayla ilerleyin:</p>

  <ol>
    <li>
      <strong>Önce özelden ulaşın.</strong> Sorunu konuşarak çözün. Çözülürse müşteri yorumunu kendisi güncelleyebilir.
    </li>
    <li>
      <strong>Sonra kısa, savunmaya geçmeyen bir yanıt yazın.</strong> Bu yanıtı asıl okuyacak olan, sizi araştıran bir
      sonraki müşteri. Müşteriyi yalanlamayın, detaya girmeyin.
    </li>
    <li>
      <strong>Kural ihlali varsa bildirin.</strong> Hakaret, alakasız içerik ya da rakipten geldiği belli olan yorumlar
      kaldırılabilir. Süreç garantili değil ve haftalar sürebilir.
    </li>
  </ol>

  <p>
    Tek bir olumsuz yoruma karşı en sağlam savunma, gerçek yorum hacminiz. 120 yorumlu bir profilde bir kötü yorum
    kaybolur, 8 yorumlu profilde ise ilk göze çarpan o olur.
  </p>

  <Fragment slot="cta">
    <h2>Yorumlarınız rakiplerinizin <span class="highlight">gerisinde</span> mi?</h2>
    <p>
      Ücretsiz denetim aracımız 10 soruda profilinizi puanlar, yorum hacminizi ilk üçteki rakiplerinizle kıyaslatır. Zayıf
      çıkan her madde için ne yapacağınızı hemen görürsünüz, kayıt ya da <span style="white-space: nowrap;">e-posta</span>
      istemez.
    </p>
  </Fragment>
</ContentLayout>
