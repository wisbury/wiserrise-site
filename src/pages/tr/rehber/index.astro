---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import HubCards from '../../../components/v2/HubCards.astro';
import { routePath } from '../../../i18n/routes';
import { guides } from '../../../data/guides';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const faq = [
  {
    q: 'Bu rehberlerle işi kendim yapabilir miyim?',
    a: 'Evet, öyle olsun diye yazdık. Zorlaşan kısım süreklilik: yorum akışını canlı tutmak ve bölgenizde neyin değiştiğini düzenli görmek. Takıldığınız yerde ücretsiz analiz isteyebilirsiniz.',
  },
  {
    q: 'Rehberler ne sıklıkla güncelleniyor?',
    a: 'Google’ın ekranı ya da kuralları değiştikçe. Son güncelleme tarihi her rehberin başında yazıyor. Eskimiş bir adım görürseniz yazın, düzeltelim.',
  },
  {
    q: 'Neden hepsi Türkçe?',
    a: 'Bu rehberleri Türkiye’deki işletmelerin karşılaştığı durumlara göre yazdık. Doğrulama adımları, kategori adları ve destek akışı ülkeye göre değişiyor; birebir çeviri yanlış bilgi verirdi.',
  },
];
---

<ContentLayout
  locale={locale}
  route="guides"
  title="Yerel SEO Rehberleri | Wiserrise"
  description="Google İşletme Profili açma, doğrulama sorunları, yorum artırma ve haritada üst sıraya çıkma üzerine kendiniz uygulayabileceğiniz rehberler."
  eyebrow="REHBERLER"
  h1="Yerel SEO rehberleri, adım adım."
  crumb="Rehberler"
  lede="Google İşletme Profilinizi açmaktan haritada üst sıraya çıkmaya kadar, kendiniz uygulayabileceğiniz rehberler. Adımları saklamıyoruz. Yerel SEO’da asıl zor olan, bu adımları aylarca aksatmadan sürdürmek."
  schemaType="article"
  datePublished="2026-08-01"
  dateModified="2026-11-06"
  breadcrumb={[{ label: 'Ana Sayfa', href: '/tr' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Tüm hizmetler', href: p('services'), text: 'Hangi hizmetin neyi çözdüğünü tek sayfada gördüğünüz liste.' },
    { label: 'Local SEO', href: p('services/local-seo'), text: 'Profilinizi ve sitenizi birlikte düzelttiğimiz ana hizmet.' },
    { label: 'Sektörlere göre yerel SEO', href: p('industries'), text: 'Avukat, diş hekimi, klinik ve oto ekspertizde işin nasıl değiştiği.' },
  ]}
  relatedHeading="İlgili sayfalar"
  ctaLabel="Ücretsiz analiz al"
  ctaHref="/tr#contact"
>
  <h2 id="neden">Neden adımları saklamıyoruz?</h2>

  <p>
    Çünkü bilgi zaten herkese açık. Google kendi kurallarını da haritada neye baktığını da yazıyor.
  </p>

  <p>
    İşletmelerin takıldığı yer ritim. Yorum akışını haftalarca canlı tutmak ve bölgenizin hangi köşesinde geride kaldığınızı
    görmek, bir kez okuyup bitirilecek işler değil. Vaktiniz varsa rehberlerle kendiniz yapın, yoksa bu işi biz yürütüyoruz.
  </p>

  <div class="callout">
    <p>
      <strong>Profilinizin durumunu hemen görmek isterseniz</strong> önce <a href={p('tools/gbp-audit')}>ücretsiz denetim
      aracını</a> doldurun. 10 soruda hangi başlıkta zayıf olduğunuzu söyler, sonra ilgili rehbere geçersiniz.
    </p>
  </div>

  <h2 id="baslangic">Hangi rehberden başlamalısınız?</h2>

  <p>
    Adınızı aratınca profiliniz hiç çıkmıyorsa <a href={p('guides/not-showing')}>görünmeme rehberiyle</a> başlayın. Henüz
    profiliniz yoksa <a href={p('guides/create-profile')}>profil açma rehberine</a>, doğrulamada takıldıysanız
    <a href={p('guides/verification')}>doğrulama rehberine</a> geçin.
  </p>

  <p>
    Profiliniz çıkıyor ama haritada geride kalıyorsanız <a href={p('guides/rank-higher')}>üst sıra rehberi</a> sizin için.
    Yorum sayınız rakiplerinizin gerisindeyse işe <a href={p('guides/more-reviews')}>yorum rehberinden</a> başlayın, çünkü
    baktığımız profillerde fark en sık orada çıkıyor.
  </p>

  <Fragment slot="wide">
    <HubCards
      id="rehber-listesi"
      eyebrow="REHBERLER"
      heading="En sık takılınan yerlerden başlayarak."
      items={guides.map((g) => ({ ...g, cta: 'Rehberi oku' }))}
      son={{
        href: p('tools/gbp-audit'),
        label: 'ÜCRETSİZ ARAÇ',
        title: 'Google profiliniz kaç puan alıyor?',
        text: '10 soruda profilinizi puanlayın. Kayıt ve e-posta yok, sonuç hemen ekranda.',
        cta: 'Aracı aç',
        alt: 'Profilinizi denetleyin →',
      }}
    />
  </Fragment>

  <Fragment slot="cta">
    <h2>Kendiniz uğraşmak <span class="highlight">istemiyor musunuz</span>?</h2>
    <p>
      Ücretsiz analizde profilinize, sitenize ve bölgenizden ölçüme bakar, nereden başlanacağını söyleriz. Sonuç 24 saat
      içinde <span style="white-space: nowrap;">e-postanızda</span>.
    </p>
  </Fragment>
</ContentLayout>
