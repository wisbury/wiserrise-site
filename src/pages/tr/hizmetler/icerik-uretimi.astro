---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'HİZMET', title: 'Hizmet sayfaları', text: 'Verdiğiniz her hizmete ayrı bir sayfa. Arayanın sorularını cevaplar, onu telefona ve randevuya götürür.' },
  { label: 'SEMT', title: 'Semt ve şehir', text: 'Yalnız o bölge için söyleyecek gerçek bir şey varsa açılır. Şehir adı değişmiş kopya sayfa yazmayız.' },
  { label: 'REHBER', title: 'Rehber yazılar', text: 'Bilgi arayan kişiyi erken yakalar ve hizmet sayfasına yollar. Hizmet sayfaları bitmeden rehbere geçmeyiz.' },
  { label: 'ONAY', title: 'Uzman onayı', text: 'Taslak bizden, doğruluk onayı sizden. Avukat ve sağlık sitelerinde metni o mesleğin reklam kurallarına göre yazarız.' },
];

const toc = [
  { id: 'nedir', label: 'İçerik üretimi neyi kapsıyor?' },
  { id: 'sira', label: 'Neden önce hizmet sayfaları?' },
  { id: 'sehir', label: 'Semt ve şehir sayfaları' },
  { id: 'kurallar', label: 'Avukat ve sağlık siteleri' },
  { id: 'surec', label: 'Bir sayfa nasıl yazılıyor?' },
  { id: 'yapay-zeka', label: 'Yapay zeka kullanımı' },
];

const faq = [
  {
    q: 'İçerikleri kim yazıyor?',
    a: 'Araştırmayı ve taslağı biz yapıyoruz, meslek bilgisinin doğruluğunu siz onaylıyorsunuz. Hukuk ve sağlık sitelerinde uzman onayı olmadan hiçbir sayfa yayına çıkmıyor.',
  },
  {
    q: 'Ayda kaç içerik gerekiyor?',
    a: 'Sabit bir sayı vermiyoruz. Önce eksik hizmet sayfaları tamamlanır, sayıyı o eksik listesi belirler. Sonrasında yazılacak her sayfayı aramalardaki gerçek talebe göre seçeriz.',
  },
  {
    q: 'Blog yazmak haritadaki sıramı etkiler mi?',
    a: 'Doğrudan etkisi sınırlı. Blog, bilgi arayan kişiyi siteye getirir ve linkle hizmet sayfanıza taşır. Haritadaki sıra için Google İşletme Profiliniz ve hizmet sayfalarınız daha belirleyici.',
  },
  {
    q: 'Mevcut yazılarım ne olacak?',
    a: 'Önce onlara bakıyoruz. Gösterim alıp tıklanmayan ya da başka bir sayfanızla aynı aramada yarışan yazıları yeniden yazar ya da birleştiririz. Hiç gösterim almayan ve işinizle ilgisi zayıf yazıları kaldırmayı öneririz.',
  },
];
---

<ContentLayout
  locale={locale}
  route="services/content"
  title="SEO İçerik Üretimi | Wiserrise"
  description="Yerel işletme siteleri için SEO içerik üretimi: önce hizmet sayfaları, sonra gerçek bilgiye dayanan semt sayfaları ve rehberler. Uzman onayıyla yayın."
  eyebrow="HİZMET · İÇERİK ÜRETİMİ"
  h1="SEO içerik üretimi ile eksik sayfalarınızı tamamlayın."
  crumb="İçerik üretimi"
  lede="İçerik üretimi, sitenizde eksik kalan sayfaları yazdığımız iş. Önce müşteriyi telefona getiren hizmet sayfalarını tamamlarız, blog en sona kalır. Hangi sayfanın eksik olduğunu arama verisinden ve Google profilinizdeki hizmetlerden çıkarırız."
  serviceName="SEO İçerik Üretimi"
  breadcrumb={[
    { label: 'Ana Sayfa', href: '/tr' },
    { label: 'Hizmetler', href: p('services') },
    { label: 'SEO', href: p('services/seo') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'SEO', href: p('services/seo'), text: 'Altyapı, sayfa düzeni, içerik ve backlink: bu hizmetin bağlı olduğu ana iş.' },
    { label: 'Local SEO', href: p('services/local-seo'), text: 'Profilinizi ve sitenizi birlikte düzeltip haritada öne çıkmanız için çalışırız.' },
    { label: 'On-Page SEO', href: p('services/on-page-seo'), text: 'Her sayfayı tek bir aramaya oturtur, title ve iç linkleri düzeltiriz.' },
    { label: 'Teknik SEO', href: p('services/technical-seo'), text: 'Yazdığımız sayfaların Google’a ulaşması için tarama ve indeksleme hatalarını kapatırız.' },
  ]}
  ctaLabel="Ücretsiz analiz al"
  ctaHref="/tr#contact"
>
  <h2 id="nedir">İçerik üretimi neyi kapsıyor?</h2>

  <p>
    Sitenizde olması gerekip olmayan her sayfayı. Yerel işletmede listenin başında hizmet sayfaları var, blog yazısı en sona
    kalıyor.
  </p>

  <p>
    Biri İzmir’de “Bornova oto ekspertiz” aradığında Google o hizmeti o bölgede anlatan bir sayfa arar. Sitenizde yalnız ana
    sayfa ve bir iletişim sayfası varsa Google’ın gösterecek bir şeyi yoktur.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Sayfa</th>
          <th>Örnek arama</th>
          <th>Ne işe yarar</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Hizmet sayfası</strong></td>
          <td>“kanal tedavisi”, “boşanma avukatı”</td>
          <td>Hizmet almaya hazır kişiyi karşılar. Telefona en yakın sayfa.</td>
        </tr>
        <tr>
          <td><strong>Semt ya da şehir sayfası</strong></td>
          <td>“Bornova oto ekspertiz”</td>
          <td>Hizmet verdiğiniz bölgede görünmenizi sağlar. Gerçek yerel bilgi şart.</td>
        </tr>
        <tr>
          <td><strong>Rehber yazı</strong></td>
          <td>“kanal tedavisi kaç seans sürer”</td>
          <td>Bilgi arayanı erken yakalar, linkle hizmet sayfasına taşır.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="sira">Neden önce hizmet sayfaları?</h2>

  <p>
    Çünkü müşteriyi onlar getiriyor. Hizmet sayfası olmayan bir siteye rehber yazısıyla ziyaretçi çekerseniz, ziyaretçi
    gidecek yer bulamaz ve çıkar.
  </p>

  <p>
    Bu yüzden hizmet sayfaları bitmeden blog yazmıyoruz. Blog isteyen işletmeye de önce eksik hizmet listesini gösteriyoruz.
  </p>

  <p>
    Listeyi Search Console’da gösterim alıp karşılığı olmayan aramalardan ve rakiplerde olup sizde olmayan sayfalardan
    çıkarıyoruz. En hızlı kaynak ise <a href={p('services/gbp')}>Google İşletme Profiliniz</a>: profilde yazan ama sitede
    sayfası olmayan her hizmet listeye girer.
  </p>

  <h2 id="sehir">Semt ve şehir sayfası ne zaman açılır?</h2>

  <p>
    O bölge için söyleyecek gerçek bir şeyiniz olduğunda. Şehir adı değiştirilmiş kopya sayfaları Google “doorway” sayar ve
    bütün siteye zarar verir. Şubeler ve hizmet verilen şehirler için kuralları
    <a href={`${p('services/local-seo')}#coklu`}>local SEO sayfasında</a> anlattık.
  </p>

  <p>
    Gerçek bir şey ne demek? Diyelim ki Kadıköy’de bir fizyoterapi merkeziniz var ve Ataşehir’e ev ziyaretine de
    gidiyorsunuz. Ataşehir sayfası şunları anlatabilir:
  </p>

  <ul class="checklist">
    <li>Ataşehir’de hangi mahallelere gittiğiniz</li>
    <li>Ev ziyaretinde hangi tedavilerin yapılabildiği</li>
    <li>Ev ziyaretinin nasıl planlandığı, merkeze gelmek isteyen için ulaşım</li>
    <li>O bölgeden gelen hastaların telefonda en çok sorduğu sorular</li>
  </ul>

  <p>
    Bu bilgiler yoksa sayfayı açmıyoruz. Şablona semt adı yazıp çoğaltmak hızlı görünür, ama siteyi Google’ın gözünde
    zayıflatır.
  </p>

  <p>
    Hangi semte önce sayfa açacağımıza bölgenizden aldığımız <a href={p('services/rank-tracking')}>ölçüm</a> karar verir.
    Gerçekten iş aldığınız ama aramada geride kaldığınız semtler sıranın başına geçer.
  </p>

  <h2 id="kurallar">Avukat ve sağlık sitelerinde neye dikkat ediyoruz?</h2>

  <p>
    Meslek kurallarına. Avukat sitelerinde Türkiye Barolar Birliği’nin reklam yasağı geçerli. Kazanma vaadi, başarı oranı,
    “en iyi” gibi üstünlük iddiası ve müvekkil yorumu yazılmaz.
  </p>

  <p>
    Sağlıkta da benzer sınırlar var. Tedavi garantisi ya da önce/sonra vaadi yazmıyoruz. Her metin yayından
    önce bu süzgeçten geçer ve avukatın ya da hekimin onayını alır.
  </p>

  <p>
    Bilgilendirici, iddiasız yazılmış metin bu sektörlerde okura da daha güvenilir gelir. Sektöre özel ayrıntılar
    <a href={p('industries/law')}>avukatlar için SEO</a> ve <a href={p('industries/dental')}>diş hekimleri için SEO</a>
    sayfalarında.
  </p>

  <h2 id="surec">Bir sayfa nasıl yazılıyor?</h2>

  <p>Her sayfa aynı adımlardan geçer:</p>

  <ol>
    <li>
      <strong>Eksik listesi.</strong> Yukarıdaki kaynaklardan sitenizde olmayan sayfaları çıkarırız.
    </li>
    <li>
      <strong>Sıra.</strong> Telefona en yakın sayfa öne geçer, rehber yazıları en sona kalır.
    </li>
    <li>
      <strong>Plan.</strong> Her sayfa için hedef arama, cevaplanacak sorular, verilecek iç linkler ve şema tipi belirlenir.
      Bu kısım <a href={p('services/on-page-seo')} style="white-space: nowrap;">on-page SEO</a> işinin parçası.
    </li>
    <li>
      <strong>Yazım ve onay.</strong> Taslağı biz yazarız, işinize dair bilgilerin doğruluğunu siz onaylarsınız.
    </li>
    <li>
      <strong>Yayın.</strong> Sayfayı siteye biz koyarız, iç linklere bağlar ve sitemap’e ekleriz. Siteyi komple
      yönetemeyeceksek işe başlamıyoruz, yayın da bu yüzden bizde.
    </li>
    <li>
      <strong>Takip.</strong> Sayfanın hangi aramalarda göründüğünü Search Console’dan izler, eksik kalan soruları ekleriz.
    </li>
  </ol>

  <p>
    Yaptığımız işleri her hafta raporda görürsünüz. Aramada ilk hareketi çoğu işletmede 3 ile 6 ay arasında
    görüyoruz; sayfanın Google’a ulaşabilmesi için önce <a href={p('services/technical-seo')}>teknik SEO</a>
    tarafının temiz olması gerekiyor.
  </p>

  <h2 id="yapay-zeka">Yapay zeka kullanıyor musunuz?</h2>

  <p>
    Kullanıyoruz, araştırmada ve ilk taslakta. Ham çıktıyı olduğu gibi yayına almıyoruz.
  </p>

  <p>
    Yapay zeka sizin işinizi bilmiyor. Hangi semtlere gittiğinizi ve müşterinin telefonda ne sorduğunu bilmeden yazılan metin,
    aynı aramayı hedefleyen benzer sayfalardan ayrışmaz. Ayrışmayan sayfa da sıralanmaz.
  </p>

  <p>
    Yapay zeka yanıtlarında anılmak da aynı şeye bağlı. ChatGPT ve Gemini soruyu net cevaplayan, işletmeyi her yerde tutarlı
    anlatan kaynaklara yaslanıyor; bu tarafı <a href={p('services/geo')}>GEO</a> hizmetinde ölçüyoruz.
  </p>

  <Fragment slot="cta">
    <h2>Sitenizde hangi sayfalar <span class="highlight">eksik</span>?</h2>
    <p>
      Ücretsiz analizde sitenize ve profilinize bakar, ilk yazılması gereken sayfaları sırayla çıkarırız. Sonuç 24 saat
      içinde <span style="white-space: nowrap;">e-postanızda</span>.
    </p>
  </Fragment>
</ContentLayout>
