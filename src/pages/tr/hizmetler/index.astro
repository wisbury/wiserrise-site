---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import HubCards from '../../../components/v2/HubCards.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

// Ana hizmetler. Alt hizmetler (profil yönetimi, harita takibi, teknik SEO, on-page SEO, içerik) burada değil,
// bağlı oldukları ana hizmetin sayfasından linklenir. Sayfası henüz olmayanlar analiz penceresini açar.
const services = [
  {
    href: p('services/seo'),
    label: 'ARAMA',
    title: 'SEO',
    text: 'Haritanın altındaki arama sonuçları. Teknik altyapı, sayfa düzeni ve içerikle sitenizi müşterinin aradığı sorulara oturturuz.',
    cta: 'Hizmeti incele',
    iz: 'sag' as const,
  },
  {
    href: p('services/local-seo'),
    label: 'HARİTALAR',
    title: 'Local SEO',
    text: 'Profiliniz ve siteniz birlikte. Çevrenizdeki müşterinin ilk gördüğü üç işletmenin arasına girmek için yürüttüğümüz iş.',
    cta: 'Hizmeti incele',
    iz: 'sag' as const,
  },
  {
    href: p('services/google-ads'),
    label: 'REKLAM',
    title: 'Google Ads',
    text: 'Bütçenizi arayan, soran ve satın almaya hazır kişilere harcayan arama reklamları.',
    cta: 'Hizmeti incele',
    iz: 'alt' as const,
  },
  {
    href: p('services/geo'),
    label: 'YAPAY ZEKA',
    title: 'GEO',
    text: 'ChatGPT, Gemini ve Google’ın yapay zeka yanıtlarında hangi soruda anıldığınızı ölçer, anılmadığınız sorular için çalışırız.',
    cta: 'Hizmeti incele',
    iz: 'kose' as const,
  },
];

const faq = [
  {
    q: 'Hizmetleri tek tek alabilir miyim?',
    a: 'Alabilirsiniz, ama çoğu işletmede tek hizmet yetmiyor. Sorun tek bir yerdeyse, mesela siteniz Google’da hiç görünmüyorsa, yalnız SEO ile başlarız. Hangisinin gerektiğini ücretsiz analizde söyleriz.',
  },
  {
    q: 'Türkiye’nin her yerindeki işletmelerle çalışıyor musunuz?',
    a: 'Evet. İşin tamamı uzaktan yürüyor, şehrinize gelmemiz gerekmiyor. Türkçe, İngilizce ve Almanca hizmet veriyoruz.',
  },
  {
    q: 'Aynı şehirde rakibimle de çalışır mısınız?',
    a: 'Hayır. Bir şehirde, bir sektörde tek işletmeyle çalışıyoruz. İki rakibi aynı haritada aynı anda yukarı taşımaya çalışmak ikisine de haksızlık olur.',
  },
  {
    q: 'SEO sonuçlarını nasıl ölçüyorsunuz?',
    a: 'Bölgenizden ölçümü, profil etkileşimlerini ve Search Console verisini birlikte okuyoruz. Tek bir sıralama ekran görüntüsü göndermiyoruz, çünkü haritadaki sıra arayanın nerede durduğuna göre değişir. Yaptığımız işleri her hafta raporda görürsünüz.',
  },
];
---

<ContentLayout
  locale={locale}
  route="services"
  title="Dijital Pazarlama Hizmetleri | Wiserrise"
  description="SEO, Local SEO, Google Ads ve GEO. Hangisinin size lazım olduğunu ücretsiz analizde söyleriz."
  eyebrow="HİZMETLER"
  h1="Dijital pazarlama hizmetleri: hangisi size lazım?"
  crumb="Hizmetler"
  lede="Müşteriniz sizi Google’da, haritada ya da ChatGPT’de bulabilir. Her kanal ayrı bir iş, ama hepsine aynı anda ihtiyacınız yok. Aşağıda hangi hizmetin hangi kanala çalıştığını anlattık."
  serviceName="Dijital Pazarlama Hizmetleri"
  breadcrumb={[{ label: 'Ana Sayfa', href: '/tr' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Sektörlere göre yerel SEO', href: p('industries'), text: 'Avukat, diş hekimi, klinik ve oto ekspertizde işin nasıl değiştiğini anlattık.' },
    { label: 'Rehberler', href: p('guides'), text: 'Profil açmaktan yorum artırmaya, kendiniz uygulayabileceğiniz adımlar.' },
    { label: 'Ücretsiz profil denetimi', href: p('tools/gbp-audit'), text: '10 soruda Google profilinizin nerede zayıf olduğunu hemen görün.' },
    { label: 'SEO fiyatları', href: p('pricing/seo'), text: 'Ücreti neyin belirlediğini ve paketlerin nasıl kurulduğunu anlattık.' },
  ]}
  relatedHeading="İlgili sayfalar"
  ctaLabel="Ücretsiz analiz al"
  ctaHref="/tr#contact"
>
  <h2 id="kanallar">Müşteriniz sizi nerede buluyor?</h2>

  <p>
    Dört ana hizmetin her biri bir kanala çalışıyor.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Nerede?</th>
          <th>Ne görüyor?</th>
          <th>Hangi hizmet</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Google arama</strong></td>
          <td>Haritanın altındaki sonuçlar</td>
          <td><a href={p('services/seo')}>SEO</a></td>
        </tr>
        <tr>
          <td><strong>Google Haritalar</strong></td>
          <td>Haritada ilk üç işletme</td>
          <td><a href={p('services/local-seo')}>Local SEO</a></td>
        </tr>
        <tr>
          <td><strong>Google’ın reklam alanı</strong></td>
          <td>Sonuçların üstündeki “Sponsorlu” satırlar</td>
          <td><a href={p('services/google-ads')}>Google Ads</a></td>
        </tr>
        <tr>
          <td><strong>ChatGPT, Gemini</strong></td>
          <td>Asistanın önerdiği işletmeler</td>
          <td><a href={p('services/geo')}>GEO</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="reklam-seo">Reklam mı, SEO mu?</h2>

  <p>
    Reklam hemen başlar ve bütçe bittiği gün durur. SEO ile Local SEO geç başlar, ama çalışmayı bıraktığınız gün
    sönmez.
  </p>

  <h2 id="baslangic">Nereden başlamalısınız?</h2>

  <p>
    Müşteriniz çevreden geliyorsa haritadan, yani Local SEO’dan. Bütün şehre ya da Türkiye’ye satıyorsanız SEO’dan.
    Beklemeye vaktiniz yoksa reklamla başlarsınız, kalıcı tarafı arkasından kurarız.
  </p>

  <p>
    Tahminle başlamayın. Ücretsiz analiz, işletmenize özel kaydettiğimiz bir video analizdir: bugün nerede durduğunuzu ve önce neyle başlamanız gerektiğini anlatırız. Siteyi komple yönetemeyeceğimiz bir işe de başlamıyoruz, çünkü yarım yönetilen sitede SEO tutmaz,
    reklamdan gelen ziyaretçi de boşa gider.
  </p>

  <div class="callout">
    <p>
      <strong>Analizden sonra bizimle çalışmak zorunda değilsiniz.</strong>
    </p>
  </div>

  <Fragment slot="wide">
    <HubCards
      id="hizmet-listesi"
      eyebrow="HİZMETLER"
      heading="Müşteriniz nerede arıyorsa orada çalışıyoruz."
      sub="SEO ve Local SEO aramada ve haritada yer edinmeniz için çalışır. Google Ads reklam yayındayken görünür kılar. GEO aynı temeli yapay zeka yanıtlarına taşır."
      items={services}
      son={{
        label: 'KARARSIZ MISINIZ?',
        title: 'Hangisi size uygun, birlikte bakalım.',
        text: 'Ücretsiz analiz, işletmenize özel kaydettiğimiz bir video analizdir: nereden başlamanız gerektiğini anlatırız.',
        cta: 'Ücretsiz analiz',
        alt: 'Ücretsiz analiz al →',
      }}
    />
  </Fragment>

  <Fragment slot="cta">
    <h2>Önce hangisi <span class="highlight">lazım</span>?</h2>
    <p>
      Ücretsiz analiz, işletmenize özel kaydettiğimiz bir video analizdir: bugün nerede durduğunuzu ve önce neyle başlamanız gerektiğini anlatırız. Sonuç 24 saat içinde
      <span style="white-space: nowrap;">e-postanızda</span>.
    </p>
  </Fragment>
</ContentLayout>
