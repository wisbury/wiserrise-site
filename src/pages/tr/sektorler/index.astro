---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import HubCards from '../../../components/v2/HubCards.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const verticals = [
  {
    href: p('industries/law'),
    label: 'HUKUK',
    title: 'Avukatlar',
    text: 'Reklam yasağı varken görünmek. Kurallara uygun bir profil ve bilgilendirici içerik üzerine kurulu iş.',
    cta: 'Sektörü incele',
  },
  {
    href: p('industries/dental'),
    label: 'SAĞLIK',
    title: 'Diş hekimleri',
    text: 'Gece ağrıyla arayan hasta ile haftalardır implant araştıran hasta aynı haritada. İkisine ayrı ayrı görünmek gerekir.',
    cta: 'Sektörü incele',
  },
  {
    href: p('industries/aesthetics'),
    label: 'SAĞLIK',
    title: 'Estetik klinikleri',
    text: 'Tanıtım kurallarının en sıkı olduğu alan. Doğru kategori ve sonuç vaadi içermeyen içerik belirleyici.',
    cta: 'Sektörü incele',
  },
  {
    href: p('industries/physio'),
    label: 'SAĞLIK',
    title: 'Fizyoterapistler',
    text: 'Hasta teşhisini bilmez, şikâyetini yazar. Klinikte ve evde hizmet ayrımını profilde doğru kurmak da sırayı etkiler.',
    cta: 'Sektörü incele',
  },
  {
    href: p('industries/vehicle-inspection'),
    label: 'OTOMOTİV',
    title: 'Oto ekspertiz',
    text: 'Yarış birkaç kilometrede geçer, müşteri dakikalar içinde karar verir. Profil, yorumlar ve gerçek fotoğraflar öne çıkar.',
    cta: 'Sektörü incele',
  },
];

const toc = [
  { id: 'ne-degisir', label: 'Sektörden sektöre ne değişir?' },
  { id: 'icerik', label: 'Sektör içeriği neden ayrı çalışır?' },
  { id: 'diger', label: 'Sektörünüz listede yoksa' },
];

const faq = [
  {
    q: 'Sektörüm listede yok, birlikte çalışabilir miyiz?',
    a: 'Evet. Yöntem sektörden bağımsız; değişen rekabetin yapısı ve müşterinin nasıl aradığı. Ücretsiz analizde sizin sektörünüze de aynı gözle bakarız.',
  },
  {
    q: 'Sektörümü bilmiyorsanız metinler yanlış olmaz mı?',
    a: 'Haritadaki sıranın mantığı sektöre göre değişmiyor, metnin doğruluğu değişiyor. Bilmediğimiz bir alanda metnin doğruluğunu yayından önce size onaylatırız. Hukukta ve sağlıkta da böyle çalışıyoruz.',
  },
  {
    q: 'Aynı şehirde rakibimle de çalışır mısınız?',
    a: 'Hayır. Bir şehirde, bir sektörde tek işletmeyle çalışıyoruz. İki rakibi aynı haritada aynı anda yukarı taşımaya çalışmak ikisine de haksızlık olur.',
  },
  {
    q: 'Avukatlık ve sağlık gibi kurallı sektörlerde risk alıyor muyuz?',
    a: 'Almıyoruz. Avukatlıkta reklam yasağı, sağlıkta tanıtım kuralları metnin sınırını çiziyor ve biz o sınırın içinde kalıyoruz. Yaptırım riski taşıyan bir ifadeyi sıralama için kullanmayız.',
  },
];
---

<ContentLayout
  locale={locale}
  route="industries"
  title="Sektörlere Göre Yerel SEO | Wiserrise"
  description="Avukat, diş hekimi, estetik kliniği, fizyoterapist ve oto ekspertiz için yerel SEO. Sektörün kurallarına ve müşterinin arama biçimine göre kurulan çalışma."
  eyebrow="SEKTÖRLER"
  h1="Yerel SEO sektörden sektöre nasıl değişir?"
  crumb="Sektörler"
  lede="Yöntem aynı kalır, dört şey değişir: müşterinin ne kadar uzağa gittiği, ne kadar sürede karar verdiği, sektörün kurallarının neye izin verdiği ve yorum yazmaya ne kadar istekli olduğu. Bunları bilmeden yapılan çalışma boşa gider. Aşağıda en çok çalıştığımız beş sektörü ayrı ayrı anlattık."
  serviceName="Sektöre Özel Yerel SEO"
  breadcrumb={[{ label: 'Ana Sayfa', href: '/tr' }]}
  toc={toc}
  faq={faq}
  wideFirst
  related={[
    { label: 'Local SEO', href: p('services/local-seo'), text: 'Profilinizi ve sitenizi birlikte düzelttiğimiz ana hizmet.' },
    { label: 'İçerik üretimi', href: p('services/content'), text: 'Sektörünüzün sorularına cevap veren hizmet ve semt sayfaları.' },
    { label: 'Tüm hizmetler', href: p('services'), text: 'Hangi hizmetin neyi çözdüğünü tek sayfada gördüğünüz liste.' },
  ]}
  ctaLabel="Ücretsiz analiz al"
  ctaHref="/tr#contact"
>
  <h2 id="ne-degisir">Sektörden sektöre ne değişir?</h2>

  <p>
    Google haritayı her sektörde aynı mantıkla sıralıyor. Değişen, müşterinin nasıl aradığı ve sizin neyi söylemeye izniniz
    olduğu.
  </p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th></th>
          <th>Neden önemli</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Mesafe</strong></td>
          <td>
            Oto ekspertizi arayan en yakındakine gider. İyi bir boşanma avukatı için şehrin öbür ucuna geçer. Ölçümü bu mesafeye
            göre kurarız.
          </td>
        </tr>
        <tr>
          <td><strong>Kurallar</strong></td>
          <td>
            Avukatlıkta reklam yasağı, sağlıkta tanıtım kuralları var. Başka sektörde işe yarayan birçok yöntem burada
            kullanılamaz.
          </td>
        </tr>
        <tr>
          <td><strong>Kategori</strong></td>
          <td>
            “Medikal estetik” ile “güzellik salonu” Google için iki ayrı işletme türü. Yanlış kategori seçen klinik doğru aramada
            geride kalır.
          </td>
        </tr>
        <tr>
          <td><strong>Karar süresi</strong></td>
          <td>
            Oto ekspertizde karar dakikalar sürer, implant tedavisinde haftalar. Uzun kararda bilgilendirici sayfalar, kısa
            kararda profil ve yorumlar öne çıkar.
          </td>
        </tr>
        <tr>
          <td><strong>Yorum</strong></td>
          <td>
            Bazı sektörlerde müşteri seve seve yorum yazar, bazılarında mahremiyet yüzünden yazmaz. Yorum hedefini buna göre
            koyarız.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="callout">
    <p>
      <strong>Sektörü bilmeden yazılmış metin öne çıkmaz.</strong> Aynı aramayı hedefleyen yüzlerce genel yazı var, fark o
      sektörde çalışmış birinin bildiği ayrıntıda. Bilmediğimiz bir alanda metnin doğruluğunu bu yüzden size onaylatırız.
    </p>
  </div>

  <h2 id="icerik">Sektör içeriği neden haritadan ayrı çalışır?</h2>

  <p>
    “Antalya avukat” aramasında Google arayanın nerede olduğuna bakar. “Boşanma davası ne kadar sürer” aramasında böyle bir
    şey yok; bu soru Türkiye’nin her yerinden sorulur ve cevabı veren sayfa her yerde çıkabilir.
  </p>

  <p>
    Bir hukuk bürosunun bu soruda görünmesi, kendi şehrinde haritaya girmesinden ayrı bir iş. İkisini birlikte yürütüyoruz.
    Harita yakındaki müşteriyi getirir, <a href={p('services/content')}>bilgilendirici sayfalar</a> henüz araştıran
    müşteriye sizi tanıtır.
  </p>

  <h2 id="diger">Sektörünüz listede yoksa?</h2>

  <p>
    Yine çalışırız. Yöntem aynı: önce <a href={p('services/rank-tracking')}>bölgenizden ölçüm</a>, sonra profil ve site.
  </p>

  <p>
    Emlak ofisi, veteriner, kuaför, mali müşavir, nakliyat, tesisat ya da spor salonu fark etmez. Müşterisi çevreden gelen
    her işletmede aynı sırayla ilerliyoruz, sektöre özel kısmı ücretsiz analizde birlikte çıkarıyoruz.
  </p>

  <Fragment slot="wide">
    <HubCards
      id="sektor-listesi"
      eyebrow="SEKTÖRLER"
      heading="Ayrı sayfası olan sektörler."
      sub="Her sektörle çalışıyoruz. Bunlar, sektöre özel anlatacak somut bir şeyimiz olanlar."
      items={verticals}
      son={{
        label: 'SEKTÖRÜNÜZ YOK MU?',
        title: 'Yöntem aynı, birlikte bakalım.',
        text: 'Ücretsiz analizde sektörünüzdeki rakipleri ve müşterinin nasıl aradığını çıkarır, nereden başlamanız gerektiğini söyleriz.',
        cta: 'Ücretsiz analiz',
        alt: 'Ücretsiz analiz al →',
      }}
    />
  </Fragment>

  <Fragment slot="cta">
    <h2>Sektörünüzde rekabet <span class="highlight">nerede</span>?</h2>
    <p>
      Ücretsiz analiz, işletmenize özel kaydettiğimiz bir video analizdir: bugün nerede durduğunuzu ve önce neyle başlamanız gerektiğini anlatırız. Sonuç 24 saat içinde
      <span style="white-space: nowrap;">e-postanızda</span>.
    </p>
  </Fragment>
</ContentLayout>
