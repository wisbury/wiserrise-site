---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const features = [
  { label: 'ACİL', title: 'Ağrıyla arayan hasta', text: 'Gece dişi zonklayan hasta haritaya bakar ve doğrudan arar. Saatleriniz ve telefonunuz o anda doğru olmalı.' },
  { label: 'TEDAVİ', title: 'Tedavi sayfaları', text: 'İmplant ya da şeffaf plak düşünen hasta haftalarca okur. Her ağırlıklı tedaviye onun sorularını cevaplayan sayfa yazarız.' },
  { label: 'YORUM', title: 'Mahremiyete uygun yorum', text: 'Yorum isteriz ama karşılığında hiçbir şey vermeyiz. Yanıtlarda hastanın hangi tedaviyi aldığını hiç anmayız.' },
  { label: 'KURAL', title: 'Tanıtım sınırları', text: 'Önce/sonra görseli, kampanya ve “en iyi” iddiası yazmayız. Her ifadeyi yayından önce resmî kaynaklarla kontrol ederiz.' },
];

const toc = [
  { id: 'acil', label: 'Acil diş ağrısı aramaları' },
  { id: 'tedavi', label: 'Tedavi araştıran hasta' },
  { id: 'kurallar', label: 'Sağlık tanıtım kuralları' },
  { id: 'kategori', label: 'Kategori ve profil adı' },
  { id: 'yorum', label: 'Yorumlar ve mahremiyet' },
  { id: 'sube', label: 'Şubeler ve sağlık turizmi' },
  { id: 'olcum', label: 'Neyi ölçüyoruz' },
];

const faq = [
  {
    q: 'Önce/sonra fotoğrafı paylaşamıyorsak hastayı nasıl ikna edeceğiz?',
    a: 'Tedaviyi dürüstçe anlatan sayfalarla. Hasta karar vermeden önce “kaç seans sürer” ya da “ne zaman işe dönerim” gibi soruların cevabını arar. Bu soruları açık açık cevaplayan sayfa kurallara da uyar.',
  },
  {
    q: 'Sitede fiyat yazabilir miyiz?',
    a: 'Fiyat listesi yayınlamıyoruz, çünkü sağlıkta fiyat ve indirim üzerinden tanıtım kısıtlı. Onun yerine fiyatı neyin belirlediğini anlatıyoruz, örneğin implant sayısı ya da kemik durumu. Kesin rakamı hasta muayeneden sonra kliniğinizden öğrenir.',
  },
  {
    q: 'Gece hasta kabul etmiyoruz, acil aramalarda görünmemiz gerekir mi?',
    a: 'Gerekmez, saatlerinizin doğru olması yeter. Kapalı olduğunuz saatleri profil açıkça göstermeli, ertesi sabah arayacak hasta da buna bakar. “Acil” kelimesini yalnız gerçekten acil hasta kabul ediyorsanız kullanın.',
  },
  {
    q: 'Ne zaman sonuç görürüz?',
    a: 'Kesin bir süre veremeyiz; süre işletmenin başlangıç durumuna, rekabete ve kanala göre değişir. Söyleyebileceğimiz şey işin sırası: önce ölçeriz, sonra kök sorunları düzeltir, sonra üretime geçeriz. Ne yaptığımızı ve ölçümün nasıl değiştiğini her hafta raporda görürsünüz.',
  },
];
---

<ContentLayout
  locale={locale}
  route="industries/dental"
  title="Diş Hekimleri ve Diş Klinikleri İçin SEO | Wiserrise"
  description="Diş klinikleri için sağlık tanıtım kurallarına uygun local SEO: acil aramalar, tedavi sayfaları, yorumlar ve şubeler. Bölgenizden ölçüm, haftalık rapor."
  eyebrow="SEKTÖR · DİŞ HEKİMLERİ"
  h1="Diş hekimleri için SEO: hasta aradığı an orada olun."
  crumb="Diş Hekimleri"
  lede="Diş hekimleri için SEO, iki farklı hastaya aynı anda görünmek demek: gece ağrıyla “açık diş hekimi” yazan ve haftalardır implant araştıran. Birincisi haritaya ve telefona bakar, ikincisi tedavi sayfalarınızı okur. Biz ikisini sağlık tanıtım kurallarının içinde kalarak kuruyoruz."
  serviceName="Diş Klinikleri İçin Yerel SEO"
  breadcrumb={[
    { label: 'Ana Sayfa', href: '/tr' },
    { label: 'Sektörler', href: p('industries') },
  ]}
  features={features}
  toc={toc}
  faq={faq}
  related={[
    { label: 'Google İşletme Profili Yönetimi', href: p('services/gbp'), text: 'Saatleri, kategoriyi, hizmet listesini ve yorum yanıtlarını birlikte yönetiriz.' },
    { label: 'İçerik Üretimi', href: p('services/content'), text: 'Tedavi sayfalarını hastanın gerçekten sorduğu sorulara göre yazarız.' },
    { label: 'Estetik Klinikleri İçin SEO', href: p('industries/aesthetics'), text: 'Kararın uzun sürdüğü ve fiyatın sık sorulduğu bir alanda nasıl çalıştığımız.' },
    { label: 'Fizyoterapistler İçin SEO', href: p('industries/physio'), text: 'Semt yakınlığının ve tekrar eden seansların belirlediği aramalar.' },
  ]}
  relatedHeading="İlgili sayfalar"
  ctaLabel="Ücretsiz analiz al"
  ctaHref="/tr#contact"
>
  <h2 id="acil">Ağrıyla arayan hasta sizi nasıl bulur?</h2>

  <p>
    Haritadan bulur ve siteyi açmadan arar. Gece 23’te dişi zonklayan biri “açık diş hekimi” ya da “nöbetçi dişçi”
    yazar, haritada çıkan ilk birkaç kliniğe bakar ve telefon tuşuna basar. Karar saniyeler içinde verilir.
  </p>

  <p>
    Bu aramada önce saatlerinize bakılır. Profilde saat eksikse ya da bayram için özel saat girilmemişse, haritada yalnız
    açık yerleri süzen kişi sizi listede görmez.
  </p>

  <p>
    Bir de profil adı tuzağı var. “Acil Diş Kliniği Kadıköy İmplant” gibi adlar kısa vadede işe yarıyor gibi görünür,
    ama Google’ın kurallarına aykırıdır ve profilin askıya alınmasına kadar gider. Profil adınız tabelanızdaki adla aynı
    olmalı.
  </p>

  <p>
    Gece gerçekten hasta kabul etmiyorsanız “acil” kelimesini hiçbir yerde kullanmayın. Gece arayıp size ulaşamayan
    hasta, “acil” yazan profilinize bir daha güvenmez.
  </p>

  <p>
    Kabul ediyorsanız asıl iş telefonu açmak. Geç dönmenin bedelini biz de ödedik: henüz yeniyken bir Meta reklamından
    gelen tek lead’i 5 gün sonra fark ettik, müşteriye iletmek için çok geçti ve binlerce lira boşa yandı. Ağrıyla yazan
    hasta 5 gün beklemez, 5 dakika bile beklemez.
  </p>

  <p>
    Saatleri, özel günleri, telefon ve mesaj ayarlarını <a href={p('services/gbp')}>Google İşletme Profili yönetimi</a>
    kapsamında takip ederiz.
  </p>

  <h2 id="tedavi">İmplant araştıran hasta neyi okur?</h2>

  <p>
    Sorularının cevabını okur. İmplant ya da ortodonti düşünen hasta karar vermeden önce haftalarca
    araştırır ve “kaç seans sürer”, “ağrı olur mu”, “ne kadar dayanır”, “fiyatı neye göre değişir” diye yazar.
  </p>

  <p>
    Diş kliniği sitelerinin çoğunda tedaviler tek bir “Hizmetlerimiz” sayfasında, ikişer paragrafla geçer. Bu sayfa hiçbir
    tedavi aramasında öne çıkmaz. Her ağırlıklı tedavi kendi sayfasını ister.
  </p>

  <p>Bir implant sayfasına şunları yazıyoruz:</p>

  <ul class="checklist">
    <li>İşlemin kaç aşamada yapıldığı, toplam süre ve iyileşme dönemi</li>
    <li>Ağrı ve uyuşturma konusunda gerçekçi bir anlatım</li>
    <li>Kimlere uygun olmadığı ve hangi ön koşulların arandığı</li>
    <li>Fiyatı belirleyen etkenler, örneğin implant sayısı ve kemik durumu</li>
    <li>Köprü gibi alternatiflerle karşılaştırma, üstünlük iddiası olmadan</li>
    <li>Hastaların gerçekten sorduğu sorular ve kısa cevapları</li>
  </ul>

  <p>
    Sayfadaki tedavi adlarını profildeki hizmet listesiyle birebir aynı tutuyoruz. Hasta “20 yaş dişi çekimi” yazıyorsa
    ikisinde de o yazar.
  </p>

  <p>
    Bu sayfaları <a href={p('services/content')}>içerik üretimi</a> işinde yazar, her birini
    <a href={p('services/on-page-seo')} style="white-space: nowrap;">on-page SEO</a> ile tek bir aramaya oturturuz.
    Sağlık sayfalarında Google metni kimin yazdığına daha sıkı bakar. Bu yüzden içeriği kontrol eden hekimin adını ve
    unvanını sayfaya yazmanızı öneririz.
  </p>

  <h2 id="kurallar">Sağlık tanıtım kuralları neyi yasaklıyor?</h2>

  <p>
    Sağlık hizmetlerinin tanıtımı Sağlık Bakanlığı düzenlemeleriyle sınırlı. Başka sektörde sıradan sayılan birçok hamle
    diş kliniğinde başınızı ağrıtır. Bizim yazdığımız hiçbir metinde şunlar yer almaz:
  </p>

  <ul>
    <li>Sonuç vaadi, “kesin sonuç” ya da tedavi garantisi</li>
    <li>Önce/sonra fotoğraflarıyla yapılan tanıtım</li>
    <li>İndirim, kampanya ve paket fiyat duyurusu</li>
    <li>Hasta yorumlarını övgü malzemesi olarak sitede ya da reklamda kullanmak</li>
    <li>“En iyi”, “en uygun” gibi karşılaştırmalı üstünlük iddiaları</li>
  </ul>

  <p>
    Serbest olan alan bilgilendirme: tedavinin ne olduğu, nasıl yapıldığı, ne kadar sürdüğü ve hastanın neyle
    karşılaşacağı. Hastanın aradığı da tam olarak bu. Kurallar sizi zaten hastanın okumak istediği içeriğe iter.
  </p>

  <div class="callout">
    <p>
      <strong>Bu sayfa hukuki görüş değildir.</strong> Kuralların güncel yorumu için bağlı olduğunuz il sağlık müdürlüğü
      ve meslek odanız esastır. Metni biz yazarız; kliniğinize dair bilgileri sizden alır, ifadeleri bu kaynaklarla ve
      Semrush’la kontrol edip yayına alırız, tereddüt ettiğimiz ifadeyi kullanmayız.
    </p>
  </div>

  <p>
    Aynı kurallar <a href={p('industries/aesthetics')}>estetik klinikleri</a> ve
    <a href={p('industries/physio')}>fizyoterapistler</a> için de geçerli. Onların arama davranışı farklı, bu yüzden
    ayrı sayfalarda anlattık.
  </p>

  <h2 id="kategori">Hangi kategoriyi seçmelisiniz?</h2>

  <p>
    Birincil kategoriyi ana aramaya verin: “Diş hekimi” ya da “Diş kliniği”. Gerçekten ağırlık verdiğiniz alanları ek
    kategori olarak ekleyin. Her kategori farklı bir arama kümesine karşılık gelir.
  </p>

  <p>
    Sık gördüğümüz hata, implant ya da ortodonti ağırlıklı çalışan kliniğin birincil kategoriyi bu dar alana vermesi. Dar
    alanda görünürlük kazanır, “diş hekimi” aramasının büyük hacmini kaybeder.
  </p>

  <p>
    Bir de unvan meselesi var. Kadronuzda ortodonti uzmanı yoksa “Ortodontist” kategorisini seçmeyin, hastaya uzmanlık
    izlenimi verir. Kategori seçimini bölgenizde öne çıkan kliniklerin kategorileriyle karşılaştırarak yaparız; yöntemi
    <a href={p('services/gbp')}>profil yönetimi sayfasında</a> anlattık.
  </p>

  <h2 id="yorum">Hastadan yorum istemek sorun olur mu?</h2>

  <p>
    Yorum isteyebilirsiniz. Karşılığında indirim ya da hediye teklif etmek ise Google’ın kurallarına aykırı, sağlıkta bir
    de tanıtım kuralları devreye girer. Hastaya ne yazacağını dikte etmek de aynı riski taşır.
  </p>

  <p>
    Asıl ince nokta yanıtlarda. Bir yoruma “implant tedavinizden memnun kalmanıza sevindik” diye cevap verdiğinizde, o
    kişinin hangi tedaviyi aldığını herkese duyurmuş olursunuz. Yanıtlarımızı bu yüzden tedavi adı geçmeden, kısa ve sakin
    yazıyoruz.
  </p>

  <p>
    Olumsuz yorumda önce hastaya telefonla ulaşılır, sonra savunmaya geçmeyen kısa bir yanıt yazılır; 1-2 yıldızlı
    yorumlara yazdığımız yanıtlar yayından önce onayınıza gelir. Gelen yorumları
    sitede “hastalarımız ne diyor” başlığıyla reklam gibi sergilemeyin. Yorum isteme akışını
    <a href={p('guides/more-reviews')}>Google yorumlarını artırma rehberinde</a> adım adım anlattık.
  </p>

  <h2 id="sube">Birden fazla şubeniz ya da yabancı hastanız varsa?</h2>

  <p>
    Her fiziksel şube ayrı bir profil ve sitede ayrı bir sayfa ister. Şube sayfalarının birbirinin kopyası olması en
    pahalıya patlayan hatalardan biri, şubeler aynı aramada birbirini yer. Her sayfaya o şubenin ekibini ve orada yapılan
    tedavileri yazarız.
  </p>

  <p>
    Yurt dışından hasta kabul ediyorsanız iş bambaşka bir yere gider. Bu alan Sağlık Bakanlığı’ndan alınan sağlık turizmi
    yetki belgesine tabi ve tanıtım kuralları da farklı işler. Arama başka dilde ve ülke çapında yapılır, yakınlığın etkisi
    kalmaz.
  </p>

  <p>
    Türkçe, İngilizce ve Almanca çalışıyoruz ama sağlık turizmini yerel programın içine sıkıştırmıyoruz. Birlikte
    planlıyorsak baştan ayrı kurarız.
  </p>

  <h2 id="olcum">Neyi ölçüyoruz?</h2>

  <p>
    Diş kliniğinde en yanıltıcı rakam site trafiği. Haritadan gelen hastanın bir kısmı siteye hiç uğramadan arar, sadece
    site istatistiğine bakan klinik bu hastaları görmez. Bu yüzden dört kaynağı birlikte okuyoruz:
  </p>

  <ul class="checklist">
    <li>
      <a href={p('services/rank-tracking')}>Bölgenizden ölçüm</a>: çevrenizin farklı noktalarında kaçıncı çıktığınız
    </li>
    <li>Profil etkileşimleri: kaç kişinin sizi aradığı, yol tarifi aldığı, mesaj attığı ya da sitenize geçtiği</li>
    <li>Tedavi sayfalarının Search Console verisi: hangi aramada göründüğü ve kaç tıklama aldığı</li>
    <li>Yaptığımız işler: profilde ve sitede neyi değiştirdiğimiz</li>
  </ul>

  <p>
    Yaptığımız işleri her hafta raporda ve müşteri portalında görürsünüz. Dördünü birlikte okumak “sıra yükseldi ama
    telefon çalmıyor” durumunu erken yakalar. Sebep bazen sıranın hacmi düşük bir tedavi aramasında yükselmiş olmasıdır.
  </p>

  <Fragment slot="cta">
    <h2>İlçenizde kaç klinik <span class="highlight">önünüzde</span>?</h2>
    <p>
      Ücretsiz analiz, işletmenize özel kaydettiğimiz bir video analizdir: bugün nerede durduğunuzu ve önce neyle başlamanız gerektiğini anlatırız. Sonuç 24 saat içinde
      <span style="white-space: nowrap;">e-postanızda</span>.
    </p>
  </Fragment>
</ContentLayout>
