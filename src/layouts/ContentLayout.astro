---
import ContentPage from '../components/v2/ContentPage.astro';
import type { Locale } from '../i18n/config';
import { routePath, type RouteKey } from '../i18n/routes';
import { servicePageSchema, articlePageSchema, type Crumb, type FaqEntry } from '../lib/schema';
import { v2ui, formatDate } from '../i18n/v2';

interface Props {
  locale: Locale;
  route: RouteKey;
  /** Appended to the route path for dynamic children. */
  slug?: string;
  /** <title> and meta description — written per page, not derived from the H1. */
  title: string;
  description: string;
  eyebrow?: string;
  h1: string;
  /** Last breadcrumb label; defaults to the H1, which is too long on pages with a sentence headline. */
  crumb?: string;
  lede: string;
  /** Short cards under the hero. */
  features?: { label: string; title: string; text: string }[];
  /** Ancestors only; the current page is appended automatically. */
  breadcrumb?: Crumb[];
  /** Name used in the Service schema. Omit on pages that aren't a service. */
  serviceName?: string;
  /** Guides are Articles, not Services. */
  schemaType?: 'service' | 'article';
  /** Required for schemaType="article"; kept out of the build so it stays stable. */
  datePublished?: string;
  dateModified?: string;
  /** Article pages written by a named person; omitted, the organisation is the author. */
  author?: { name: string; jobTitle: string };
  toc?: { id: string; label: string }[];
  /**
   * Render the `wide` slot above the article instead of below it. Hub pages use
   * this so visitors see the actual offer before the explanatory copy.
   */
  wideFirst?: boolean;
  faq?: FaqEntry[];
  /** `text` is the one-line description on the card. */
  related?: { label: string; href: string; text?: string }[];
  /** Heading above the related cards; defaults to "related services". */
  relatedHeading?: string;
  ctaLabel: string;
  ctaHref: string;
}

const {
  locale,
  route,
  slug,
  title,
  description,
  eyebrow,
  h1,
  crumb,
  lede,
  features,
  breadcrumb = [],
  serviceName,
  schemaType = 'service',
  datePublished,
  dateModified,
  author,
  toc = [],
  wideFirst = false,
  faq = [],
  related = [],
  relatedHeading: relatedHeadingProp,
  ctaLabel,
  ctaHref,
} = Astro.props;

const url = routePath(locale, route) + (slug ? `/${slug}` : '');
const trail: Crumb[] = [...breadcrumb, { label: crumb ?? h1, href: url }];

const schema =
  schemaType === 'article'
    ? articlePageSchema({
        locale,
        url,
        headline: h1,
        description,
        datePublished: datePublished!,
        dateModified,
        faq,
        breadcrumb: trail,
        author,
      })
    : servicePageSchema({
        locale,
        url,
        name: serviceName ?? h1,
        description,
        faq,
        breadcrumb: trail,
      });

const relatedHeading = relatedHeadingProp ?? v2ui[locale].page.related;

/** Articles show their last update in the hero, matching dateModified in the schema. */
const iso = schemaType === 'article' ? dateModified ?? datePublished : undefined;
const updated = iso ? formatDate(locale, iso) : undefined;
---

<ContentPage
  locale={locale}
  route={route}
  slug={slug}
  title={title}
  description={description}
  eyebrow={eyebrow}
  updated={updated}
  h1={h1}
  lede={lede}
  schema={schema}
  features={features}
  toc={toc}
  wideFirst={wideFirst}
  hasWide={Astro.slots.has('wide')}
  faq={faq}
  related={related}
  relatedHeading={relatedHeading}
  ctaLabel={ctaLabel}
  ctaHref={ctaHref}
>
  <slot />
  <slot name="wide" slot="wide" />
  <slot name="cta" slot="cta" />
</ContentPage>
