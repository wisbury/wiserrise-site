---
import {
  LOCALES,
  DEFAULT_LOCALE,
  HREFLANG,
  OG_LOCALE,
  localeHome,
  type Locale,
} from '../i18n/config';
import { routePath, routeLocales, type RouteKey } from '../i18n/routes';
import { t, CONTACT_EMAIL, CONTACT_PHONE, COMPANY_LEGAL_NAME } from '../i18n/ui';
import Analytics from '../components/Analytics.astro';

interface Props {
  locale: Locale;
  /** Key into the central route map; drives canonical, hreflang and the language switcher. */
  route: RouteKey;
  /** Appended to the route path for dynamic children (e.g. a case study slug). */
  slug?: string;
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  locale,
  route,
  slug,
  title,
  description,
  ogImage = '/images/og-image.png',
  noindex = false,
} = Astro.props;

/** Only locales that actually have this page get an hreflang tag. */
const availableIn = routeLocales(route);

const site = Astro.site?.origin ?? 'https://wiserrise.com';
const abs = (p: string) => new URL(p, site).href;

const withSlug = (l: Locale) => routePath(l, route) + (slug ? `/${slug}` : '');

const canonical = abs(withSlug(locale));
const alternates = availableIn.map((l) => ({
  hreflang: HREFLANG[l],
  href: abs(withSlug(l)),
}));
const xDefault = abs(
  withSlug(availableIn.includes(DEFAULT_LOCALE) ? DEFAULT_LOCALE : availableIn[0]!),
);

const strings = t(locale);
const home = localeHome(locale);
const isHome = route === 'home';
/** On sub-pages the homepage anchors need an absolute target. */
const anchor = (hash: string) => (isHome ? hash : `${home}${hash}`);
const otherLocales = LOCALES.filter((l) => l !== locale);
/** Hubs only appear in nav for locales whose pages are actually written. */
const servicesHref = routeLocales('services').includes(locale) ? routePath(locale, 'services') : null;
const industriesHref = routeLocales('industries').includes(locale)
  ? routePath(locale, 'industries')
  : null;
const guidesHref = routeLocales('guides').includes(locale) ? routePath(locale, 'guides') : null;
const toolHref = routeLocales('tools/gbp-audit').includes(locale)
  ? routePath(locale, 'tools/gbp-audit')
  : null;
const year = new Date().getFullYear();
const phone = CONTACT_PHONE[locale];
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#F0EEE6" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- OPEN GRAPH / TWITTER -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={abs(ogImage)} />
  <meta property="og:locale" content={OG_LOCALE[locale]} />
  {availableIn.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
  ))}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={abs(ogImage)} />

  <!-- HREFLANG -->
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={xDefault} />

  <!-- STRUCTURED DATA (page-specific) -->
  <slot name="schema" />

  <!-- FAVICONS -->
  <link rel="icon" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon-180.png" />

  <!-- FONTS — kendi origin'imizden; Google Fonts CDN'ine istek gitmiyor -->
  <link
    rel="preload"
    href="/fonts/inter-400-800-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link rel="stylesheet" href="/fonts.css" />

  <link rel="stylesheet" href="/style.css" />

  <Analytics />
  <slot name="head" />
</head>

<body>
  <header class="nav">
    <div class="container nav-inner">
      <a href={home} class="brand">
        <img src="/images/logo.svg" alt="Wiserrise logo" class="brand-logo" />
        <span>WISERRISE<span class="dot">.</span></span>
      </a>

      <button class="menu-toggle" id="menuToggle" type="button" aria-label={strings.menuLabel}>
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="nav-links" id="navLinks">
        {servicesHref && <a href={servicesHref}>{strings.nav.services}</a>}
        {industriesHref && <a href={industriesHref}>{strings.nav.industries}</a>}
        {guidesHref && <a href={guidesHref}>{strings.nav.guides}</a>}
        <a href={anchor('#difference-section')}>{strings.nav.beforeAfter}</a>
        <a href={anchor('#process')}>{strings.nav.process}</a>
        <a href={anchor('#faq')}>{strings.nav.faq}</a>
        <a href={anchor('#contact')}>{strings.nav.audit}</a>
        {/* No translation for this page? Send the switcher to that locale's home. */}
        {otherLocales.map((l) => (
          <a href={availableIn.includes(l) ? routePath(l, route) : localeHome(l)} class="lang-switch">
            {l.toUpperCase()}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="container footer-inner">
      <div class="footer-left">
        <div class="footer-brand">
          <img src="/images/logo.svg" alt="Wiserrise" class="footer-logo" />
          <div class="footer-title">WISERRISE<span class="dot">.</span></div>
        </div>

        <div>{strings.footer.tagline}</div>

        <div style="margin-top:10px; font-size:13px; color:#6F6C64;">
          {strings.footer.sub}
        </div>

        <div style="margin-top:10px; font-size:13px; color:#85827A;">
          © <span class="js-year">{year}</span> {COMPANY_LEGAL_NAME}. {strings.footer.rights}<br />
          {strings.footer.brandOf}
        </div>
      </div>

      <div class="footer-right" style="text-align:right;">
        <div><a href={`mailto:${CONTACT_EMAIL[locale]}`}>{CONTACT_EMAIL[locale]}</a></div>
        {phone && (
          <div style="margin-top:6px;">
            <a href={`tel:${phone.href}`} class="footer-phone">{phone.display}</a>
          </div>
        )}
        <div style="margin-top:6px; color:#6F6C64;">{strings.footer.claim}</div>

        <div style="margin-top:14px; display:flex; gap:14px; justify-content:flex-end; flex-wrap:wrap; font-size:13px; color:#6F6C64;">
          <a href={anchor('#difference-section')}>{strings.nav.beforeAfter}</a>
          <a href={anchor('#contact')}>{strings.nav.audit}</a>
          <a href={anchor('#faq')}>{strings.nav.faq}</a>
          {toolHref && <a href={toolHref}>{strings.nav.tool}</a>}
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/script.js" defer is:inline></script>
</body>
</html>
