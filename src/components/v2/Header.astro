---
/** v2 üst şerit + başlık. Ana sayfada bölüm linkleri sayfa içi (#), diğer sayfalarda /tr#… olur. */
interface Props {
  base?: string;
  alternates?: { en?: string; de?: string };
}
const { base = '', alternates = {} } = Astro.props;
---

<div style="background: #2bb3a6; color: #16244d; font-size: 13px; font-weight: 500; text-align: center; padding: 9px 24px; line-height: 1.4;">
  <a href="#analiz-formu" data-analiz style="color: #16244d; text-decoration: none;"><span style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; margin-right: 10px;">ÜCRETSİZ ANALİZ</span>İşletmenizi tüm kanallarda inceleyelim, yol haritanız 24 saat içinde gelsin →</a>
</div>

<header class="v2-header" style="max-width: 1312px; margin: 0 auto; padding: 16px clamp(16px, 3vw, 32px); min-height: 72px; box-sizing: border-box; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
  <a href="/tr" aria-label="Wiserrise ana sayfa" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #1a1b19;">
    <svg aria-hidden="true" viewBox="0 0 110.25 80" width="44" height="32" style="display: block; flex: 0 0 auto;"><polygon points="0,80 49,0 67.5,30.2 37,80" fill="#16244d"></polygon><polygon points="57.25,60 83.75,16.7 110.25,60" fill="#2bb3a6"></polygon></svg>
    <span style="display: flex; flex-direction: column; line-height: 1;">
      <span style="font-family: 'Bricolage Grotesque', Geist, sans-serif; font-size: 26px; font-weight: 700; letter-spacing: -0.03em;">Wiserrise</span>
      <span style="font-size: 11px; color: #5c5e59; margin-top: 3px; letter-spacing: 0.01em;">Dijital pazarlama ajansı</span>
    </span>
  </a>
  <nav class="v2-nav" aria-label="Ana menü" style="display: flex; flex-wrap: wrap; align-items: center; gap: 32px; font-size: 15px; font-weight: 500;">
    <a class="navlink" href={`${base}#hizmetler`} style="color: #1a1b19; text-decoration: none;">Hizmetler</a>
    <a class="navlink" href="/tr/sektorler" style="color: #1a1b19; text-decoration: none;">Sektörler</a>
    <a class="navlink" href="/tr/rehber" style="color: #1a1b19; text-decoration: none;">Rehberler</a>
    <a class="navlink" href={`${base}#surec`} style="color: #1a1b19; text-decoration: none;">Nasıl çalışır</a>
    <a class="navlink" href={`${base}#sss`} style="color: #1a1b19; text-decoration: none;">SSS</a>
  </nav>
  <div style="display: flex; align-items: center; gap: 10px;">
    <div class="v2-lang" aria-label="Dil" style="display: inline-flex; align-items: center; height: 44px; padding: 0 6px; border-radius: 999px; border: 1px solid #868982; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; box-sizing: border-box;">
      <span aria-current="true" style="padding: 0 8px; color: #16244d; font-weight: 700;">TR</span>
      <a href={alternates.en ?? "/"} hreflang="en" lang="en" style="padding: 0 8px; color: #5c5e59; text-decoration: none;">EN</a>
      <a href={alternates.de ?? "/de"} hreflang="de" lang="de" style="padding: 0 8px; color: #5c5e59; text-decoration: none;">DE</a>
    </div>
    <a class="btn v2-header-cta" href="#analiz-formu" data-analiz style="display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 22px; border-radius: 999px; background: #16244d; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; box-sizing: border-box;">Ücretsiz analiz</a>
  </div>
</header>
