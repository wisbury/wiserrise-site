---
/**
 * Ücretsiz analiz formu (yeni tasarım).
 *
 * Sayfadaki bütün "Ücretsiz analiz" bağlantıları (`data-analiz`) ve hero'daki
 * site kutusu bu pencereyi açar. Form, eski ana sayfadaki formla aynı:
 * `id="applyForm"`, aynı Formspree adresi, aynı alan adları. Gönderim, dönüşüm
 * olayı (`audit_request`) ve dile göre /success yönlendirmesi /js/script.js'te kalıyor.
 *
 * JS yoksa: bağlantılar #analiz-formu'na gider, `:target` kuralı pencereyi
 * sayfa içinde normal blok olarak gösterir.
 *
 * Hizmet seçimi: kutuların adı yok, seçilenler virgülle birleşip tek `services`
 * alanıyla gider; gelen e-postada tek satır olarak okunur.
 * `data-hizmet="gads"` taşıyan bağlantı pencereyi o hizmet seçili açar.
 */
import { legalLinksFor } from '../data/legal';
import type { Locale } from '../i18n/config';
import { v2ui } from '../i18n/v2';

interface Props {
  locale: Locale;
  email: string;
}
const { locale, email } = Astro.props;
const d = v2ui[locale].dialog;
const legal = legalLinksFor(locale)[0];
---

<dialog id="analiz-formu" class="v2-dialog" aria-labelledby="analizTitle">
  <button type="button" class="v2-dialog-close" data-close aria-label={d.close}>×</button>
  <span class="v2-eyebrow">{d.eyebrow}</span>
  <h2 id="analizTitle" class="v2-dialog-title">{d.title}</h2>
  <p class="v2-dialog-lead">{d.lead}</p>

  <form id="applyForm" class="v2-form" action="https://formspree.io/f/mlgpzokq" method="POST">
    <fieldset class="v2-field v2-field--wide v2-urgency">
      <legend>{d.services} <span class="v2-field-hint">{d.servicesHint}</span></legend>
      <div class="v2-urgency-options">
        {d.serviceOptions.map((o) => (
          <>
            <input type="checkbox" id={`hz-${o.key}`} value={o.label} data-hizmet={o.key} />
            <label for={`hz-${o.key}`}>{o.label}</label>
          </>
        ))}
      </div>
      <input type="hidden" id="auditServices" name="services" />
    </fieldset>
    <div class="v2-field v2-field--wide">
      <label for="auditMaps">{d.site}</label>
      <input type="text" id="auditMaps" name="maps_url" autocomplete="url" placeholder={d.sitePh} />
    </div>
    <div class="v2-field">
      <label for="auditName">{d.name}</label>
      <input type="text" id="auditName" name="name" autocomplete="name" required />
    </div>
    <div class="v2-field">
      <label for="auditCompany">{d.company}</label>
      <input type="text" id="auditCompany" name="company" autocomplete="organization" required />
    </div>
    <div class="v2-field">
      <label for="auditEmail">{d.email}</label>
      <input type="email" id="auditEmail" name="email" autocomplete="email" required />
    </div>
    <div class="v2-field">
      <label for="auditPhone">{d.phone}</label>
      <input type="tel" id="auditPhone" name="phone" autocomplete="tel" required />
    </div>
    <fieldset class="v2-field v2-field--wide v2-urgency">
      <legend>{d.when}</legend>
      <div class="v2-urgency-options">
        {d.urgency.map((u, i) => (
          <>
            <input type="radio" id={`urg${i}`} name="urgency" value={u.value} required={i === 0} />
            <label for={`urg${i}`}>{u.label}</label>
          </>
        ))}
      </div>
    </fieldset>
    <button type="submit" class="btn v2-submit">{d.submit}</button>
  </form>

  <p class="v2-dialog-note">
    {d.one} <a href={`mailto:${email}`}>{email}</a>
  </p>
  <p class="v2-dialog-note">
    {d.data} <a href={legal.href}>{legal.label}</a>.
  </p>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('analiz-formu');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    var site = document.getElementById('auditMaps');
    var kutular = Array.prototype.slice.call(dlg.querySelectorAll('input[data-hizmet]'));
    var secilen = document.getElementById('auditServices');

    function birlestir() {
      secilen.value = kutular.filter(function (k) { return k.checked; }).map(function (k) { return k.value; }).join(', ');
    }
    // "Emin değilim" ile diğer hizmetler birlikte seçilmez
    kutular.forEach(function (k) {
      k.addEventListener('change', function () {
        if (k.checked) kutular.forEach(function (o) {
          if (o !== k && (k.dataset.hizmet === 'unsure' || o.dataset.hizmet === 'unsure')) o.checked = false;
        });
        birlestir();
      });
    });

    function open(prefill, hizmet) {
      if (prefill && site) site.value = prefill;
      var kutu = hizmet && dlg.querySelector('input[data-hizmet="' + hizmet + '"]');
      if (kutu && !kutu.checked) {
        kutu.checked = true;
        kutu.dispatchEvent(new Event('change'));
      }
      if (!dlg.open) dlg.showModal();
      var first = dlg.querySelector(prefill ? '#auditName' : '#auditMaps');
      if (first) first.focus();
    }

    document.querySelectorAll('[data-analiz]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        open(null, a.getAttribute('data-hizmet'));
      });
    });

    var hero = document.getElementById('heroForm');
    if (hero) {
      hero.addEventListener('submit', function (e) {
        e.preventDefault();
        var v = (document.getElementById('heroSite') || {}).value || '';
        open(v.trim());
      });
    }

    dlg.querySelector('[data-close]').addEventListener('click', function () {
      dlg.close();
    });
    // Arka plana tıklayınca kapan
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });

    // Eski menülerdeki /tr#contact bağlantıları da formu açsın
    if (location.hash === '#analiz-formu' || location.hash === '#contact') open();
  })();
</script>
