---
/**
 * Analytics layer.
 *
 * Page views come from Cloudflare Web Analytics, which is switched on per
 * hostname in the Cloudflare dashboard: nothing to load here, no cookies, so no
 * consent banner is required under KVKK/GDPR.
 *
 * GA4 stays dormant unless PUBLIC_GA_ID is set at build time. Note that GA4
 * *does* set cookies; enabling it means a consent banner is required.
 *
 * Custom events go through one helper so the rest of the code never has to know
 * which provider is active. They only reach GA4:
 *
 *     window.akTrack('audit_request', { lang: 'tr' })
 */
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}

{/* One helper, whichever providers happen to be loaded. Never throws. */}
<script is:inline>
  window.akTrack = function (name, props) {
    try {
      var data = props || {};
      data.path = window.location.pathname;
      if (typeof window.gtag === 'function') window.gtag('event', name, data);
    } catch (e) {
      /* tracking must never break the page */
    }
  };
</script>
